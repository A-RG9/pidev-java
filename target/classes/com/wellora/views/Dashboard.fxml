<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.wellora.controllers.DashboardController" >

    <left>
        <VBox styleClass="sidebar" prefWidth="260" spacing="5">

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="logo-container">
                <Label text="♥" styleClass="logo-icon"/>
                <Label text="WellCare" styleClass="logo-text"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="user-card">
                <Label text="tt" styleClass="user-avatar"/>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label text="test test" styleClass="user-name"/>
                    <Label text="test@wellora.com" styleClass="user-email"/>
                </VBox>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="2">

                    <HBox alignment="CENTER_LEFT" styleClass="nav-category">
                        <Label text="♡" styleClass="nav-icon"/>
                        <Label text="Santé" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label text="⌄" styleClass="chevron-icon"/>
                    </HBox>
                    <VBox styleClass="sub-menu">
                        <Button text="🏠  Home" styleClass="sub-nav-button" onAction="#navToHome" maxWidth="Infinity"/>
                        <Button text="📊  Dashboard Santé" styleClass="sub-nav-button" onAction="#navToHealthDashboard" maxWidth="Infinity"/>
                        <Button text="📒  Journaux" styleClass="sub-nav-button" onAction="#navToHealthJournals" maxWidth="Infinity"/>
                        <Button text="📝  Entrées" styleClass="sub-nav-button" onAction="#navToHealthEntries" maxWidth="Infinity"/>
                        <Button text="📅  Calendrier" styleClass="sub-nav-button" onAction="#navToCalendar" maxWidth="Infinity"/>
                        <Button text="🤖  Prédiction IA" styleClass="sub-nav-button" onAction="#navToPrediction" maxWidth="Infinity"/>
                    </VBox>


                    <HBox alignment="CENTER_LEFT" styleClass="nav-category">
                        <Label text="📖" styleClass="nav-icon"/>
                        <Label text="Nutrition" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label text="⌃" styleClass="chevron-icon"/>
                    </HBox>

                    <VBox styleClass="sub-menu">
                        <Button text="Dashboard" styleClass="sub-nav-button, active-text" onAction="#navToDashboard" maxWidth="Infinity"/>
                        <Button text="Journal Alimentaire" styleClass="sub-nav-button" onAction="#navToJournal" maxWidth="Infinity"/>
                        <Button text="Planificateur" styleClass="sub-nav-button" onAction="#navToPlanificateur" maxWidth="Infinity"/>
                        <Button text="Recettes (IA)" styleClass="sub-nav-button" onAction="#navToRecettes" maxWidth="Infinity"/>
                        <Button text="Objectifs" styleClass="sub-nav-button" onAction="#navToObjectifs" maxWidth="Infinity"/>
                        <Button text="Analyse (Progrès)" styleClass="sub-nav-button" onAction="#navToAnalyse" maxWidth="Infinity"/>
                    </VBox>

                </VBox>
            </ScrollPane>

            <ToggleButton fx:id="btnThemeToggle" text="🌙 Mode Sombre" styleClass="theme-toggle" onAction="#toggleTheme" maxWidth="Infinity"/>

            <VBox spacing="2" styleClass="bottom-actions">
                <Button text="«     Réduire" styleClass="action-button" maxWidth="Infinity"/>
                <Button text="👤   Mon Profil" styleClass="action-button" maxWidth="Infinity"/>
                <Button text="🚪   Déconnexion" styleClass="action-button, logout-button" maxWidth="Infinity"/>
            </VBox>

        </VBox>
    </left>

    <center>
        <VBox spacing="25" style="-fx-padding: 40;">
            <HBox alignment="CENTER_LEFT">
                <VBox>
                    <Label text="Vue d'ensemble d'Aujourd'hui" styleClass="main-title"/>
                    <Label text="Aujourd'hui" style="-fx-text-fill: #9CA3AF; -fx-font-size: 14px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnAjoutRapide" text="+ Ajout Rapide" styleClass="primary-button"/>
            </HBox>

            <VBox spacing="10" styleClass="card" style="-fx-padding: 15;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="☀️" style="-fx-font-size: 20;"/>
                    <Label text="Objectif du Jour" styleClass="card-title" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                </HBox>

                <Separator />

                <HBox alignment="CENTER_LEFT" spacing="30">
                    <Label fx:id="lblDailyGoalName" text="Aucun objectif pour aujourd'hui" styleClass="card-value" style="-fx-font-size: 15px;"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblDailyGoalCalories" text="Calories : -" styleClass="card-value" style="-fx-font-size: 14px; -fx-text-fill: #FFB020;"/>
                    <Label fx:id="lblDailyGoalWeight" text="Poids cible : -" styleClass="card-value" style="-fx-font-size: 14px; -fx-text-fill: #00E6A4;"/>
                </HBox>
            </VBox>

            <HBox spacing="20">
                <VBox styleClass="card" prefWidth="220" HBox.hgrow="ALWAYS">
                    <Label text="Calories" styleClass="card-title"/>
                    <Label fx:id="lblCalories" text="0 / 2000" styleClass="card-value"/>
                </VBox>
                <VBox styleClass="card" prefWidth="220" HBox.hgrow="ALWAYS">
                    <Label text="Protéines" styleClass="card-title"/>
                    <Label fx:id="lblProteines" text="0g / 120g" styleClass="card-value"/>
                </VBox>
                <VBox styleClass="card" prefWidth="220" HBox.hgrow="ALWAYS">
                    <Label text="Glucides" styleClass="card-title"/>
                    <Label fx:id="lblGlucides" text="0g / 200g" styleClass="card-value"/>
                </VBox>
                <VBox styleClass="card" prefWidth="220" HBox.hgrow="ALWAYS">
                    <Label text="Lipides" styleClass="card-title"/>
                    <Label fx:id="lblLipides" text="0g / 65g" styleClass="card-value"/>
                </VBox>
            </HBox>

            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Label text="Journal des repas (Aujourd'hui)" styleClass="section-title"/>
                <TableView fx:id="tableRepas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colRepas" text="Type de Repas" prefWidth="200" />
                        <TableColumn fx:id="colCalories" text="Calories" prefWidth="150" />
                        <TableColumn fx:id="colProteines" text="Protéines (g)" prefWidth="150" />
                        <TableColumn fx:id="colGlucides" text="Glucides (g)" prefWidth="150" />
                        <TableColumn fx:id="colLipides" text="Lipides (g)" prefWidth="150" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="btnModifier" text="Modifier" styleClass="secondary-button" disable="true"/>
                    <Button fx:id="btnSupprimer" text="Supprimer" styleClass="danger-button" disable="true"/>
                </HBox>
            </VBox>

        </VBox>
    </center>
</BorderPane>