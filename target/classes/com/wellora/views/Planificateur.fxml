<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellora.controllers.PlanificateurController">

    <left>
        <VBox styleClass="sidebar" prefWidth="260" spacing="5">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="logo-container">
                <Label text="♥" styleClass="logo-icon"/>
                <Label text="WellCare" styleClass="logo-text"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="user-card">
                <Label text="tt" styleClass="user-avatar"/>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label text="test test" styleClass="user-name"/>
                    <Label text="test@wellora.com" styleClass="user-email"/>
                </VBox>
            </HBox>
            <ScrollPane fitToWidth="true" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="2">
                    <HBox alignment="CENTER_LEFT" styleClass="nav-category">
                        <Label text="♡" styleClass="nav-icon"/>
                        <Label text="Santé" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label text="⌄" styleClass="chevron-icon"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" styleClass="nav-category">
                        <Label text="📖" styleClass="nav-icon"/>
                        <Label text="Nutrition" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label text="⌃" styleClass="chevron-icon"/>
                    </HBox>
                    <VBox styleClass="sub-menu">
                        <Button text="Dashboard" styleClass="sub-nav-button" onAction="#navToDashboard" maxWidth="Infinity"/>
                        <Button text="Journal Alimentaire" styleClass="sub-nav-button" onAction="#navToJournal" maxWidth="Infinity"/>
                        <Button text="Planificateur" styleClass="sub-nav-button, active-text" onAction="#navToPlanificateur" maxWidth="Infinity"/>

                        <Button text="Recettes (IA)" styleClass="sub-nav-button" onAction="#navToRecettes" maxWidth="Infinity"/>

                        <Button text="Objectifs" styleClass="sub-nav-button" onAction="#navToObjectifs" maxWidth="Infinity"/>
                        <Button text="Analyse (Progrès)" styleClass="sub-nav-button" onAction="#navToAnalyse" maxWidth="Infinity"/>
                    </VBox>
                </VBox>
            </ScrollPane>
            <ToggleButton fx:id="btnThemeToggle" text="🌙 Mode Sombre" styleClass="theme-toggle" onAction="#toggleTheme" maxWidth="Infinity"/>
            <VBox spacing="2" styleClass="bottom-actions">
                <Button text="«     Réduire" styleClass="action-button" maxWidth="Infinity"/>
                <Button text="👤   Mon Profil" styleClass="action-button" maxWidth="Infinity"/>
                <Button text="🚪   Déconnexion" styleClass="action-button, logout-button" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-padding: 40;">

            <Label text="Planificateur de Repas" styleClass="main-title"/>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Date :" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                <DatePicker fx:id="datePickerPlan" prefWidth="150.0" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="btnAjouter" text="+ Ajouter un Repas" styleClass="primary-button" style="-fx-background-color: #00E6A4; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5;"/>
                <Button fx:id="btnTerminer" text="Marquer Terminé" disable="true" style="-fx-padding: 8 15;"/>
                <Button fx:id="btnSupprimer" text="Supprimer" disable="true" style="-fx-padding: 8 15; -fx-text-fill: red;"/>
            </HBox>

            <TableView fx:id="tablePlan" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colType" text="Type de Repas" prefWidth="150" />
                    <TableColumn fx:id="colNom" text="Nom du Plat" prefWidth="250" />
                    <TableColumn fx:id="colCalories" text="Calories (kcal)" prefWidth="120" />
                    <TableColumn fx:id="colStatut" text="Statut (Terminé)" prefWidth="120" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

        </VBox>
    </center>
</BorderPane>