<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.wellora.controllers.ObjectifController">

    <left>
        <VBox styleClass="sidebar" prefWidth="260" spacing="5">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="logo-container">
                <Label text="♥" styleClass="logo-icon"/>
                <Label text="WellCare" styleClass="logo-text"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="user-card">
                <Label text="tt" styleClass="user-avatar"/>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label text="test test" styleClass="user-name"/>
                    <Label text="test@wellora.com" styleClass="user-email"/>
                </VBox>
            </HBox>
            <ScrollPane fitToWidth="true" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="2">
                    <HBox alignment="CENTER_LEFT" styleClass="nav-category">
                        <Label text="♡" styleClass="nav-icon"/>
                        <Label text="Santé" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label text="⌄" styleClass="chevron-icon"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" styleClass="nav-category">
                        <Label text="📖" styleClass="nav-icon"/>
                        <Label text="Nutrition" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label text="⌃" styleClass="chevron-icon"/>
                    </HBox>
                    <VBox styleClass="sub-menu">
                        <Button text="Dashboard" styleClass="sub-nav-button" onAction="#navToDashboard" maxWidth="Infinity"/>
                        <Button text="Journal Alimentaire" styleClass="sub-nav-button" onAction="#navToJournal" maxWidth="Infinity"/>
                        <Button text="Planificateur" styleClass="sub-nav-button" onAction="#navToPlanificateur" maxWidth="Infinity"/>
                        <Button text="Recettes" styleClass="sub-nav-button" maxWidth="Infinity"/>
                        <Button text="Objectifs" styleClass="sub-nav-button, active-text" onAction="#navToObjectifs" maxWidth="Infinity"/>
                    </VBox>
                </VBox>
            </ScrollPane>
            <ToggleButton fx:id="btnThemeToggle" text="🌙 Mode Sombre" styleClass="theme-toggle" onAction="#toggleTheme" maxWidth="Infinity"/>
            <VBox spacing="2" styleClass="bottom-actions">
                <Button text="«     Réduire" styleClass="action-button" maxWidth="Infinity"/>
                <Button text="👤   Mon Profil" styleClass="action-button" maxWidth="Infinity"/>
                <Button text="🚪   Déconnexion" styleClass="action-button, logout-button" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-padding: 40;">
            <Label text="Mes Objectifs Nutritionnels" styleClass="main-title"/>

            <HBox spacing="10">
                <Button fx:id="btnAjoutJournalier" text="☀️ Objectif du Jour" styleClass="primary-button" style="-fx-background-color: #FFB020; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5;"/>
                <Button fx:id="btnAjouter" text="+ Nouvel Objectif" styleClass="primary-button" style="-fx-background-color: #00E6A4; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5;"/>
                <Button fx:id="btnModifier" text="Modifier" disable="true" style="-fx-padding: 8 15;"/>
                <Button fx:id="btnSupprimer" text="Supprimer" disable="true" style="-fx-padding: 8 15; -fx-text-fill: red;"/>
            </HBox>

            <TableView fx:id="tableObjectifs" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNom" text="Nom de l'objectif" prefWidth="200" />
                    <TableColumn fx:id="colType" text="Type" prefWidth="150" />
                    <TableColumn fx:id="colCalories" text="Cible Calories" prefWidth="120" />
                    <TableColumn fx:id="colPoids" text="Cible Poids (kg)" prefWidth="120" />
                    <TableColumn fx:id="colDate" text="Date Limite" prefWidth="120" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>