<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" styleClass="main-container" style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.FitnessDashboardController">

    <VBox spacing="25" styleClass="main-bg" style="-fx-padding: 30;">

        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="5">
                <Label text="Fitness Dashboard" styleClass="title-text" style="-fx-font-size: 28; -fx-font-weight: bold;"/>
                <Label fx:id="lblDateHeader" text="Mercredi, 15 Avril 2026" styleClass="text-secondary"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <TextField fx:id="searchDashboard" promptText="Rechercher un objectif..."
                       styleClass="text-field" style="-fx-pref-width: 250; -fx-padding: 8;"/>

            <Button text="+ New Goal" style="-fx-background-color: #14b8a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
        </HBox>

        <HBox spacing="20">
            <VBox fx:id="statProgress" HBox.hgrow="ALWAYS" />
            <VBox fx:id="statPlans" HBox.hgrow="ALWAYS" />
            <VBox fx:id="statMinutes" HBox.hgrow="ALWAYS" />
            <VBox fx:id="statTimeLeft" HBox.hgrow="ALWAYS" />
        </HBox>

        <VBox spacing="20" styleClass="card-bg">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label fx:id="lblGoalTitle" text="Chargement..." styleClass="text-primary" style="-fx-font-size: 22; -fx-font-weight: bold;"/>
                    <Label text="Atteignez vos objectifs de santé grâce à une nutrition équilibrée" styleClass="text-secondary" style="-fx-font-size: 13;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="View All Plans" style="-fx-background-color: rgba(20, 184, 166, 0.1); -fx-text-fill: #14b8a6; -fx-border-color: #14b8a6; -fx-border-radius: 5; -fx-cursor: hand;"/>
            </HBox>

            <ProgressBar fx:id="progressGoal" progress="0.45" maxWidth="Infinity" prefHeight="12" style="-fx-accent: #14b8a6;"/>

            <HBox spacing="60">
                <VBox spacing="5">
                    <Label text="START DATE" styleClass="text-secondary" style="-fx-font-size: 10; -fx-font-weight: bold;"/>
                    <Label fx:id="lblStartDate" text="--" styleClass="text-primary" style="-fx-font-size: 14;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="END DATE" styleClass="text-secondary" style="-fx-font-size: 10; -fx-font-weight: bold;"/>
                    <Label fx:id="lblEndDate" text="--" styleClass="text-primary" style="-fx-font-size: 14;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="PLANS" styleClass="text-secondary" style="-fx-font-size: 10; -fx-font-weight: bold;"/>
                    <Label fx:id="lblPlanCount" text="--" styleClass="text-primary" style="-fx-font-size: 14;"/>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>