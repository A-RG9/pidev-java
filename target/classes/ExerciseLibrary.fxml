<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:id="mainStackPane" fx:controller="org.example.controllers.ExerciseLibraryController"
           prefHeight="800.0" prefWidth="1100.0" styleClass="main-bg">

    <BorderPane>
        <top>
            <HBox spacing="20" style="-fx-padding: 20;" alignment="CENTER_LEFT">
                <VBox>
                    <Label text="Exercise Library" styleClass="text-header" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
                    <Label text="Browse exercises with video demonstrations" styleClass="text-secondary" style="-fx-font-size: 12;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" promptText="Search exercises..." styleClass="text-field" prefWidth="250"/>
                <ComboBox fx:id="sortComboBox" prefWidth="150" />
                <Button text="+ Nouvel Exercice" onAction="#openAddForm" style="-fx-background-color: #14b8a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>
        </top>

        <left>
            <VBox spacing="15" prefWidth="220" styleClass="sidebar" style="-fx-padding: 20;">
                <Label text="Categories" styleClass="text-section" style="-fx-font-weight: bold;"/>
                <Button text="All Categories" onAction="#filterAll" styleClass="menu-btn" maxWidth="Infinity"/>
                <Button text="Strength" onAction="#filterByStrength" styleClass="menu-btn" maxWidth="Infinity"/>
                <Button text="Cardio" onAction="#filterByCardio" styleClass="menu-btn" maxWidth="Infinity"/>

                <Separator opacity="0.1" />

                <Label text="Difficulty" styleClass="text-section" style="-fx-font-weight: bold;"/>
                <CheckBox fx:id="checkBeginner" text="Beginner" styleClass="text-secondary"/>
                <CheckBox fx:id="checkIntermediate" text="Intermediate" styleClass="text-secondary"/>
                <CheckBox fx:id="checkAdvanced" text="Advanced" styleClass="text-secondary"/>
            </VBox>
        </left>

        <center>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <FlowPane fx:id="cardsContainer" hgap="20" vgap="20" style="-fx-padding: 20;" />
            </ScrollPane>
        </center>
    </BorderPane>

    <VBox fx:id="formOverlay" visible="false" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.7);">
        <VBox spacing="15" maxWidth="450" styleClass="card-bg" style="-fx-padding: 30; -fx-background-color: #1e293b; -fx-background-radius: 15;">
            <Label text="Détails de l'exercice" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <TextField fx:id="txtTitle" promptText="Nom de l'exercice" />
            <TextArea fx:id="txtDescription" promptText="Description..." prefHeight="100" wrapText="true"/>
            <TextField fx:id="txtVideoUrl" promptText="Lien Vidéo (YouTube ou Local)" />

            <HBox spacing="10">
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Catégorie" style="-fx-text-fill: #94a3b8;"/>
                    <ComboBox fx:id="comboCategory" maxWidth="Infinity" />
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Difficulté" style="-fx-text-fill: #94a3b8;"/>
                    <ComboBox fx:id="comboDifficulty" maxWidth="Infinity" />
                </VBox>
            </HBox>

            <TextField fx:id="txtDuration" promptText="Durée (min)" />

            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button text="Annuler" onAction="#closeForm" style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-border-color: #ef4444; -fx-border-radius: 5;"/>
                <Button text="Enregistrer" onAction="#handleSave" style="-fx-background-color: #14b8a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>