<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" 
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.wellora.javafx.controller.MainController"
           prefWidth="1200" 
           prefHeight="800"
           styleClass="root">

    <!-- ========== TOP HEADER ========== -->
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" prefHeight="60">
            <padding>
                <Insets top="0" right="30" bottom="0" left="30"/>
            </padding>
            
            <!-- App Logo & Title -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="🌿" styleClass="app-logo"/>
                <Label text="Wellora Health" styleClass="app-title"/>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <!-- User Info -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label text="👤" styleClass="user-avatar"/>
                <Label text="User" styleClass="user-name"/>
            </HBox>
        </HBox>
    </top>

    <!-- ========== LEFT SIDEBAR ========== -->
    <left>
        <VBox styleClass="sidebar">
            
            <!-- Logo & User Section (Top) -->
            <VBox spacing="0">
                <!-- Logo -->
                <VBox styleClass="logo-container" spacing="5">
                    <padding>
                        <Insets top="15" right="10" bottom="15" left="15"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="W" styleClass="logo-icon"/>
                        <Label text="Wellora" styleClass="logo-text"/>
                    </HBox>
                </VBox>
                
                <!-- User Card -->
                <VBox styleClass="user-card" spacing="8">
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox styleClass="user-avatar" alignment="CENTER" prefWidth="38" prefHeight="38">
                            <Label text="KS" styleClass="avatar-text"/>
                        </VBox>
                        <VBox spacing="2">
                            <Label text="Khalil Sassi" styleClass="user-name"/>
                            <Label text="khalil@example.com" styleClass="user-email"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
            
            <!-- Separator -->
            <Separator styleClass="menu-separator"/>
            
            <!-- Navigation Menu -->
            <VBox spacing="8" styleClass="nav-menu">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
                
                <!-- MENU Section -->
                <VBox spacing="0">
                    <Label text="MENU" styleClass="nav-category"/>
                    
                    <!-- Home -->
                    <VBox styleClass="sub-menu">
                        <Button text="🏠  Home" 
                                styleClass="sub-nav-button" 
                                onAction="#showHomepage"
                                fx:id="btnHome"/>
                    </VBox>
                    
                    <!-- Dashboard -->
                    <VBox styleClass="sub-menu">
                        <Button text="📊  Dashboard" 
                                styleClass="sub-nav-button" 
                                onAction="#showDashboard"
                                fx:id="btnDashboard"/>
                    </VBox>
                </VBox>
                
                <Separator styleClass="menu-separator-thin"/>

                <!-- NUTRITION Section -->
                <VBox spacing="0">
                    <Label text="NUTRITION" styleClass="nav-category"/>

                    <VBox styleClass="sub-menu">
                        <Button text="🍽️  Dashboard Nutrition"
                                styleClass="sub-nav-button"
                                onAction="#showNutritionDashboard"
                                fx:id="btnNutritionDashboard"/>
                    </VBox>
                    <VBox styleClass="sub-menu">
                        <Button text="📖  Journal Alimentaire"
                                styleClass="sub-nav-button"
                                onAction="#showNutritionJournal"
                                fx:id="btnNutritionJournal"/>
                    </VBox>
                    <VBox styleClass="sub-menu">
                        <Button text="🎯  Objectifs"
                                styleClass="sub-nav-button"
                                onAction="#showNutritionObjectifs"
                                fx:id="btnNutritionObjectifs"/>
                    </VBox>
                    <VBox styleClass="sub-menu">
                        <Button text="📅  Planificateur"
                                styleClass="sub-nav-button"
                                onAction="#showNutritionPlanificateur"
                                fx:id="btnNutritionPlanificateur"/>
                    </VBox>
                    <VBox styleClass="sub-menu">
                        <Button text="🍴  Recettes"
                                styleClass="sub-nav-button"
                                onAction="#showNutritionRecettes"
                                fx:id="btnNutritionRecettes"/>
                    </VBox>
                    <VBox styleClass="sub-menu">
                        <Button text="📊  Analyse Nutritionnelle"
                                styleClass="sub-nav-button"
                                onAction="#showNutritionAnalyse"
                                fx:id="btnNutritionAnalyse"/>
                    </VBox>
                </VBox>

                <Separator styleClass="menu-separator-thin"/>
                
                <!-- MANAGE Section -->
                <VBox spacing="0">
                    <Label text="MANAGE" styleClass="nav-category"/>
                    
                    <!-- Health Journals -->
                    <VBox styleClass="sub-menu">
                        <Button text="📒  Health Journals" 
                                styleClass="sub-nav-button" 
                                onAction="#showHealthJournals"
                                fx:id="btnJournals"/>
                    </VBox>
                    
                    <!-- Health Entries -->
                    <VBox styleClass="sub-menu">
                        <Button text="📝  Health Entries" 
                                styleClass="sub-nav-button" 
                                onAction="#showHealthEntries"
                                fx:id="btnEntries"/>
                    </VBox>
                    
                    <!-- Symptoms (hidden) -->
                    <VBox styleClass="sub-menu">
                        <Button text="🤒  Symptoms" 
                                styleClass="sub-nav-button" 
                                onAction="#showSymptoms"
                                fx:id="btnSymptoms"
                                visible="false" managed="false"/>
                    </VBox>

                    <!-- Calendar -->
                       <VBox styleClass="sub-menu">
                           <Button text="📅  Calendar"
                                   styleClass="sub-nav-button"
                                   onAction="#showCalendar"
                                   fx:id="btnCalendar"/>
                       </VBox>
                       
                       <!-- AI Prediction -->
                       <VBox styleClass="sub-menu">
                           <Button text="🤖  Prediction"
                                   styleClass="sub-nav-button"
                                   onAction="#showPrediction"
                                   fx:id="btnPrediction"/>
                       </VBox>
                   </VBox>
            </VBox>
            
            <!-- Bottom Actions -->
            <Region VBox.vgrow="ALWAYS"/>
            
            <VBox styleClass="bottom-actions" spacing="5">
                <padding>
                    <Insets top="15" right="10" bottom="10" left="10"/>
                </padding>
                
                <Button text="🎨  Theme" 
                        styleClass="action-button" 
                        onAction="#toggleTheme"
                        fx:id="btnTheme"/>
                        
                <Button text="🚪  Logout" 
                        styleClass="action-button logout-button" 
                        onAction="#logout"
                        fx:id="btnLogout"/>
            </VBox>
            
            <!-- Version -->
            <Label text="v1.0" styleClass="version-label">
                <VBox.margin>
                    <Insets top="5" left="15" bottom="15" right="0"/>
                </VBox.margin>
            </Label>
        </VBox>
    </left>

    <!-- ========== CENTER CONTENT ========== -->
    <center>
        <VBox fx:id="contentArea" styleClass="content-area">
            <!-- Dynamic content loaded here -->
        </VBox>
    </center>

</BorderPane>
