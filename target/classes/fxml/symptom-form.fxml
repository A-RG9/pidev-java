<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wellora.javafx.controller.SymptomFormController"
      spacing="20" 
      styleClass="root"
      prefWidth="500" 
      prefHeight="450">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>
    
    <!-- Header -->
    <Label fx:id="headerLabel" text="Créer un Symptôme" styleClass="header-label"/>
    
    <!-- Form Card -->
    <VBox spacing="20" styleClass="card">
        
        <GridPane hgap="15" vgap="15">
            <!-- Hidden ID -->
            <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" 
                   visible="false" managed="false"/>
            <TextField fx:id="idField" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                      visible="false" managed="false" editable="false"/>
            
            <!-- Type -->
            <Label text="Type:*" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="typeCombo" GridPane.columnIndex="1" GridPane.rowIndex="1" 
                     promptText="Sélectionner le type"/>
            
            <!-- Intensity -->
            <Label text="Intensité (1-10):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Slider fx:id="intensiteSlider" min="1" max="10" showTickLabels="true" 
                       showTickMarks="true" blockIncrement="1"/>
                <Label fx:id="intensiteLabel" text="5"/>
            </HBox>
            
            <!-- Zone -->
            <Label text="Zone:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="zoneField" GridPane.columnIndex="1" GridPane.rowIndex="3" 
                      promptText="Ex: Tête, dos, abdomen" styleClass="text-field"/>
            
            <!-- Entry ID -->
            <Label text="Entrée ID:*" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="entryIdField" GridPane.columnIndex="1" GridPane.rowIndex="4" 
                      promptText="ID de l'entrée" styleClass="text-field"/>
        </GridPane>
        
        <!-- Buttons -->
        <HBox spacing="15" alignment="CENTER">
            <Button text="💾 Enregistrer" styleClass="button, button-success" 
                    prefWidth="150" onAction="#save"/>
            
            <Button text="❌ Annuler" styleClass="button, button-secondary" 
                    prefWidth="150" onAction="#cancel"/>
        </HBox>
        
        <!-- Status -->
        <Label fx:id="statusLabel" text="" 
               style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
    </VBox>
    
    <!-- Instructions -->
    <Label text="* Champs obligatoires | Intensité: 1-10" 
           style="-fx-text-fill: #7f8c8d;"/>

</VBox>
