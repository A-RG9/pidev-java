<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane stylesheets="@../css/wellcare.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellcare.javafx.controller.auth.ForgotPasswordController">
    <HBox styleClass="auth-background" alignment="CENTER">
        <VBox alignment="CENTER" maxWidth="500" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
            
            <VBox styleClass="auth-card" spacing="20" alignment="CENTER" maxWidth="450">
                <padding>
                    <Insets top="40" right="40" bottom="40" left="40"/>
                </padding>

                <!-- Icon/Logo Area -->
                <VBox alignment="CENTER" spacing="10">
                    <StackPane>
                        <Circle radius="40" fill="#FFF3CD"/>
                        <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                            <Image url="@../images/icons/password-reset.png"/>
                        </ImageView>
                    </StackPane>
                    
                    <Label text="Mot de passe oublié ?" styleClass="auth-title"/>
                    <Label text="Entrez votre email et nous vous enverrons un lien sécurisé pour réinitialiser votre mot de passe." styleClass="auth-subtitle" wrapText="true" textAlignment="CENTER" />
                </VBox>

                <!-- Messages -->
                <Label fx:id="errorLabel" styleClass="error-message" visible="false" managed="false" wrapText="true"/>
                <Label fx:id="successLabel" styleClass="success-message" visible="false" managed="false" wrapText="true"/>

                <!-- Input area -->
                <VBox spacing="15" alignment="CENTER_LEFT" prefWidth="1000">
                    <VBox spacing="5">
                        <Label text="Adresse Email" styleClass="field-label"/>
                        <TextField fx:id="emailField" promptText="votre.email@exemple.com" styleClass="input-field"/>
                    </VBox>

                    <!-- Loading Indicator -->
                    <HBox fx:id="loadingBox" alignment="CENTER" visible="false" managed="false" spacing="10">
                        <ProgressIndicator prefWidth="20" prefHeight="20"/>
                        <Label text="Envoi en cours..." textFill="#666666"/>
                    </HBox>

                    <Button fx:id="sendResetButton" text="Obtenir le lien de réinitialisation" onAction="#handleSendReset" styleClass="auth-button" maxWidth="Infinity">
                        <VBox.margin>
                            <Insets top="10"/>
                        </VBox.margin>
                    </Button>
                </VBox>
                
                <Separator/>
                
                <Hyperlink fx:id="backToLoginLink" text="Retour à la connexion" onAction="#handleBackToLogin" styleClass="secondary-link"/>

            </VBox>
            
        </VBox>
    </HBox>
</StackPane>
