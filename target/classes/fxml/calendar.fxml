<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wellora.javafx.controller.CalendarController"
            styleClass="main-scroll-pane"
            fitToWidth="true">

    <VBox spacing="20"
          styleClass="main-vbox"
          maxWidth="Infinity">

        <!-- Calendar Header -->
        <VBox spacing="10" styleClass="header-card">
            <Label text="📅 Calendrier de Santé" styleClass="page-title"/>
            <Label text="Vue mensuelle et données externes" styleClass="page-subtitle"/>
        </VBox>

        <!-- Month Navigation -->
        <HBox spacing="15"
              alignment="CENTER_LEFT"
              maxWidth="Infinity"
              styleClass="navigation-bar">

            <Button text="◀" onAction="#previousMonth" styleClass="button-secondary"/>
            <Label fx:id="monthYearLabel" text="Avril 2026" styleClass="month-label"/>
            <Button text="▶" onAction="#nextMonth" styleClass="button-secondary"/>
        </HBox>

        <!-- Summary Cards -->
        <HBox spacing="20" alignment="CENTER" maxWidth="Infinity">

            <VBox spacing="10" styleClass="stat-card" alignment="CENTER" HBox.hgrow="ALWAYS">
                <Label text="📅" styleClass="stat-icon"/>
                <Label text="Total Entries" styleClass="stat-label"/>
                <Label fx:id="totalEntriesLabel" text="0" styleClass="stat-value"/>
            </VBox>

            <VBox spacing="10" styleClass="stat-card" alignment="CENTER" HBox.hgrow="ALWAYS">
                <Label text="✅" styleClass="stat-icon"/>
                <Label text="Active Days" styleClass="stat-label"/>
                <Label fx:id="activeDaysLabel" text="0" styleClass="stat-value"/>
            </VBox>

            <VBox spacing="10" styleClass="stat-card" alignment="CENTER" HBox.hgrow="ALWAYS">
                <Label text="📊" styleClass="stat-icon"/>
                <Label text="Avg Score" styleClass="stat-label"/>
                <Label fx:id="avgScoreLabel" text="--" styleClass="stat-value"/>
            </VBox>

        </HBox>

        <!-- Calendar -->
        <VBox spacing="15" styleClass="calendar-card" maxWidth="Infinity">

            <!-- Header Grid -->
            <GridPane fx:id="dayHeaderGrid" hgap="5" vgap="5" maxWidth="Infinity">

                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Lun" GridPane.columnIndex="0" styleClass="day-header"/>
                <Label text="Mar" GridPane.columnIndex="1" styleClass="day-header"/>
                <Label text="Mer" GridPane.columnIndex="2" styleClass="day-header"/>
                <Label text="Jeu" GridPane.columnIndex="3" styleClass="day-header"/>
                <Label text="Ven" GridPane.columnIndex="4" styleClass="day-header"/>
                <Label text="Sam" GridPane.columnIndex="5" styleClass="day-header"/>
                <Label text="Dim" GridPane.columnIndex="6" styleClass="day-header"/>

            </GridPane>

            <!-- Calendar Grid -->
            <GridPane fx:id="calendarGrid" hgap="5" vgap="5" maxWidth="Infinity">

                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

            </GridPane>

        </VBox>

        <!-- Details -->
        <VBox fx:id="detailsPanel"
              spacing="15"
              styleClass="details-card"
              visible="false"
              maxWidth="Infinity">

            <Label text="📋 Détails du jour" styleClass="section-title"/>
            <Label fx:id="selectedDayLabel" text="Sélectionnez un jour" styleClass="selected-day-label"/>

            <GridPane hgap="15" vgap="10">

                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <VBox GridPane.columnIndex="0" spacing="5">
                    <Label text="Score de Santé" styleClass="detail-label"/>
                    <Label fx:id="healthScoreLabel" text="--" styleClass="detail-value"/>
                </VBox>

                <VBox GridPane.columnIndex="1" spacing="5">
                    <Label text="Symptômes" styleClass="detail-label"/>
                    <Label fx:id="symptomsLabel" text="--" styleClass="detail-value"/>
                </VBox>

            </GridPane>

            <!-- Weather Section -->
            <VBox spacing="8" styleClass="weather-section">
                <Label text="🌤️ Météo" styleClass="detail-label"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="weatherIcon" text="--" styleClass="weather-icon"/>
                    <VBox spacing="2">
                        <Label fx:id="temperatureLabel" text="Température: --" styleClass="detail-value"/>
                        <Label fx:id="conditionsLabel" text="Conditions: --" styleClass="detail-value"/>
                    </VBox>
                </HBox>
            </VBox>

        </VBox>

    </VBox>

</ScrollPane>