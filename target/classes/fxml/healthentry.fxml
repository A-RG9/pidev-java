<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wellora.javafx.controller.HealthentryController"
      fitToWidth="true"
      styleClass="root">
    
<VBox spacing="15" styleClass="root" prefWidth="1100">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <!-- Header -->
    <Label text="Health Entries" styleClass="header-label"/>
    
    <!-- Main Content -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        
        <!-- Left: Table View -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label text="All Entries" styleClass="section-label"/>
            
            <!-- Search Bar -->
            <HBox spacing="10">
                <TextField fx:id="searchField" promptText="Search by weight..." 
                         prefWidth="150" styleClass="text-field"/>
                <DatePicker fx:id="filterDatePicker" promptText="Min date"/>
                <Button text="Search" styleClass="button, button-primary" onAction="#search"/>
                <Button text="Refresh" styleClass="button, button-secondary" onAction="#refresh"/>
            </HBox>
            
            <!-- Table -->
            <TableView fx:id="tableView" styleClass="table-view" 
                      VBox.vgrow="ALWAYS" onMouseClicked="#selectRow">
                <columns>
                    <TableColumn text="Date" prefWidth="120"/>
                    <TableColumn text="Weight" prefWidth="70"/>
                    <TableColumn text="BloodSugar" prefWidth="80"/>
                    <TableColumn text="Pressure" prefWidth="80"/>
                    <TableColumn text="Sleep" prefWidth="70"/>
                </columns>
            </TableView>
            
            <!-- Symptoms for selected entry -->
            <Label text="Symptoms for this Entry" styleClass="section-label"/>
            <TableView fx:id="symptomTable" styleClass="table-view" prefHeight="120">
                <columns>
                    <TableColumn text="Type" prefWidth="100"/>
                    <TableColumn text="Intensity" prefWidth="60"/>
                    <TableColumn text="Zone" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
        
        <!-- Right: Form -->
        <VBox spacing="12" styleClass="card" prefWidth="380">
            <Label text="Entry Details" styleClass="section-label"/>
            
            <GridPane hgap="8" vgap="8">
                <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                
                <Label text="Weight (kg):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="poidsField" GridPane.columnIndex="1" GridPane.rowIndex="1" 
                           promptText="30-200" styleClass="text-field"/>
                
                <Label text="Blood Sugar (g/l):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="glycemieField" GridPane.columnIndex="1" GridPane.rowIndex="2" 
                           promptText="0.5-3" styleClass="text-field"/>
                
                <Label text="Pressure (mmHg):" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="tensionField" GridPane.columnIndex="1" GridPane.rowIndex="3" 
                           promptText="40-120" styleClass="text-field"/>
                
                <Label text="Sleep (h):" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="sommeilField" GridPane.columnIndex="1" GridPane.rowIndex="4" 
                           promptText="0-12" styleClass="text-field"/>
                
                <!-- Journal auto-assigned by date range -->
                <ComboBox fx:id="journalCombo" GridPane.columnIndex="1" GridPane.rowIndex="5" 
                          promptText="Select (or auto)"/>
            </GridPane>
            
            <!-- Add Symptom Section -->
            <Label text="Add Symptom" styleClass="section-label"/>
            <GridPane hgap="8" vgap="8">
                <Label text="Symptom:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="symptomTypeCombo" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                          promptText="Select type"/>
                
                <Label text="Intensity:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Slider fx:id="symptomIntensiteSlider" min="1" max="10" 
                           showTickLabels="true" blockIncrement="1"/>
                    <Label fx:id="symptomIntensiteLabel" text="5"/>
                </HBox>
                
                <Label text="Zone:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="symptomZoneField" GridPane.columnIndex="1" GridPane.rowIndex="2" 
                           promptText="e.g. head, back" styleClass="text-field"/>
            </GridPane>
            
            <!-- Buttons -->
            <VBox spacing="8" alignment="CENTER">
                <Button text="Add Entry" styleClass="button, button-success" 
                        prefWidth="160" onAction="#add"/>
                
                <Button text="Update" styleClass="button, button-primary" 
                        prefWidth="160" onAction="#update"/>
                
                <Button text="Delete" styleClass="button, button-danger" 
                        prefWidth="160" onAction="#delete"/>
                
                <Button text="Clear Form" styleClass="button, button-secondary" 
                        prefWidth="160" onAction="#clearForm"/>
            </VBox>
            
            <Label fx:id="statusLabel" text="" 
                   style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>
    
    <Label text="Enter a date and the journal will be auto-assigned | Select an entry to see its symptoms" 
           style="-fx-text-fill: #7f8c8d;"/>
    
</VBox>
    
</ScrollPane>