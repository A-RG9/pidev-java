<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellcare.javafx.controller.dashboard.PatientDashboardController">
    <children>
        <!-- Header -->
        <HBox styleClass="navbar" VBox.vgrow="NEVER">
            <children>
                <Label styleClass="navbar-brand" text="🏥 WellCare" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="15.0" alignment="CENTER_RIGHT">
                    <children>
                        <Button styleClass="btn-notification" text="🔔" />
                        <MenuButton fx:id="userMenu" styleClass="user-menu">
                            <items>
                                <MenuItem fx:id="profileMenuItem" text="👤 Profile" />
                                <MenuItem fx:id="settingsMenuItem" text="⚙️ Settings" />
                                <SeparatorMenuItem />
                                <MenuItem fx:id="logoutMenuItem" text="🚪 Logout" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Main Content -->
        <HBox VBox.vgrow="ALWAYS">
            <!-- Sidebar -->
            <VBox styleClass="sidebar" HBox.hgrow="NEVER">
                <children>
                    <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                        <VBox.margin>
                            <Insets top="20.0" right="0.0" bottom="20.0" left="0.0" />
                        </VBox.margin>
                        <children>
                            <Label styleClass="sidebar-title" text="Navigation" />
                            <Button fx:id="dashboardBtn" styleClass="sidebar-item, sidebar-item.active" text="📊 Dashboard" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="appointmentsBtn" styleClass="sidebar-item" text="📅 Appointments" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="medicalRecordsBtn" styleClass="sidebar-item" text="📋 Medical Records" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="prescriptionsBtn" styleClass="sidebar-item" text="💊 Prescriptions" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="messagesBtn" styleClass="sidebar-item" text="💬 Messages" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="billingBtn" styleClass="sidebar-item" text="💰 Billing" maxWidth="1.7976931348623157E308" />
                        </children>
                    </VBox>
                </children>
            </VBox>

            <!-- Main Dashboard Content -->
            <VBox HBox.hgrow="ALWAYS" spacing="20.0">
                <VBox.margin>
                    <Insets top="30.0" right="30.0" bottom="30.0" left="30.0" />
                </VBox.margin>
                <children>
                    <!-- Page Title -->
                    <HBox alignment="CENTER_LEFT">
                        <children>
                            <Label styleClass="page-title" text="Patient Dashboard" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="currentDateLabel" styleClass="current-date" />
                        </children>
                    </HBox>

                    <!-- Welcome Card -->
                    <HBox styleClass="card" alignment="CENTER_LEFT" spacing="20.0">
                        <children>
                            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label fx:id="welcomeLabel" styleClass="welcome-message" text="Welcome back, [Patient Name]!" />
                                    <Label styleClass="welcome-subtitle" text="Here's an overview of your health information" />
                                    <HBox spacing="15.0">
                                        <children>
                                            <Button styleClass="btn, btn-primary" text="📅 Book Appointment" />
                                            <Button styleClass="btn, btn-secondary" text="📋 View Records" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                            <VBox alignment="CENTER">
                                <children>
                                    <Label styleClass="medical-icon" text="🏥" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- Statistics Row -->
                    <HBox spacing="20.0">
                        <children>
                            <!-- Appointments Card -->
                            <VBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <Label styleClass="stat-icon" text="📅" />
                                            <VBox spacing="5.0">
                                                <children>
                                                    <Label styleClass="stat-number" fx:id="upcomingAppointmentsCount" text="3" />
                                                    <Label styleClass="stat-label" text="Upcoming Appointments" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <Button styleClass="btn, btn-outline" text="View All" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>

                            <!-- Prescriptions Card -->
                            <VBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <Label styleClass="stat-icon" text="💊" />
                                            <VBox spacing="5.0">
                                                <children>
                                                    <Label styleClass="stat-number" fx:id="activePrescriptionsCount" text="2" />
                                                    <Label styleClass="stat-label" text="Active Prescriptions" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <Button styleClass="btn, btn-outline" text="View All" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>

                            <!-- Messages Card -->
                            <VBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <Label styleClass="stat-icon" text="💬" />
                                            <VBox spacing="5.0">
                                                <children>
                                                    <Label styleClass="stat-number" fx:id="unreadMessagesCount" text="5" />
                                                    <Label styleClass="stat-label" text="Unread Messages" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <Button styleClass="btn, btn-outline" text="View All" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- Recent Activity and Upcoming Appointments -->
                    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                        <children>
                            <!-- Upcoming Appointments -->
                            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <VBox.margin>
                                    <Insets top="0.0" />
                                </VBox.margin>
                                <children>
                                    <Label styleClass="card-title" text="📅 Upcoming Appointments" />
                                    <ListView fx:id="upcomingAppointmentsList" VBox.vgrow="ALWAYS" />
                                    <Button styleClass="btn, btn-primary" text="Book New Appointment" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>

                            <!-- Recent Activity -->
                            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <VBox.margin>
                                    <Insets top="0.0" />
                                </VBox.margin>
                                <children>
                                    <Label styleClass="card-title" text="📋 Recent Activity" />
                                    <ListView fx:id="recentActivityList" VBox.vgrow="ALWAYS" />
                                    <Button styleClass="btn, btn-outline" text="View Full History" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </HBox>
    </children>
</VBox>