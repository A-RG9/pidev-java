<?xml version="1.0" encoding="UTF-8"?>

<!-- Services Page - Shows available services in the Wellora app -->
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wellora.javafx.controller.ServicesController"
      spacing="20"
      styleClass="services-container"
      stylesheets="@dashboard.css">

    <!-- Page Title -->
    <Label text="Our Services" styleClass="page-title"/>

    <!-- Services List -->
    <VBox spacing="15" styleClass="services-list">

        <!-- Service 1: API Service -->
        <VBox styleClass="service-card" spacing="10">
            <Label text="Motivational Quotes" styleClass="service-title"/>
            <Label text="Get daily motivational quotes from ZenQuotes API to stay inspired and focused on your health journey." styleClass="service-description"/>
            <Button text="Get Quote" styleClass="service-button" onAction="#fetchQuote"/>
        </VBox>

        <!-- Service 2: Health Advice -->
        <VBox styleClass="service-card" spacing="10">
            <Label text="Health Advice" styleClass="service-title"/>
            <Label text="Receive personalized health advice based on your daily health score and activity level." styleClass="service-description"/>
            <Button text="Get Advice" styleClass="service-button" onAction="#getHealthAdvice"/>
        </VBox>

        <!-- Service 3: Notifications -->
        <VBox styleClass="service-card" spacing="10">
            <Label text="Health Notifications" styleClass="service-title"/>
            <Label text="Receive reminders to log your health entries, stay hydrated, and maintain healthy habits." styleClass="service-description"/>
        </VBox>

        <!-- Service 4: Gamification -->
        <VBox styleClass="service-card" spacing="10">
            <Label text="Gamification" styleClass="service-title"/>
            <Label text="Earn badges and points for consistent health tracking. Stay motivated with achievements!" styleClass="service-description"/>
        </VBox>

        <!-- Service 5: PDF Export -->
        <VBox styleClass="service-card" spacing="10">
            <Label text="PDF Export" styleClass="service-title"/>
            <Label text="Export your health journal as a PDF report for your doctor visits." styleClass="service-description"/>
            <Button text="Export PDF" styleClass="service-button" onAction="#exportPdf"/>
        </VBox>

    </VBox>
</VBox>