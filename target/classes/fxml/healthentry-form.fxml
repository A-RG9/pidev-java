<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.wellora.javafx.controller.HealthentryFormController"
          fitToWidth="true"
          styleClass="root">
    
    <VBox spacing="20" styleClass="root" prefWidth="600">
    
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>
    
    <!-- Header -->
    <Label fx:id="headerLabel" text="Créer une Entrée" styleClass="header-label"/>
    
    <!-- Form Card -->
    <VBox spacing="20" styleClass="card">
        
        <GridPane hgap="15" vgap="15">
            <!-- Hidden ID Field -->
            <Label styleClass="form-label" text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" 
                   visible="false" managed="false"/>
            <TextField fx:id="idField" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                      visible="false" managed="false" editable="false"/>
            
            <!-- Date -->
            <Label styleClass="form-label" text="Date:*" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="1" 
                       promptText="Sélectionner la date"/>
            
            <!-- Weight -->
            <Label styleClass="form-label" text="Poids (kg):*" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="poidsField" GridPane.columnIndex="1" GridPane.rowIndex="2" 
                      promptText="30-200 kg" styleClass="text-field"/>
            
            <!-- Blood Sugar -->
            <Label styleClass="form-label" text="Glycémie (g/l):*" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="glycemieField" GridPane.columnIndex="1" GridPane.rowIndex="3" 
                      promptText="0.5-3 g/l" styleClass="text-field"/>
            
            <!-- Blood Pressure -->
            <Label styleClass="form-label" text="Tension (mmHg):*" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="tensionField" GridPane.columnIndex="1" GridPane.rowIndex="4" 
                      promptText="40-120" styleClass="text-field"/>
            
            <!-- Sleep -->
            <Label styleClass="form-label" text="Sommeil (h):*" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <TextField fx:id="sommeilField" GridPane.columnIndex="1" GridPane.rowIndex="5" 
                      promptText="0-12 heures" styleClass="text-field"/>
            
            <!-- Journal auto-assigned by date range in controller -->
        </GridPane>
        
        <!-- Symptoms Section -->
        <VBox spacing="10" styleClass="card">
            <Label text="Symptoms" styleClass="section-label"/>
            
            <!-- Existing Symptoms List (for editing) -->
            <VBox spacing="5">
                <Label text="Current Symptoms:" styleClass="subsection-label"/>
                <TableView fx:id="symptomTableView" prefHeight="120">
                    <columns>
                        <TableColumn text="Type" prefWidth="120">
                            <cellValueFactory><PropertyValueFactory property="type"/></cellValueFactory>
                        </TableColumn>
                        <TableColumn text="Intensity" prefWidth="80">
                            <cellValueFactory><PropertyValueFactory property="intensite"/></cellValueFactory>
                        </TableColumn>
                        <TableColumn text="Zone" prefWidth="100">
                            <cellValueFactory><PropertyValueFactory property="zone"/></cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
                <Button text="🗑️ Remove Selected" styleClass="button, button-danger" 
                        onAction="#removeSelectedSymptom" prefWidth="150"/>
            </VBox>
            
            <!-- Add New Symptom Form -->
            <GridPane hgap="10" vgap="8">
                <Label styleClass="form-label" text="Type:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="symptomTypeCombo" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Select type" prefWidth="150"/>
                
                <Label styleClass="form-label" text="Intensity:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Slider fx:id="symptomIntensiteSlider" min="1" max="10" 
                           showTickLabels="true" blockIncrement="1" prefWidth="100"/>
                    <Label fx:id="symptomIntensiteLabel" text="5"/>
                </HBox>
                
                <Label styleClass="form-label" text="Zone:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="symptomZoneField" GridPane.columnIndex="1" GridPane.rowIndex="2" 
                        promptText="e.g. head, back" prefWidth="150"/>
                
                <Button text="+ Add Symptom" styleClass="button, button-primary" 
                        GridPane.columnIndex="1" GridPane.rowIndex="3"
                        onAction="#addSymptom" prefWidth="120"/>
            </GridPane>
        </VBox>
        
        <!-- Buttons -->
        <HBox spacing="15" alignment="CENTER">
            <Button text="💾 Enregistrer" styleClass="button, button-success" 
                    prefWidth="150" onAction="#save"/>
            
            <Button text="❌ Annuler" styleClass="button, button-secondary" 
                    prefWidth="150" onAction="#cancel"/>
        </HBox>
        
        <!-- Status -->
        <Label fx:id="statusLabel" text="" 
               style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
    </VBox>
    
    <!-- Instructions -->
    <Label text="* Champs obligatoires | Cliquez sur Annuler pour revenir à la liste" 
           style="-fx-text-fill: #7f8c8d;"/>
    </VBox>
    
</ScrollPane>
