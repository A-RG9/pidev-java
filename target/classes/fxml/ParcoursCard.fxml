<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<VBox prefWidth="320.0" styleClass="parcours-card form-card" style="-fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellora.javafx.controller.ParcoursCardController">
    <children>
        <StackPane>
            <ImageView fx:id="imageView" fitHeight="180.0" fitWidth="320.0" pickOnBounds="true" preserveRatio="false" />
            <clip>
                <Rectangle arcHeight="30" arcWidth="30" height="180.0" width="320.0" />
            </clip>

            <HBox alignment="TOP_RIGHT" spacing="10" style="-fx-padding: 12;">
                <Button fx:id="btnEdit" prefHeight="38.0" prefWidth="38.0"
                        style="-fx-background-color: #17c8c8; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.15), 5, 0, 0, 2);">
                    <graphic>
                        <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" fill="#ffffff" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Button>

                <Button fx:id="btnDelete" prefHeight="38.0" prefWidth="38.0"
                        style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                    <graphic>
                        <SVGPath content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" fill="#e74c3c" scaleX="0.9" scaleY="0.9"/>
                    </graphic>
                </Button>
            </HBox>
        </StackPane>

        <VBox spacing="10.0" style="-fx-padding: 18;">
            <VBox spacing="2">
                <Label fx:id="nomLabel" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #1e272e;" text="Nom du Parcours" />
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <SVGPath content="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="#00a693" scaleX="0.6" scaleY="0.6" translateY="1" />
                    <Label fx:id="locationLabel" style="-fx-text-fill: #95a5a6; -fx-font-size: 13;" text="Localisation du parcours..." wrapText="false" />
                </HBox>
            </VBox>

            <Separator opacity="0.3" />

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #b2bec3; -fx-font-size: 10; -fx-font-weight: bold;" text="DISTANCE" />
                    <Label fx:id="distanceLabel" style="-fx-text-fill: #00a693; -fx-font-weight: bold; -fx-font-size: 14;" text="0.0 km" />
                </VBox>
                <Separator orientation="VERTICAL" />
                <VBox alignment="TOP_RIGHT" spacing="3" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #b2bec3; -fx-font-size: 10; -fx-font-weight: bold;" text="PUBLISHED" />
                    <Label fx:id="dateLabel" style="-fx-text-fill: #2d3436; -fx-font-size: 13;" text="il y a..." />
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="5" style="-fx-background-color: #e6f7f6; -fx-padding: 5 10; -fx-background-radius: 20;">
                    <Label fx:id="pubCountLabel" style="-fx-text-fill: #00a693; -fx-font-weight: bold; -fx-font-size: 12;" text="0 Pubs" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="btnInfo" prefHeight="38.0" prefWidth="38.0"
                        style="-fx-background-color: #f1f2f6; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.05), 3, 0, 0, 1);">
                    <graphic>
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" fill="#2d3436" scaleX="0.9" scaleY="0.9"/>
                    </graphic>
                </Button>

                <Button fx:id="btnView" prefHeight="38.0" prefWidth="38.0"
                        style="-fx-background-color: #00a693; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(one-pass-box, rgba(0,166,147,0.3), 5, 0, 0, 2);">
                    <graphic>
                        <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="#ffffff" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </children>
</VBox>
