<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" styleClass="parcours-toutes-publications root" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellora.javafx.controller.ToutesPublicationsController">

    <VBox style="-fx-background-color: linear-gradient(to right, #17c8c8, #17c8c8); -fx-padding: 30 40 30 40;">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-text-fill: white; -fx-font-size: 26; -fx-font-weight: bold;" text="🌍 Global Community Feed" />
            </HBox>
            <Label style="-fx-text-fill: #dbeafe; -fx-font-size: 15;" text="Discover all trail experiences from the community">
                <padding><Insets top="5.0" /></padding>
            </Label>
        </children>
    </VBox>

    <HBox spacing="25.0" style="-fx-padding: 30 40 40 40;" VBox.vgrow="ALWAYS">
        <children>

            <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                <children>
                    <VBox spacing="15.0" styleClass="form-card" style=" -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 15, 0, 0, 4);">
                        <children>
                            <HBox>
                                <Label fx:id="trailNameLabel" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #111827;" text="All Health Trails Publications" />
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <ComboBox fx:id="comboExperience" prefWidth="150.0" prefHeight="40.0" promptText="All experiences" styleClass="form-card" style=" -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                <ComboBox fx:id="comboType" prefWidth="130.0" prefHeight="40.0" promptText="All types" styleClass="form-card" style=" -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                <TextField fx:id="searchHashtag" prefWidth="150.0" prefHeight="40.0" promptText="#hashtag" styleClass="form-card" style=" -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 10;" />
                                <ComboBox fx:id="comboSort" prefWidth="150.0" prefHeight="40.0" promptText="Newest pub" styleClass="form-card" style=" -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                <ComboBox fx:id="comboPopularity" prefWidth="150.0" prefHeight="40.0" promptText="Popularity" styleClass="form-card" style=" -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                <Region HBox.hgrow="ALWAYS" />
                            </HBox>
                        </children>
                    </VBox>

                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="publicationsContainer" spacing="20.0" style="-fx-padding: 5 5 15 5;">
                            </VBox>
                        </content>
                    </ScrollPane>
                </children>
            </VBox>

            <VBox minWidth="320.0" prefWidth="320.0" spacing="20.0">
                <children>
                    <VBox spacing="15.0" styleClass="form-card" style=" -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 15, 0, 0, 4);">
                        <children>
                            <Label style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #111827;" text="🔥 Quick Links" />
                            <VBox spacing="10.0">
                                <Button fx:id="btnBackToTrails" alignment="BASELINE_LEFT" style="-fx-background-color: #f3f4f6; -fx-background-radius: 6; -fx-text-fill: #4b5563; -fx-font-size: 14; -fx-cursor: hand; -fx-padding: 10 15;" text="⬅ Back to trails" maxWidth="1.7976931348623157E308" />
                            </VBox>
                        </children>
                    </VBox>
                </children>
            </VBox>

        </children>
    </HBox>

</VBox>
