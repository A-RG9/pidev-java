<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellora.javafx.controller.PredictionController">
    <content>
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: #f5f5f5;">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <!-- Title Section -->
            <VBox alignment="CENTER" spacing="8">
                <Label text="🤖 AI Health Prediction" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                    <font>
                        <Font name="Segoe UI Bold" size="28" />
                    </font>
                </Label>
                <Label text="Analyse basée sur vos 5 derniers jours" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;">
                    <font>
                        <Font name="Segoe UI" size="14" />
                    </font>
                </Label>
            </VBox>

            <!-- Prediction Card -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e0e0e0; -fx-border-radius: 12; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);" spacing="0">
                <!-- Card Header -->
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: linear-gradient(to right, #3498db, #2c3e50); -fx-background-radius: 12 12 0 0; -fx-padding: 20 20 15 20;">
                    <Label text="📊" style="-fx-font-size: 24px;" />
                    <Label text="Résultat de la Prédiction" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;">
                        <font>
                            <Font name="Segoe UI Bold" size="18" />
                        </font>
                    </Label>
                </HBox>

                <!-- Card Body -->
                <VBox spacing="20" style="-fx-padding: 30;">
                    <!-- Prediction Result -->
                    <VBox alignment="CENTER" spacing="10">
                        <Label fx:id="predictionLabel" text="Calculating..." style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                            <font>
                                <Font name="Segoe UI Bold" size="32" />
                            </font>
                        </Label>
                    </VBox>

                    <!-- Separator -->
                    <HBox style="-fx-background-color: #ecf0f1; -fx-pref-height: 1;" />

                    <!-- Explanation Section -->
                    <VBox spacing="12">
                        <Label text="Explication Détaillée" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                            <font>
                                <Font name="Segoe UI Bold" size="16" />
                            </font>
                        </Label>
                        <Label fx:id="explanationLabel" text="Chargement de l'analyse..." style="-fx-font-size: 14px; -fx-text-fill: #34495e; -fx-line-spacing: 4;" wrapText="true">
                            <font>
                                <Font name="Segoe UI" size="14" />
                            </font>
                        </Label>
                    </VBox>

                    <!-- Separator -->
                    <HBox style="-fx-background-color: #ecf0f1; -fx-pref-height: 1;" />

                    <!-- Action Button -->
                    <HBox alignment="CENTER" spacing="15">
                        <Button fx:id="refreshButton" text="🔄 Refresh Prediction" onAction="#onRefreshClicked" style="-fx-background-color: linear-gradient(to right, #3498db, #2980b9); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8; -fx-cursor: hand;" />
                        <Button fx:id="methodologyButton" text="ℹ️ Methodology" onAction="#onMethodologyClicked" style="-fx-background-color: #ecf0f1; -fx-text-fill: #2c3e50; -fx-font-size: 14px; -fx-padding: 12 24; -fx-background-radius: 8; -fx-cursor: hand;" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- Info Note -->
            <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20;">
                <Label text="💡" style="-fx-font-size: 20px;" />
                <Label text="Cette prédiction est basée sur l'analyse de vos données récentes" style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;">
                    <font>
                        <Font name="Segoe UI" size="12" />
                    </font>
                </Label>
                <Label text="Consultez toujours un professionnel de santé pour des conseils médicaux" style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;">
                    <font>
                        <Font name="Segoe UI" size="12" />
                    </font>
                </Label>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
