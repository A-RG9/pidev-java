<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.GoalCardController" spacing="12" prefWidth="550" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2); -fx-padding: 20 24;">

    <!-- Header avec statut et catégorie -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="lblStatus" text="En cours" style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-padding: 4 12; -fx-background-radius: 12; -fx-font-size: 11px; -fx-font-weight: bold;"/>
        <Label fx:id="lblCategory" text="Général" style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-padding: 4 12; -fx-background-radius: 12; -fx-font-size: 11px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblDaysLeft" text="15 jours restants" style="-fx-text-fill: #F59E0B; -fx-font-size: 11px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Titre et description -->
    <Text fx:id="txtTitle" text="Titre de l'objectif" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #1E293B;" wrappingWidth="480"/>
    <Text fx:id="txtDescription" text="Description de l'objectif" style="-fx-font-size: 13px; -fx-fill: #64748B;" wrappingWidth="480"/>

    <!-- Progression -->
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 5 0;">
        <Label text="Progression :" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
        <Label fx:id="lblProgress" text="0%" style="-fx-text-fill: #10B981; -fx-font-weight: bold; -fx-font-size: 14px;"/>
    </HBox>
    <ProgressBar fx:id="progressBar" progress="0.0" prefHeight="8" prefWidth="500" style="-fx-accent: #10B981; -fx-background-radius: 10;"/>

    <!-- Footer avec infos patient et boutons -->
    <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 15 0 0 0;">
        <VBox spacing="3">
            <Label text="👤 Patient" style="-fx-text-fill: #94A3B8; -fx-font-size: 10px; -fx-font-weight: bold;"/>
            <Label fx:id="lblPatient" text="Non assigné" style="-fx-text-fill: #1E293B; -fx-font-size: 12px; -fx-font-weight: 500;"/>
        </VBox>
        <VBox spacing="3">
            <Label text="📅 Échéance" style="-fx-text-fill: #94A3B8; -fx-font-size: 10px; -fx-font-weight: bold;"/>
            <Label fx:id="lblEndDate" text="Non définie" style="-fx-text-fill: #1E293B; -fx-font-size: 12px; -fx-font-weight: 500;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnEdit" text="✏️ Modifier" style="-fx-background-color: #EFF6FF; -fx-text-fill: #3B82F6; -fx-background-radius: 8; -fx-padding: 7 14; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 12px;"/>
        <Button fx:id="btnDelete" text="🗑️ Supprimer" style="-fx-background-color: #FEF2F2; -fx-text-fill: #EF4444; -fx-background-radius: 8; -fx-padding: 7 14; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 12px;"/>
    </HBox>

</VBox>