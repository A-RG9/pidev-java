<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.CountryChallengeController"
            fitToWidth="true"
            style="-fx-background-color: #F8FAFC; -fx-background: transparent;">

    <VBox spacing="25" style="-fx-padding: 30;">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox>
                <Label text="🌍 Défis Sportifs du Monde" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                <Label text="Inspirez-vous des cultures du monde entier pour relever vos défis sportifs"
                       style="-fx-text-fill: #64748B; -fx-font-size: 13px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🔄 Nouveau défi" onAction="#refreshChallenge"
                    style="-fx-background-color: #14b8a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 20; -fx-cursor: hand;"/>
        </HBox>

        <!-- Carte du défi principal -->
        <VBox fx:id="challengeCard" spacing="20" style="-fx-background-color: white; -fx-background-radius: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3); -fx-padding: 25;">

            <!-- En-tête du pays -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <ImageView fx:id="countryFlag" fitWidth="80" fitHeight="50" style="-fx-border-radius: 8; -fx-border-color: #E2E8F0;"/>
                <VBox>
                    <Label fx:id="countryName" text="Chargement..." style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <Label fx:id="countryRegion" text="" style="-fx-text-fill: #64748B; -fx-font-size: 13px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="countryEmoji" text="🌍" style="-fx-font-size: 48px;"/>
            </HBox>

            <Separator style="-fx-background-color: #E2E8F0;"/>

            <!-- Statistiques du pays -->
            <GridPane hgap="20" vgap="15">
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="👥 Population" style="-fx-text-fill: #64748B; -fx-font-size: 11px;"/>
                    <Label fx:id="countryPopulation" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="🗺️ Région" style="-fx-text-fill: #64748B; -fx-font-size: 11px;"/>
                    <Label fx:id="countryRegionValue" text="-" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="🏅 Défis complétés" style="-fx-text-fill: #64748B; -fx-font-size: 11px;"/>
                    <Label fx:id="challengesCompleted" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #10B981;"/>
                </VBox>
            </GridPane>

            <Separator style="-fx-background-color: #E2E8F0;"/>

            <!-- Défi sportif -->
            <VBox spacing="15" style="-fx-background-color: #F0FDF4; -fx-background-radius: 16; -fx-padding: 20;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="challengeEmoji" text="🏋️‍♂️" style="-fx-font-size: 32px;"/>
                    <Label text="DÉFI SPORTIF" style="-fx-text-fill: #0D9488; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                </HBox>
                <Label fx:id="challengeText" text="Chargement..." style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-wrap-text: true;"/>
                <Label fx:id="challengeDescription" text="" style="-fx-text-fill: #64748B; -fx-font-size: 13px; -fx-wrap-text: true;"/>
            </VBox>

            <!-- Actions -->
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button fx:id="btnAcceptChallenge" text="✅ Accepter le défi" onAction="#acceptChallenge"
                        style="-fx-background-color: #14b8a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 25; -fx-cursor: hand;"/>
                <Button text="🔄 Autre défi" onAction="#refreshChallenge"
                        style="-fx-background-color: #EFF6FF; -fx-text-fill: #3B82F6; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 20; -fx-cursor: hand;"/>
            </HBox>
        </VBox>

        <!-- Section des défis complétés récemment -->
        <VBox spacing="15">
            <Label text="📋 Mes défis complétés" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
            <ListView fx:id="completedChallengesList" prefHeight="200"
                      style="-fx-background-radius: 12; -fx-background-color: white; -fx-border-radius: 12; -fx-border-color: #E2E8F0;"/>
        </VBox>

        <!-- Section inspiration -->
        <VBox spacing="15" style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -fx-background-radius: 20; -fx-padding: 25;">
            <Label text="💡 Le saviez-vous ?" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="funFactLabel" text="Chargement..." style="-fx-text-fill: #E2E8F0; -fx-font-size: 13px; -fx-wrap-text: true;"/>
        </VBox>
    </VBox>
</ScrollPane>