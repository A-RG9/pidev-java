<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.controllers.DailyPlanController" styleClass="main-bg">

    <BorderPane>
        <top>
            <HBox spacing="20" style="-fx-padding: 20;" alignment="CENTER_LEFT">
                <VBox>
                    <Label text="Daily Plans" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <Label text="Organisez vos séances par objectif" style="-fx-text-fill: #94a3b8;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchPlan" promptText="Rechercher un plan..." prefWidth="200" styleClass="text-field"/>
                <Button text="+ Créer un Plan" onAction="#openAddForm" style="-fx-background-color: #14b8a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>
        </top>

        <center>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <VBox fx:id="plansContainer" spacing="10" style="-fx-padding: 20;" />
            </ScrollPane>
        </center>
    </BorderPane>

    <VBox fx:id="formOverlay" visible="false" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.85);">
        <VBox spacing="15" maxWidth="550" style="-fx-background-color: #1e293b; -fx-padding: 25; -fx-background-radius: 15; -fx-border-color: #334155;">
            <Label text="Configuration du Plan Journalier" style="-fx-font-size: 20; -fx-text-fill: white; -fx-font-weight: bold;"/>

            <Separator opacity="0.1" />

            <VBox spacing="5">
                <Label text="Titre du plan" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;"/>
                <TextField fx:id="txtTitre" promptText="ex: Séance de renforcement matin" />
            </VBox>

            <HBox spacing="15">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Objectif associé" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;"/>
                    <ComboBox fx:id="comboGoals" promptText="Choisir un Goal" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Date prévue" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;"/>
                    <DatePicker fx:id="datePicker" prefWidth="150"/>
                </VBox>
            </HBox>

            <VBox spacing="5">
                <Label text="Notes / Instructions" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;"/>
                <TextArea fx:id="txtNotes" promptText="Détails supplémentaires sur la séance..." prefHeight="70" wrapText="true" />
            </VBox>

            <VBox spacing="5">
                <Label text="Exercices à inclure" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;"/>
                <ScrollPane prefHeight="130" style="-fx-background-color: #0f172a; -fx-background: #0f172a; -fx-border-color: #334155;">
                    <VBox fx:id="exerciseList" spacing="8" style="-fx-padding: 10;" />
                </ScrollPane>
            </VBox>

            <HBox spacing="15">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Durée (min)" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;"/>
                    <TextField fx:id="txtDuree" promptText="0" />
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Calories estimées" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;"/>
                    <TextField fx:id="txtCalories" promptText="0" />
                </VBox>
            </HBox>

            <Region prefHeight="10" />

            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button text="Annuler" onAction="#closeForm"
                        style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand;"/>
                <Button text="Enregistrer le Plan" onAction="#handleSave"
                        style="-fx-background-color: #14b8a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>