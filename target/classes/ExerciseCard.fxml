<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.web.WebView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.wellcare.javafx.controller.ExerciseCardController"
      spacing="12"
      prefWidth="350"
      style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2); -fx-padding: 16;">

    <WebView fx:id="videoPlayer" prefHeight="200" prefWidth="318"
             style="-fx-border-radius: 12; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-width: 1px;"/>

    <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 5 0 0 0;">
        <Label fx:id="lblCategory" text="Catégorie"
               style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-padding: 4 12; -fx-background-radius: 12; -fx-font-size: 11px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblDifficulty" text="Intermédiaire"
               style="-fx-text-fill: #8B5CF6; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 4 8; -fx-background-color: #F3E8FF; -fx-background-radius: 10;"/>
        <Label fx:id="lblDuration" text="15 min"
               style="-fx-text-fill: #10B981; -fx-font-size: 12px; -fx-font-weight: bold;"/>
    </HBox>

    <Text fx:id="txtTitle" text="Titre de l'exercice"
          style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #1E293B;" wrappingWidth="310"/>
    <Text fx:id="txtDescription" text="Description de l'exercice..."
          style="-fx-font-size: 13px; -fx-fill: #64748B;" wrappingWidth="310"/>

    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
        <Button text="✏️ Modifier" onAction="#handleEdit"
                style="-fx-background-color: #EFF6FF; -fx-text-fill: #3B82F6; -fx-background-radius: 8; -fx-padding: 6 16; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 12px;"/>
        <Button text="🗑️ Supprimer" onAction="#handleDelete"
                style="-fx-background-color: #FEF2F2; -fx-text-fill: #EF4444; -fx-background-radius: 8; -fx-padding: 6 16; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 12px;"/>
    </HBox>
</VBox>