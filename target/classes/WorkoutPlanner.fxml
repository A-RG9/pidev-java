<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox spacing="0" prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #F8FAFC;" stylesheets="@style.css" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.WorkoutPlannerController">

    <VBox spacing="20" HBox.hgrow="ALWAYS" style="-fx-padding: 30;">
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox>
                <Label text="Workout Planner" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                <Label text="Organize your daily fitness plans" style="-fx-text-fill: #64748B;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />

            <ComboBox fx:id="comboGoals" promptText="Select Goal" prefWidth="200"
                      style="-fx-background-radius: 10; -fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 10;"/>

            <HBox spacing="5" alignment="CENTER">
                <Button text="&lt;" onAction="#prevMonth" styleClass="btn-nav"/>
                <Label fx:id="lblMonthYear" text="April 2026" style="-fx-font-weight: bold; -fx-padding: 0 10;"/>
                <Button text="&gt;" onAction="#nextMonth" styleClass="btn-nav"/>
            </HBox>
        </HBox>

        <GridPane fx:id="calendarGrid" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-color: #E2E8F0; -fx-border-radius: 20; -fx-padding: 10;">
        </GridPane>
    </VBox>

    <VBox spacing="25" prefWidth="350" style="-fx-background-color: white; -fx-padding: 30; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 0 1;">
        <Label fx:id="lblSelectedDate" text="Select a date" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>

        <VBox spacing="10" fx:id="detailsContainer">
            <HBox spacing="15">
                <VBox styleClass="stat-box-light" HBox.hgrow="ALWAYS">
                    <Label text="Duration" style="-fx-text-fill: #64748B; -fx-font-size: 12;"/>
                    <Label fx:id="lblDuration" text="0 min" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                </VBox>
                <VBox styleClass="stat-box-light" HBox.hgrow="ALWAYS">
                    <Label text="Calories" style="-fx-text-fill: #64748B; -fx-font-size: 12;"/>
                    <Label fx:id="lblCalories" text="0 kcal" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                </VBox>
            </HBox>
        </VBox>

        <Separator />

        <VBox alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS" spacing="15">
            <Label text="Ready for a new session?" style="-fx-text-fill: #94A3B8;"/>
            <Button text="+ Add Daily Plan" onAction="#loadDailyPlanEditor" style="-fx-background-color: #0D9488; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-padding: 12 30; -fx-cursor: hand;"/>

        </VBox>
    </VBox>
</HBox>