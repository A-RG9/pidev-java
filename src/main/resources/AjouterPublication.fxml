<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="850.0" prefWidth="1400.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controles.AjouterPublicationController">

    <left>
        <VBox prefWidth="280.0" style="-fx-background-color: #ffffff; -fx-border-color: #eaeff2; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <padding>
                    <Insets bottom="20.0" left="25.0" right="20.0" top="25.0" />
                </padding>
                <children>
                    <Label alignment="CENTER" prefHeight="35.0" prefWidth="35.0" style="-fx-background-color: #00d09c; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 16;" text="♡" />
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #0a1b2a; -fx-font-size: 20px;" text="WellCare" />
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #f8f9fc; -fx-background-radius: 10;">
                <VBox.margin>
                    <Insets bottom="15.0" left="15.0" right="15.0" />
                </VBox.margin>
                <padding>
                    <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                </padding>
                <children>
                    <Label alignment="CENTER" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #00d09c; -fx-text-fill: white; -fx-background-radius: 50; -fx-font-weight: bold; -fx-font-size: 14px;" text="ar" />
                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <children>
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #1a2b3c; -fx-font-size: 13px;" text="ahmed regaieg" />
                            <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="regaieg.ahmed2003@gmail.c..." />
                        </children>
                    </VBox>
                </children>
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: white; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="5.0">
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 20 12 25; -fx-cursor: hand;">
                            <Label prefWidth="35.0" style="-fx-font-size: 16; -fx-text-fill: #555;" text="📅" />
                            <Label style="-fx-font-size: 14; -fx-text-fill: #34495e;" text="Rendez-vous" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label style="-fx-text-fill: #bdc3c7;" text="˅" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 20 12 25; -fx-cursor: hand;">
                            <Label prefWidth="35.0" style="-fx-font-size: 16; -fx-text-fill: #555;" text="♡" />
                            <Label style="-fx-font-size: 14; -fx-text-fill: #34495e;" text="Santé" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label style="-fx-text-fill: #bdc3c7;" text="˅" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 20 12 25; -fx-cursor: hand;">
                            <Label prefWidth="35.0" style="-fx-font-size: 16; -fx-text-fill: #555;" text="📖" />
                            <Label style="-fx-font-size: 14; -fx-text-fill: #34495e;" text="Nutrition" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label style="-fx-text-fill: #bdc3c7;" text="˅" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 20 12 25; -fx-cursor: hand;">
                            <Label prefWidth="35.0" style="-fx-font-size: 16; -fx-text-fill: #555;" text="♥" />
                            <Label style="-fx-font-size: 14; -fx-text-fill: #34495e;" text="Fitness" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label style="-fx-text-fill: #bdc3c7;" text="˅" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #e8f8f5; -fx-padding: 12 20 12 15; -fx-background-radius: 8; -fx-cursor: hand;">
                            <VBox.margin>
                                <Insets bottom="15.0" left="10.0" right="10.0" top="5.0" />
                            </VBox.margin>
                            <children>
                                <Label prefWidth="35.0" style="-fx-font-size: 16; -fx-text-fill: #4e6a7c;" text=" 🌍" />
                                <Label style="-fx-font-size: 14; -fx-text-fill: #4e6a7c; -fx-font-weight: bold;" text="Health Trail" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-text-fill: #bdc3c7;" text="˅" />
                            </children>
                        </HBox>

                    </VBox>
                </content>
            </ScrollPane>

            <VBox spacing="10.0" style="-fx-padding: 15 20 20 25;">
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #34495e; -fx-font-size: 14; -fx-padding: 5 0 5 0;" text="«    Réduire" />
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #34495e; -fx-font-size: 14; -fx-padding: 5 0 5 0;" text="👤   Mon Profil" />
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 5 0 5 0;" text="🚪   Déconnexion" />
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox style="-fx-background-color: #f4f7f6;">
            <children>
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #f4f7f6;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox alignment="TOP_CENTER" spacing="0">
                            <padding>
                                <Insets bottom="40.0" left="20.0" right="20.0" top="30.0" />
                            </padding>
                            <children>
                                <VBox maxWidth="850.0" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 8);">
                                    <children>
                                        <VBox spacing="5">
                                            <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1e272e;" text="New Publication" />
                                            <Label style="-fx-text-fill: #95a5a6; -fx-font-size: 14;" text="Share your trail experience and help others in the community." />
                                            <Separator opacity="0.3">
                                                <VBox.margin><Insets top="10" /></VBox.margin>
                                            </Separator>
                                        </VBox>

                                        <VBox spacing="8">
                                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 13;" text="TAGGED TRAIL" />
                                            <TextField fx:id="trailNameField" editable="false" prefHeight="45.0" style="-fx-background-color: #f1f2f6; -fx-border-color: #eef2f5; -fx-background-radius: 8; -fx-border-radius: 8; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" />
                                        </VBox>

                                        <VBox spacing="8">
                                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 13;" text="CONTENT" />
                                            <TextArea fx:id="pubTextArea" prefHeight="150.0" promptText="Describe your walk, the scenery, or any tips..." style="-fx-background-color: white; -fx-border-color: #eef2f5; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-size: 14;" wrapText="true" />
                                        </VBox>

                                        <GridPane hgap="20.0" vgap="20.0">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints minHeight="10.0" prefHeight="70.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="70.0" vgrow="SOMETIMES" />
                                            </rowConstraints>
                                            <children>
                                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 12;" text="AMBIANCE (1-5)" />
                                                    <TextField fx:id="ambianceField" prefHeight="45.0" promptText="5" style="-fx-background-color: #f8f9fa; -fx-border-color: #eef2f5; -fx-background-radius: 8; -fx-border-radius: 8;" />
                                                </VBox>
                                                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 12;" text="SAFETY (1-5)" />
                                                    <TextField fx:id="safetyField" prefHeight="45.0" promptText="5" style="-fx-background-color: #f8f9fa; -fx-border-color: #eef2f5; -fx-background-radius: 8; -fx-border-radius: 8;" />
                                                </VBox>
                                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 12;" text="EXPERIENCE LEVEL" />
                                                    <ComboBox fx:id="experienceCombo" maxWidth="Infinity" prefHeight="45.0" promptText="Select level" style="-fx-background-color: #f8f9fa; -fx-border-color: #eef2f5;" />
                                                </VBox>
                                                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 12;" text="POST TYPE" />
                                                    <ComboBox fx:id="typeCombo" maxWidth="Infinity" prefHeight="45.0" promptText="Select category" style="-fx-background-color: #f8f9fa; -fx-border-color: #eef2f5;" />
                                                </VBox>
                                            </children>
                                        </GridPane>

                                        <HBox spacing="20.0">
                                            <children>
                                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 12;" text="PUBLICATION DATE" />
                                                    <DatePicker fx:id="datePicker" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #eef2f5;" />
                                                </VBox>
                                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 12;" text="IMAGE (OPTIONAL)" />
                                                    <HBox alignment="CENTER_LEFT" prefHeight="45.0" style="-fx-border-color: #eef2f5; -fx-border-radius: 8; -fx-background-color: #f8f9fa; -fx-background-radius: 8;">
                                                        <children>
                                                            <Button fx:id="btnChooseFile" mnemonicParsing="false" prefHeight="45.0" style="-fx-background-color: #2d3436; -fx-text-fill: white; -fx-background-radius: 8 0 0 8; -fx-cursor: hand; -fx-padding: 0 15;" text="Browse" />
                                                            <Label fx:id="fileLabel" style="-fx-text-fill: #95a5a6; -fx-font-size: 12;" text="No file selected">
                                                                <padding><Insets left="10.0" /></padding>
                                                            </Label>
                                                        </children>
                                                    </HBox>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                                            <children>
                                                <Button fx:id="btnCancel" prefHeight="45.0" prefWidth="120.0" style="-fx-background-color: transparent; -fx-border-color: #d63031; -fx-border-radius: 8; -fx-text-fill: #d63031; -fx-cursor: hand;" text="Cancel" />
                                                <Button fx:id="btnSave" prefHeight="45.0" prefWidth="150.0" style="-fx-background-color: #00a693; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,166,147,0.2), 10, 0, 0, 5);" text="Share Post" />
                                            </children>
                                            <padding><Insets top="10.0" /></padding>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>

</BorderPane>