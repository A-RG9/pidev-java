<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controles.AfficherPublicationsController">
    <children>
        <VBox style="-fx-background-color: #009688; -fx-padding: 20 30 20 30;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" text="👥 Community Publications" />
                </HBox>
                <Label style="-fx-text-fill: #e0f2f1; -fx-font-size: 14;" text="Discover trail experiences from the community" />
            </children>
        </VBox>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS" style="-fx-padding: 30;">
            <children>
                <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                    <children>
                        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <children>
                                <HBox>
                                    <Label style="-fx-text-fill: #636e72; -fx-font-size: 14;" text="Showing publications for " />
                                    <Label fx:id="trailNameLabel" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2d3436;" text="TRAIL NAME" />
                                </HBox>

                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <ComboBox fx:id="comboExperience" prefWidth="150.0" promptText="All experiences" style="-fx-background-color: white; -fx-border-color: #dfe6e9; -fx-border-radius: 5;" />
                                    <ComboBox fx:id="comboType" prefWidth="130.0" promptText="All types" style="-fx-background-color: white; -fx-border-color: #dfe6e9; -fx-border-radius: 5;" />
                                    <TextField fx:id="searchHashtag" prefWidth="150.0" promptText="#hashtag" style="-fx-background-color: white; -fx-border-color: #dfe6e9; -fx-border-radius: 5; -fx-padding: 8;" />
                                    <ComboBox fx:id="comboSort" prefWidth="150.0" promptText="Newest pub" style="-fx-background-color: white; -fx-border-color: #dfe6e9; -fx-border-radius: 5;" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button prefHeight="35.0" prefWidth="40.0" style="-fx-background-color: #009688; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="▼" />
                                    <Button fx:id="btnAddPublication" prefHeight="35.0" prefWidth="40.0" style="-fx-background-color: #009688; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="+" />
                                </HBox>
                            </children>
                        </VBox>

                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="publicationsContainer" spacing="15.0">
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

                <VBox spacing="20.0" prefWidth="300.0" minWidth="300.0">
                    <children>
                        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #2d3436;" text="🖋 Share Your Experience" />
                                <Button fx:id="btnWritePublication" maxWidth="Infinity" prefHeight="40.0" style="-fx-background-color: #009688; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="📷 Write a Publication" />
                            </children>
                        </VBox>

                        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #2d3436;" text="🔥 Quick Links" />
                                <VBox spacing="10.0">
                                    <Button alignment="BASELINE_LEFT" style="-fx-background-color: transparent; -fx-text-fill: #636e72; -fx-cursor: hand; -fx-padding: 5 0 5 0;" text="Trail publication feed" />
                                    <Button fx:id="btnBackToTrails" alignment="BASELINE_LEFT" style="-fx-background-color: transparent; -fx-text-fill: #636e72; -fx-cursor: hand; -fx-padding: 5 0 5 0;" text="Back to trails" />
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>