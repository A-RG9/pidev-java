<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controles.AfficherParcoursController">
    <children>
        <VBox prefWidth="300.0" spacing="15.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label style="-fx-text-fill: #00a693; -fx-font-size: 16;" text="▼" />
                    <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2d3436;" text="Filters" />
                </HBox>

                <VBox spacing="5.0" style="-fx-padding: 10 0 10 0;">
                    <Label style="-fx-text-fill: #00a693; -fx-font-weight: bold; -fx-font-size: 12;" text="✨ AI TRAIL CHAT" />
                    <Label wrapText="true" style="-fx-text-fill: #636e72; -fx-font-size: 11;" text="Click the chat icon at the bottom-right to open AI recommendations." />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Parcours Name" style="-fx-text-fill: #636e72; -fx-font-size: 12;" />
                    <TextField fx:id="searchName" prefHeight="35.0" promptText="Search by name..." style="-fx-background-color: white; -fx-border-color: #dfe6e9; -fx-border-radius: 5; -fx-background-radius: 5;" />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Location" style="-fx-text-fill: #636e72; -fx-font-size: 12;" />
                    <TextField fx:id="searchLocation" prefHeight="35.0" promptText="Search by location..." style="-fx-background-color: white; -fx-border-color: #dfe6e9; -fx-border-radius: 5; -fx-background-radius: 5;" />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Distance (km)" style="-fx-text-fill: #636e72; -fx-font-size: 12;" />
                    <Slider fx:id="distanceSlider" max="20.0" value="20.0" style="-fx-accent: #00a693;" />
                    <HBox alignment="CENTER_LEFT">
                        <Label text="0 km" style="-fx-text-fill: #b2bec3; -fx-font-size: 11;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="distanceValueLabel" text="20.0 km" style="-fx-text-fill: #00a693; -fx-font-weight: bold; -fx-font-size: 12;" />
                    </HBox>
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Number of Publications" style="-fx-text-fill: #636e72; -fx-font-size: 12;" />
                    <Slider fx:id="pubSlider" max="200.0" value="200.0" style="-fx-accent: #00a693;" />
                    <HBox alignment="CENTER_LEFT">
                        <Label text="0" style="-fx-text-fill: #b2bec3; -fx-font-size: 11;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="pubValueLabel" text="200" style="-fx-text-fill: #00a693; -fx-font-weight: bold; -fx-font-size: 12;" />
                    </HBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <HBox spacing="10.0">
                    <Button fx:id="btnSearch" maxWidth="Infinity" HBox.hgrow="ALWAYS" prefHeight="40.0" style="-fx-background-color: #00a693; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Search" />
                    <Button fx:id="btnReset" prefHeight="40.0" prefWidth="45.0" style="-fx-background-color: white; -fx-border-color: #dfe6e9; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #2d3436; -fx-font-weight: bold;" text="↻" />
                </HBox>
            </children>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" spacing="20.0">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="countLabel" style="-fx-font-size: 16; -fx-text-fill: #636e72;" text="0 parcours available" />
                        <Region HBox.hgrow="ALWAYS" />

                        <Button prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: white; -fx-border-color: #dfe6e9; -fx-border-radius: 5;" />
                        <Button prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: white; -fx-border-color: #dfe6e9; -fx-border-radius: 5;" text="≣" />

                        <ComboBox fx:id="sortCombo" prefHeight="40.0" prefWidth="130.0" promptText="Date de création" style="-fx-background-color: white; -fx-border-color: #dfe6e9; -fx-border-radius: 5;" />

                        <Button fx:id="btnSortAsc" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: white; -fx-border-color: #dfe6e9; -fx-border-radius: 5; -fx-cursor: hand;" text="↑" />
                        <Button fx:id="btnSortDesc" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #00a693; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="↓" />
                        <Button fx:id="btnAdd" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #00a693; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 18; -fx-cursor: hand;" text="+" />
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="cardsContainer" hgap="25.0" vgap="25.0">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                        </FlowPane>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</HBox>