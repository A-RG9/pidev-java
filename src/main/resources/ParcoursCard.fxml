<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="320.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controles.ParcoursCardController">
    <children>
        <StackPane style="-fx-background-radius: 15 15 0 0; -fx-overflow: hidden;">
            <ImageView fx:id="imageView" fitHeight="180.0" fitWidth="320.0" pickOnBounds="true" preserveRatio="false" style="-fx-background-radius: 15 15 0 0;" />
            <HBox alignment="TOP_RIGHT" spacing="10" style="-fx-padding: 15;">
                <Button fx:id="btnEdit" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: white; -fx-background-radius: 50; -fx-text-fill: #4361ee; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" text="📝" />
                <Button fx:id="btnDelete" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: white; -fx-background-radius: 50; -fx-text-fill: #ff4d4d; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" text="🗑" />
            </HBox>
        </StackPane>

        <VBox spacing="8.0" style="-fx-padding: 15;">
            <Label fx:id="nomLabel" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #2d3436;" text="Nom du Parcours" />

            <HBox alignment="CENTER_LEFT" spacing="5">
                <Label style="-fx-text-fill: #b2bec3; -fx-font-size: 14;" text="📍" />
                <Label fx:id="locationLabel" prefHeight="40.0" style="-fx-text-fill: #636e72; -fx-font-size: 13;" text="Localisation du parcours..." wrapText="true" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="5">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #00a693;" text="📏" />
                <Label fx:id="distanceLabel" style="-fx-text-fill: #00a693; -fx-font-weight: bold;" text="0.0 km" />
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-text-fill: #b2bec3;" text="📅" />
                <Label fx:id="dateLabel" style="-fx-text-fill: #b2bec3; -fx-font-size: 11;" text="il y a..." />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="5">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #00a693;" text="📝" />
                <Label fx:id="pubCountLabel" style="-fx-text-fill: #00a693; -fx-font-weight: bold;" text="0 Publications" />
            </HBox>

            <Region VBox.vgrow="ALWAYS" prefHeight="10.0"/>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="btnInfo" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #00a693; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 5, 0, 0, 3);" text="i" />
                <Button fx:id="btnView" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #4361ee; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 5, 0, 0, 3);" text="👁" />
            </HBox>
        </VBox>
    </children>
</VBox>