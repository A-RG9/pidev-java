<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 30; -fx-background-color: #F8FAFC;" prefWidth="450" prefHeight="420" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.WorkoutXImportController">

    <Label text="📥 Import WorkoutX" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
    <Label text="Récupération paginée (10 par page)" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>

    <Separator/>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="📊 Nombre d'exercices:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtLimit" promptText="100" prefWidth="100" style="-fx-alignment: center;"/>
        <Label text="(max 500)" style="-fx-text-fill: #94A3B8;"/>
    </HBox>

    <ProgressBar fx:id="importProgress" visible="false" prefWidth="350"/>
    <Label fx:id="lblStatus" text="" style="-fx-text-fill: #10B981;"/>

    <TextArea fx:id="logArea" prefHeight="150" editable="false" style="-fx-background-color: white; -fx-border-color: #E2E8F0;"/>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="🚀 Importer (limite)" onAction="#importWithLimit"
                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 20;"/>
        <Button text="📦 Importer TOUS" onAction="#importAllExercises"
                style="-fx-background-color: #8B5CF6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 20;"/>
        <Button text="❌ Fermer" onAction="#closeWindow"
                style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 20;"/>
    </HBox>
</VBox>