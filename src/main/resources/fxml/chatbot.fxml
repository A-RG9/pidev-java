<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wellora.javafx.controller.ChatBotController"
      fx:id="rootPane"
      style="-fx-background-color: #f9fafb;">

    <!-- LEFT SIDEBAR - Included from sidebar.fxml -->
    <fx:include source="sidebar.fxml" />

    <!-- RIGHT SIDE - Chat Interface -->
    <VBox spacing="0" style="-fx-padding: 32 48 48 48; -fx-background-color: #f9fafb;">
        
    <!-- Header -->
    <HBox spacing="0" style="-fx-padding: 0 0 24 0;" alignment="CENTER_LEFT">
        <VBox spacing="8">
            <Label text="Assistant Pre-Consultation WellCare"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
            <Label text="Analyse des symptômes, classement de gravité, et conseils simples en attendant."
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
        </VBox>
        <Button text="Réinitialiser"
                onAction="#handleReset"
                style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-padding: 8 16; -fx-background-radius: 20px; -fx-border-color: #e5e7eb; -fx-border-width: 1px;"/>
    </HBox>

        <!-- Chat Messages Container -->
        <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 1px; -fx-background-radius: 12px;">
            <VBox fx:id="messagesContainer" spacing="12" style="-fx-padding: 20;">
                <!-- Messages will be added here dynamically -->
            </VBox>
        </ScrollPane>

        <!-- Quick Suggestions -->
        <VBox spacing="8" style="-fx-padding: 16 0 0 0;">
            <Label text="Questions fréquentes :"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <HBox spacing="8">
                <Button text="J'ai mal à la poitrine"
                        onAction="#handleSuggestionClick"
                        style="-fx-background-color: white; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 8 16; -fx-background-radius: 20px; -fx-border-color: #e5e7eb; -fx-border-width: 1px;"/>
                <Button text="Je tousse depuis une semaine"
                        onAction="#handleSuggestionClick"
                        style="-fx-background-color: white; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 8 16; -fx-background-radius: 20px; -fx-border-color: #e5e7eb; -fx-border-width: 1px;"/>
                <Button text="J'ai de la fièvre"
                        onAction="#handleSuggestionClick"
                        style="-fx-background-color: white; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 8 16; -fx-background-radius: 20px; -fx-border-color: #e5e7eb; -fx-border-width: 1px;"/>
                <Button text="Je suis très fatigué"
                        onAction="#handleSuggestionClick"
                        style="-fx-background-color: white; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-padding: 8 16; -fx-background-radius: 20px; -fx-border-color: #e5e7eb; -fx-border-width: 1px;"/>
            </HBox>
        </VBox>

        <!-- Input Area -->
        <HBox spacing="12" style="-fx-padding: 16 0 0 0; -fx-alignment: CENTER_LEFT;">
            <TextField fx:id="userInput" promptText="Décrivez vos symptômes..."
                       onKeyPressed="#handleKeyPress"
                       style="-fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 24px; -fx-border-color: #e5e7eb; -fx-border-width: 1px;"
                       HBox.hgrow="ALWAYS"/>
            <Button fx:id="sendButton" text="Envoyer"
                    onAction="#handleSendMessage"
                    style="-fx-background-color: #00A790; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 24px;"/>
        </HBox>

        <!-- Warning Notice -->
        <Label text="⚠️ Information importante : Cet assistant aide à l'orientation, pas au diagnostic. En cas d'urgence vitale, appelez le 15 (SAMU)."
               style="-fx-font-size: 12px; -fx-text-fill: #dc2626; -fx-padding: 12 0 0 0; -fx-wrap-text: true;"
               maxWidth="600"/>
    </VBox>
</HBox>
