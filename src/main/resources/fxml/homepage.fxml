<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<!-- Note: This is the CONTENT for homepage, loaded inside main.fxml -->
<!-- Do NOT include top bar or sidebar - those are in main.fxml -->
<VBox xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wellora.javafx.controller.HomepageController"
      styleClass="main-content" 
      spacing="25"
      prefWidth="800"
      prefHeight="700">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>
    
    <!-- Welcome Section -->
    <VBox spacing="5">
        <Label text="Welcome back 👋" styleClass="welcome-title"/>
        <Label text="Here's your health overview for today" styleClass="welcome-subtitle"/>
    </VBox>
    
    <!-- Stat Cards Grid -->
    <GridPane hgap="20" vgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>

        <!-- Card 1: Total Journals -->
        <VBox styleClass="stat-card" GridPane.columnIndex="0">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="📒" styleClass="stat-icon"/>
                <VBox spacing="2">
                    <Label text="Total Journals" styleClass="stat-label"/>
                    <Label text="0" styleClass="stat-value" fx:id="statJournals"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Card 2: Total Entries -->
        <VBox styleClass="stat-card" GridPane.columnIndex="1">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="📝" styleClass="stat-icon"/>
                <VBox spacing="2">
                    <Label text="Total Entries" styleClass="stat-label"/>
                    <Label text="0" styleClass="stat-value" fx:id="statEntries"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Card 3: Average Sleep -->
        <VBox styleClass="stat-card" GridPane.columnIndex="2">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="😴" styleClass="stat-icon"/>
                <VBox spacing="2">
                    <Label text="Avg Sleep" styleClass="stat-label"/>
                    <Label text="--" styleClass="stat-value" fx:id="statSleep"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Card 4: Average Weight -->
        <VBox styleClass="stat-card" GridPane.columnIndex="3">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="⚖️" styleClass="stat-icon"/>
                <VBox spacing="2">
                    <Label text="Avg Weight" styleClass="stat-label"/>
                    <Label text="--" styleClass="stat-value" fx:id="statWeight"/>
                </VBox>
            </HBox>
        </VBox>
    </GridPane>

    <!-- Quick Actions -->
    <VBox spacing="15">
        <Label text="Quick Actions" styleClass="section-title"/>
        <HBox spacing="15">
            <Button text="➕ Add Journal" styleClass="action-button" onAction="#addJournal"/>
            <Button text="➕ Add Entry" styleClass="action-button" onAction="#addEntry"/>
            <Button text="➕ Add Symptom" styleClass="action-button" onAction="#addSymptom"/>
        </HBox>
    </VBox>

    <!-- Chart Placeholder -->
    <VBox styleClass="chart-container" VBox.vgrow="ALWAYS">
        <Label text="Health Trends" styleClass="chart-title"/>
        <Region VBox.vgrow="ALWAYS"/>
        <VBox alignment="CENTER" styleClass="chart-placeholder">
            <Label text="📈" styleClass="placeholder-icon"/>
            <Label text="Chart will appear here" styleClass="placeholder-text"/>
        </VBox>
    </VBox>

</VBox>