<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellcare.javafx.controller.admin.VerificationQueueController">
    <children>
        <!-- Header -->
        <HBox styleClass="header-section" VBox.vgrow="NEVER">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label styleClass="page-title" text="✅ Verification Queue" />
                        <Label styleClass="page-subtitle" text="Review and approve healthcare professional applications" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="refreshBtn" styleClass="btn, btn-outline" text="🔄 Refresh" />
            </children>
            <VBox.margin>
                <Insets bottom="20.0" />
            </VBox.margin>
        </HBox>

        <!-- Statistics Overview -->
        <HBox spacing="20.0" VBox.vgrow="NEVER">
            <children>
                <VBox styleClass="stat-card, stat-card-warning" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="stat-number" fx:id="pendingCountLabel" text="0" />
                        <Label styleClass="stat-label" text="Pending Review" />
                    </children>
                </VBox>
                <VBox styleClass="stat-card, stat-card-success" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="stat-number" fx:id="approvedTodayLabel" text="0" />
                        <Label styleClass="stat-label" text="Approved Today" />
                    </children>
                </VBox>
                <VBox styleClass="stat-card, stat-card-danger" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="stat-number" fx:id="rejectedTodayLabel" text="0" />
                        <Label styleClass="stat-label" text="Rejected Today" />
                    </children>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="stat-number" fx:id="avgReviewTimeLabel" text="0h" />
                        <Label styleClass="stat-label" text="Avg. Review Time" />
                    </children>
                </VBox>
            </children>
            <VBox.margin>
                <Insets bottom="20.0" />
            </VBox.margin>
        </HBox>

        <!-- Quick Filters -->
        <HBox spacing="15.0" VBox.vgrow="NEVER">
            <children>
                <Label text="Quick Filters:" styleClass="filter-label" />
                <ToggleButton fx:id="allBtn" styleClass="toggle-btn" text="All" selected="true" />
                <ToggleButton fx:id="doctorsBtn" styleClass="toggle-btn" text="Doctors" />
                <ToggleButton fx:id="coachesBtn" styleClass="toggle-btn" text="Coaches" />
                <ToggleButton fx:id="nutritionistsBtn" styleClass="toggle-btn" text="Nutritionists" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" promptText="Search by name or email..." prefWidth="250.0" />
            </children>
            <VBox.margin>
                <Insets bottom="15.0" />
            </VBox.margin>
        </HBox>

        <!-- Main Content Split -->
        <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.6">
            <!-- Left: Applications List -->
            <VBox spacing="10.0">
                <children>
                    <Label text="Pending Applications" styleClass="section-title" />
                    <ListView fx:id="applicationsList" VBox.vgrow="ALWAYS">
                        <VBox.margin>
                            <Insets bottom="10.0" />
                        </VBox.margin>
                    </ListView>
                </children>
            </VBox>

            <!-- Right: Application Details -->
            <VBox spacing="10.0">
                <children>
                    <Label text="Application Details" styleClass="section-title" />

                    <!-- Professional Info Card -->
                    <VBox styleClass="detail-card" fx:id="detailsCard" visible="false">
                        <children>
                            <HBox spacing="15.0" VBox.vgrow="NEVER">
                                <children>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label fx:id="detailNameLabel" styleClass="detail-name" text="Professional Name" />
                                            <Label fx:id="detailRoleLabel" styleClass="detail-role" text="Role - Specialty" />
                                            <Label fx:id="detailEmailLabel" styleClass="detail-email" text="email@example.com" />
                                        </children>
                                    </VBox>
                                    <VBox spacing="10.0" alignment="TOP_RIGHT">
                                        <children>
                                            <Label fx:id="detailStatusLabel" styleClass="status-badge, status-pending" text="⏳ PENDING" />
                                            <Label fx:id="detailDateLabel" styleClass="detail-date" text="Applied: YYYY-MM-DD" />
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>

                            <!-- Professional Details Grid -->
                            <GridPane styleClass="details-grid" hgap="15.0" vgap="10.0" VBox.vgrow="NEVER">
                                <columnConstraints>
                                    <ColumnConstraints prefWidth="120.0" />
                                    <ColumnConstraints prefWidth="200.0" />
                                    <ColumnConstraints prefWidth="120.0" />
                                    <ColumnConstraints prefWidth="200.0" />
                                </columnConstraints>
                                <children>
                                    <Label text="License Number:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <Label fx:id="detailLicenseLabel" styleClass="field-value" text="XXXX-XXXX" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label text="Experience:" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <Label fx:id="detailExperienceLabel" styleClass="field-value" text="X years" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                    <Label text="Phone:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <Label fx:id="detailPhoneLabel" styleClass="field-value" text="+XXX-XX-XXX-XXXX" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                    <Label text="Location:" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                    <Label fx:id="detailLocationLabel" styleClass="field-value" text="City, Country" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                </children>
                                <VBox.margin>
                                    <Insets top="15.0" bottom="15.0" />
                                </VBox.margin>
                            </GridPane>

                            <!-- Documents Section -->
                            <VBox spacing="10.0" VBox.vgrow="NEVER">
                                <children>
                                    <Label text="📄 Submitted Documents" styleClass="section-subtitle" />
                                    <HBox spacing="10.0">
                                        <children>
                                            <Button fx:id="viewDiplomaBtn" styleClass="btn, btn-outline, btn-small" text="📜 View Diploma" />
                                            <Button fx:id="viewLicenseBtn" styleClass="btn, btn-outline, btn-small" text="📋 View License" />
                                            <Button fx:id="viewCertificationsBtn" styleClass="btn, btn-outline, btn-small" text="🏆 View Certifications" disable="true" />
                                        </children>
                                    </HBox>
                                </children>
                                <VBox.margin>
                                    <Insets bottom="15.0" />
                                </VBox.margin>
                            </VBox>

                            <!-- Review Notes -->
                            <VBox spacing="5.0" VBox.vgrow="NEVER">
                                <children>
                                    <Label text="📝 Review Notes" styleClass="section-subtitle" />
                                    <TextArea fx:id="reviewNotesArea" promptText="Add internal review notes..." prefRowCount="3" wrapText="true" />
                                </children>
                                <VBox.margin>
                                    <Insets bottom="15.0" />
                                </VBox.margin>
                            </VBox>

                            <!-- Action Buttons -->
                            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                                <children>
                                    <Button fx:id="rejectBtn" styleClass="btn, btn-danger" text="❌ Reject Application" />
                                    <Button fx:id="approveBtn" styleClass="btn, btn-success" text="✅ Approve Application" />
                                </children>
                            </HBox>
                        </children>
                        <VBox.margin>
                            <Insets bottom="10.0" />
                        </VBox.margin>
                    </VBox>

                    <!-- Empty State -->
                    <VBox styleClass="empty-state" fx:id="emptyStateCard" alignment="CENTER" spacing="15.0" VBox.vgrow="ALWAYS">
                        <children>
                            <Label styleClass="empty-icon" text="📋" />
                            <Label styleClass="empty-title" text="No Application Selected" />
                            <Label styleClass="empty-subtitle" text="Select an application from the list to review its details" />
                        </children>
                    </VBox>
                </children>
            </VBox>
        </SplitPane>

        <!-- Bottom Actions -->
        <HBox spacing="10.0" alignment="CENTER_RIGHT" VBox.vgrow="NEVER">
            <children>
                <Button fx:id="bulkApproveBtn" styleClass="btn, btn-outline" text="✅ Bulk Approve" disable="true" />
                <Button fx:id="backToDashboardBtn" styleClass="btn, btn-secondary" text="⬅️ Back to Dashboard" />
            </children>
            <VBox.margin>
                <Insets top="15.0" />
            </VBox.margin>
        </HBox>
    </children>
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>
</VBox>