<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellcare.javafx.controller.admin.UserManagementController">
    <children>
        <!-- Header -->
        <HBox styleClass="navbar" VBox.vgrow="NEVER">
            <children>
                <Label styleClass="navbar-brand" text="🏥 WellCare" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="15.0" alignment="CENTER_RIGHT">
                    <children>
                        <Button styleClass="btn-notification" text="🔔" />
                        <MenuButton fx:id="userMenu" styleClass="user-menu">
                            <items>
                                <MenuItem fx:id="profileMenuItem" text="👤 Profile" />
                                <MenuItem fx:id="settingsMenuItem" text="⚙️ Settings" />
                                <SeparatorMenuItem />
                                <MenuItem fx:id="logoutMenuItem" text="🚪 Logout" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>
            </children>
            <VBox.margin>
                <Insets bottom="0.0" />
            </VBox.margin>
        </HBox>

        <!-- Main Content -->
        <VBox HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" spacing="20.0">
            <VBox.margin>
                <Insets top="30.0" right="30.0" bottom="30.0" left="30.0" />
            </VBox.margin>
            <children>
                <!-- Page Header -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox spacing="10.0">
                            <children>
                                <Label styleClass="page-title" text="👥 User Management" />
                                <Label styleClass="page-subtitle" text="Manage system users, roles, and permissions" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button styleClass="btn, btn-primary" text="➕ Add New User" />
                    </children>
                </HBox>

                <!-- Filters and Search -->
                <HBox styleClass="card" alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <TextField fx:id="searchField" styleClass="form-control" promptText="Search users..." HBox.hgrow="ALWAYS" />

                        <ComboBox fx:id="roleFilter" styleClass="form-control" promptText="Filter by Role">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="All Roles" />
                                    <String fx:value="Patient" />
                                    <String fx:value="Doctor" />
                                    <String fx:value="Nurse" />
                                    <String fx:value="Admin" />
                                </FXCollections>
                            </items>
                        </ComboBox>

                        <ComboBox fx:id="statusFilter" styleClass="form-control" promptText="Filter by Status">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="All Statuses" />
                                    <String fx:value="Active" />
                                    <String fx:value="Inactive" />
                                    <String fx:value="Pending" />
                                    <String fx:value="Suspended" />
                                </FXCollections>
                            </items>
                        </ComboBox>

                        <Button styleClass="btn, btn-secondary" text="🔄 Reset Filters" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="0.0" />
                    </VBox.margin>
                </HBox>

                <!-- Users Table -->
                <VBox styleClass="card" spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Table Header -->
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label styleClass="card-title" text="Users" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="userCountLabel" styleClass="table-info" text="Showing 1-10 of 1,247 users" />
                            </children>
                        </HBox>

                        <!-- TableView -->
                        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="idColumn" text="ID" prefWidth="80" />
                                <TableColumn fx:id="nameColumn" text="Name" prefWidth="150" />
                                <TableColumn fx:id="emailColumn" text="Email" prefWidth="200" />
                                <TableColumn fx:id="roleColumn" text="Role" prefWidth="100" />
                                <TableColumn fx:id="statusColumn" text="Status" prefWidth="100" />
                                <TableColumn fx:id="lastLoginColumn" text="Last Login" prefWidth="120" />
                                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="150" />
                            </columns>
                        </TableView>

                        <!-- Pagination -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Button styleClass="btn-pagination" text="« Previous" />
                                <Label text="Page 1 of 125" styleClass="pagination-info" />
                                <Button styleClass="btn-pagination" text="Next »" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="Show:" />
                                <ComboBox styleClass="form-control-small" prefWidth="80">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="10" />
                                            <String fx:value="25" />
                                            <String fx:value="50" />
                                            <String fx:value="100" />
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                                <Label text="per page" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Bulk Actions -->
                <HBox styleClass="card" alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <CheckBox fx:id="selectAllCheckbox" text="Select All" />

                        <Label text="Bulk Actions:" styleClass="bulk-action-label" />

                        <Button styleClass="btn, btn-success" text="✅ Activate Selected" />
                        <Button styleClass="btn, btn-warning" text="🚫 Deactivate Selected" />
                        <Button styleClass="btn, btn-danger" text="🗑️ Delete Selected" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button styleClass="btn, btn-info" text="📊 Export to CSV" />
                    </children>
                    <VBox.margin>
                        <Insets top="0.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>