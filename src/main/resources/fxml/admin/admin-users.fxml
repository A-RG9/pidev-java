<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellcare.javafx.controller.admin.UserManagementController">
    <children>
        <!-- Header -->
        <HBox styleClass="navbar" VBox.vgrow="NEVER">
            <children>
                <Label styleClass="navbar-brand" text="🏥 WellCare Admin - Users" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="15.0" alignment="CENTER_RIGHT">
                    <children>
                        <Button styleClass="btn-notification" text="🔔" />
                        <MenuButton fx:id="userMenu" styleClass="user-menu">
                            <items>
                                <MenuItem fx:id="profileMenuItem" text="👤 Profile" />
                                <MenuItem fx:id="settingsMenuItem" text="⚙️ Settings" />
                                <SeparatorMenuItem />
                                <MenuItem fx:id="logoutMenuItem" text="🚪 Logout" />
                                <SeparatorMenuItem />
                                <MenuItem fx:id="backToDashboardMenuItem" text="⬅️ Back to Dashboard" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Main Content -->
        <VBox spacing="20.0" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="30.0" right="30.0" bottom="30.0" left="30.0" />
            </VBox.margin>
            <children>
                <!-- Page Title and Actions -->
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label styleClass="page-title" text="User Management" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="10.0">
                            <children>
                                <TextField fx:id="searchField" promptText="Search users..." styleClass="search-field" prefWidth="250.0" />
                                <ComboBox fx:id="roleFilterComboBox" promptText="Filter by role" prefWidth="150.0" />
                                <ComboBox fx:id="statusFilterComboBox" promptText="Filter by status" prefWidth="150.0" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- Bulk Actions -->
                <HBox styleClass="card" alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label styleClass="card-title" text="Bulk Actions:" />
                        <Button fx:id="activateSelectedBtn" styleClass="btn, btn-success" text="✅ Activate Selected" disable="true" />
                        <Button fx:id="deactivateSelectedBtn" styleClass="btn, btn-warning" text="⏸️ Deactivate Selected" disable="true" />
                        <Button fx:id="deleteSelectedBtn" styleClass="btn, btn-danger" text="🗑️ Delete Selected" disable="true" />
                        <Button fx:id="verifySelectedBtn" styleClass="btn, btn-info" text="🔍 Verify Selected" disable="true" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="selectionCountLabel" text="0 users selected" />
                    </children>
                </HBox>

                <!-- Users Table -->
                <VBox styleClass="card" spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="selectColumn" text="" maxWidth="50.0" minWidth="50.0" />

                                <TableColumn fx:id="idColumn" text="ID" prefWidth="80.0" />

                                <TableColumn fx:id="nameColumn" text="Name" prefWidth="150.0" />

                                <TableColumn fx:id="emailColumn" text="Email" prefWidth="200.0" />
                                <TableColumn fx:id="roleColumn" text="Role" prefWidth="120.0" />
                                <TableColumn fx:id="statusColumn" text="Status" prefWidth="120.0" />
                                <TableColumn fx:id="specialtyColumn" text="Specialty/License" prefWidth="150.0" />
                                <TableColumn fx:id="registeredColumn" text="Registered" prefWidth="120.0" />

                                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="150.0" />
                            </columns>

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- Table Footer -->
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <Label text="Showing" />
                                <ComboBox fx:id="pageSizeComboBox" prefWidth="80.0" />
                                <Label text="entries per page" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="paginationInfoLabel" text="Showing 1 to 10 of 247 entries" />
                                <HBox spacing="5.0">
                                    <children>
                                        <Button fx:id="firstPageBtn" text="⏮️ First" />
                                        <Button fx:id="prevPageBtn" text="⬅️ Previous" />
                                        <TextField fx:id="pageNumberField" text="1" prefWidth="60.0" />
                                        <Label text="of" />
                                        <Label fx:id="totalPagesLabel" text="25" />
                                        <Button fx:id="nextPageBtn" text="➡️ Next" />
                                        <Button fx:id="lastPageBtn" text="⏭️ Last" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- User Details Panel (shown when user is selected) -->
                <VBox fx:id="userDetailsPanel" styleClass="card" spacing="15.0" visible="false" managed="false">
                    <children>
                        <Label styleClass="card-title" text="User Details" />
                        <GridPane hgap="15.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                                <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>

                            <!-- Row 1 -->
                            <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                            <Label fx:id="detailFullNameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                            <Label text="Email:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                            <Label fx:id="detailEmailLabel" GridPane.rowIndex="0" GridPane.columnIndex="3" />

                            <!-- Row 2 -->
                            <Label text="Role:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                            <Label fx:id="detailRoleLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                            <Label text="Status:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                            <Label fx:id="detailStatusLabel" GridPane.rowIndex="1" GridPane.columnIndex="3" />

                            <!-- Row 3 -->
                            <Label text="Phone:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                            <Label fx:id="detailPhoneLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                            <Label text="Birth Date:" GridPane.rowIndex="2" GridPane.columnIndex="2" />
                            <Label fx:id="detailBirthDateLabel" GridPane.rowIndex="2" GridPane.columnIndex="3" />

                            <!-- Row 4 -->
                            <Label text="License:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                            <Label fx:id="detailLicenseLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                            <Label text="Specialty:" GridPane.rowIndex="3" GridPane.columnIndex="2" />
                            <Label fx:id="detailSpecialtyLabel" GridPane.rowIndex="3" GridPane.columnIndex="3" />

                            <!-- Row 5 -->
                            <Label text="Experience:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                            <Label fx:id="detailExperienceLabel" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                            <Label text="Registration Date:" GridPane.rowIndex="4" GridPane.columnIndex="2" />
                            <Label fx:id="detailRegistrationDateLabel" GridPane.rowIndex="4" GridPane.columnIndex="3" />
                        </GridPane>

                        <!-- Action Buttons -->
                        <HBox spacing="10.0">
                            <children>
                                <Button fx:id="viewDiplomaBtn" styleClass="btn, btn-info" text="📄 View Diploma" visible="false" managed="false" />
                                <Button fx:id="editUserBtn" styleClass="btn, btn-primary" text="✏️ Edit User" />
                                <Button fx:id="resetPasswordBtn" styleClass="btn, btn-warning" text="🔑 Reset Password" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="closeDetailsBtn" styleClass="btn, btn-secondary" text="❌ Close Details" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>

    <!-- Action Button Cell Factory (defined but not used directly in FXML) -->
    <fx:define>
        <TableColumn fx:id="actionButtonCellFactory" />
    </fx:define>
</VBox>