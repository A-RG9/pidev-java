<?xml version="1.0" encoding="UTF-8"?>

<?import com.sothawo.mapjfx.MapView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane prefHeight="850.0" prefWidth="1400.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellora.javafx.controller.AjouterParcoursDeSante">

    <left>
        <VBox prefWidth="280.0" style="-fx-background-color: #ffffff; -fx-border-color: #eaeff2; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <padding>
                    <Insets bottom="20.0" left="25.0" right="20.0" top="25.0" />
                </padding>
                <children>
                    <Label alignment="CENTER" prefHeight="35.0" prefWidth="35.0" style="-fx-background-color: #00d09c; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 16;" text="♡" />
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #0a1b2a; -fx-font-size: 20px;" text="WellCare" />
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #f8f9fc; -fx-background-radius: 10;">
                <VBox.margin>
                    <Insets bottom="15.0" left="15.0" right="15.0" />
                </VBox.margin>
                <padding>
                    <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                </padding>
                <children>
                    <Label alignment="CENTER" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #00d09c; -fx-text-fill: white; -fx-background-radius: 50; -fx-font-weight: bold; -fx-font-size: 14px;" text="ar" />
                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <children>
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #1a2b3c; -fx-font-size: 13px;" text="ahmed regaieg" />
                            <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="regaieg.ahmed2003@gmail.c..." />
                        </children>
                    </VBox>
                </children>
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: white; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="5.0">
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 20 12 25; -fx-cursor: hand;">
                            <Label prefWidth="35.0" style="-fx-font-size: 16; -fx-text-fill: #555;" text="📅" />
                            <Label style="-fx-font-size: 14; -fx-text-fill: #34495e;" text="Rendez-vous" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label style="-fx-text-fill: #bdc3c7;" text="˅" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 20 12 25; -fx-cursor: hand;">
                            <Label prefWidth="35.0" style="-fx-font-size: 16; -fx-text-fill: #555;" text="♡" />
                            <Label style="-fx-font-size: 14; -fx-text-fill: #34495e;" text="Santé" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label style="-fx-text-fill: #bdc3c7;" text="˅" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 20 12 25; -fx-cursor: hand;">
                            <Label prefWidth="35.0" style="-fx-font-size: 16; -fx-text-fill: #555;" text="📖" />
                            <Label style="-fx-font-size: 14; -fx-text-fill: #34495e;" text="Nutrition" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label style="-fx-text-fill: #bdc3c7;" text="˅" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 20 12 25; -fx-cursor: hand;">
                            <Label prefWidth="35.0" style="-fx-font-size: 16; -fx-text-fill: #555;" text="♥" />
                            <Label style="-fx-font-size: 14; -fx-text-fill: #34495e;" text="Fitness" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label style="-fx-text-fill: #bdc3c7;" text="˅" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #e8f8f5; -fx-padding: 12 20 12 15; -fx-background-radius: 8; -fx-cursor: hand;">
                            <VBox.margin>
                                <Insets bottom="15.0" left="10.0" right="10.0" top="5.0" />
                            </VBox.margin>
                            <children>
                                <Label prefWidth="35.0" style="-fx-font-size: 16; -fx-text-fill: #4e6a7c;" text=" 🌍" />
                                <Label style="-fx-font-size: 14; -fx-text-fill: #4e6a7c; -fx-font-weight: bold;" text="Health Trail" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-text-fill: #bdc3c7;" text="˅" />
                            </children>
                        </HBox>

                    </VBox>
                </content>
            </ScrollPane>

            <VBox spacing="10.0" style="-fx-padding: 15 20 20 25;">
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #34495e; -fx-font-size: 14; -fx-padding: 5 0 5 0;" text="«    Réduire" />
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #34495e; -fx-font-size: 14; -fx-padding: 5 0 5 0;" text="👤   Mon Profil" />
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 5 0 5 0;" text="🚪   Déconnexion" />
            </VBox>
        </VBox>
    </left>

    <center>
        <AnchorPane style="-fx-background-color: #f4f7f6;">
            <children>
                <ScrollPane fitToWidth="true" layoutX="50.0" layoutY="20.0" style="-fx-background-color: transparent; -fx-background: #f4f7f6;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="20.0">
                    <content>
                        <VBox spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                            <padding>
                                <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
                            </padding>
                            <children>
                                <VBox spacing="5">
                                    <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1e272e;" text="Create New Health Trail" />
                                    <Label style="-fx-text-fill: #95a5a6; -fx-font-size: 14;" text="Fill in the details below to publish a new trail for the community." />
                                    <Separator opacity="0.3">
                                        <VBox.margin><Insets top="10" /></VBox.margin>
                                    </Separator>
                                </VBox>

                                <VBox spacing="10">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 14;" text="Parcours Name" />
                                    <TextField fx:id="nomField" prefHeight="45.0" promptText="Enter a descriptive name..."
                                               style="-fx-background-color: #f8f9fa; -fx-border-color: #eef2f5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 15;" />
                                </VBox>

                                <VBox spacing="10">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 14;" text="Pick Location On Map" />
                                    <VBox style="-fx-border-color: #eef2f5; -fx-border-radius: 12; -fx-background-radius: 12; -fx-overflow: hidden; -fx-background-color: #f8f9fa; -fx-padding: 5;">
                                        <children>
                                            <MapView fx:id="mapView" prefHeight="300.0" style="-fx-background-radius: 10;" />
                                        </children>
                                    </VBox>
                                </VBox>

                                <VBox spacing="10">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 14;" text="Address details" />
                                    <TextField fx:id="locationField" editable="false" prefHeight="45.0" promptText="Click on the map to automatically get the address"
                                               style="-fx-background-color: #f1f2f6; -fx-border-color: #eef2f5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #7f8c8d;" />
                                </VBox>

                                <HBox spacing="20.0">
                                    <children>
                                        <VBox HBox.hgrow="ALWAYS" spacing="8">
                                            <children>
                                                <Label style="-fx-text-fill: #636e72; -fx-font-size: 12; -fx-font-weight: bold;" text="LATITUDE" />
                                                <TextField fx:id="latField" editable="false" prefHeight="40.0" style="-fx-background-color: #f1f2f6; -fx-background-radius: 8; -fx-border-color: #eef2f5; -fx-border-radius: 8;" />
                                            </children>
                                        </VBox>
                                        <VBox HBox.hgrow="ALWAYS" spacing="8">
                                            <children>
                                                <Label style="-fx-text-fill: #636e72; -fx-font-size: 12; -fx-font-weight: bold;" text="LONGITUDE" />
                                                <TextField fx:id="longField" editable="false" prefHeight="40.0" style="-fx-background-color: #f1f2f6; -fx-background-radius: 8; -fx-border-color: #eef2f5; -fx-border-radius: 8;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox spacing="20.0">
                                    <children>
                                        <VBox HBox.hgrow="ALWAYS" spacing="10">
                                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" text="Distance (km)" />
                                            <TextField fx:id="distanceField" prefHeight="45.0" promptText="e.g. 5.5"
                                                       style="-fx-background-color: #f8f9fa; -fx-border-color: #eef2f5; -fx-border-radius: 8; -fx-background-radius: 8;" />
                                        </VBox>
                                        <VBox HBox.hgrow="ALWAYS" spacing="10">
                                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" text="Creation Date" />
                                            <DatePicker fx:id="datePicker" maxWidth="Infinity" prefHeight="45.0"
                                                        style="-fx-background-color: #f8f9fa; -fx-border-color: #eef2f5;" />
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox spacing="10">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" text="Parcours Image" />
                                    <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-border-color: #eef2f5; -fx-border-radius: 8; -fx-background-color: #f8f9fa; -fx-background-radius: 8;">
                                        <children>
                                            <Button fx:id="btnChooseFile" mnemonicParsing="false" prefHeight="50.0" style="-fx-background-color: #2d3436; -fx-text-fill: white; -fx-background-radius: 8 0 0 8; -fx-cursor: hand; -fx-padding: 0 20;" text="Upload Image" />
                                            <Label fx:id="fileLabel" text="No file selected" textFill="#95a5a6">
                                                <padding><Insets left="15.0" /></padding>
                                            </Label>
                                        </children>
                                    </HBox>
                                </VBox>

                                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                                    <children>
                                        <Button fx:id="btnCancel" prefHeight="45.0" prefWidth="120.0"
                                                style="-fx-background-color: transparent; -fx-border-color: #d63031; -fx-border-radius: 8; -fx-text-fill: #d63031; -fx-cursor: hand; -fx-font-weight: bold;" text="Cancel" />
                                        <Button fx:id="btnSave" prefHeight="45.0" prefWidth="150.0"
                                                style="-fx-background-color: #00a693; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,166,147,0.2), 10, 0, 0, 5);" text="Publish Trail" />
                                    </children>
                                    <padding><Insets top="20.0" /></padding>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </AnchorPane>
    </center>

</BorderPane>