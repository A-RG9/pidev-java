<?xml version="1.0" encoding="UTF-8"?>

<?import com.sothawo.mapjfx.MapView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Content-only view for ModifierParcoursDeSante - loaded inside HealthShell -->
<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellora.javafx.controller.ModifierParcoursDeSanteController"
      styleClass="main-content" spacing="25" prefWidth="1200">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
    </padding>
    <children>
        <VBox spacing="5">
            <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #00a693;" text="Update Health Trail" />
            <Label style="-fx-text-fill: #95a5a6; -fx-font-size: 14;" text="Modify the information below to keep the trail details accurate." />
            <Separator opacity="0.3">
                <VBox.margin><Insets top="10" /></VBox.margin>
            </Separator>
        </VBox>

        <VBox spacing="8">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 14;" text="Parcours Name" />
            <TextField fx:id="nomField" prefHeight="45.0" promptText="Trail name..."
                       style="-fx-background-color: #f8f9fa; -fx-border-color: #eef2f5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 15;" />
        </VBox>

        <VBox spacing="8">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 14;" text="Adjust Location" />
            <VBox style="-fx-border-color: #eef2f5; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 5; -fx-background-color: #f8f9fa;">
                <children>
                    <MapView fx:id="mapView" prefHeight="300.0" />
                </children>
            </VBox>
            <Label style="-fx-text-fill: #95a5a6; -fx-font-size: 11;" text="Tip: Click the map to update coordinates and address." />
        </VBox>

        <VBox spacing="8">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 14;" text="Location Address" />
            <TextField fx:id="locationField" prefHeight="45.0"
                       style="-fx-background-color: #f8f9fa; -fx-border-color: #eef2f5; -fx-border-radius: 8; -fx-background-radius: 8;" />
        </VBox>

        <HBox spacing="20.0">
            <children>
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #b2bec3; -fx-font-size: 11;" text="LATITUDE" />
                    <TextField fx:id="latField" prefHeight="40.0"
                               style="-fx-background-color: #f1f2f6; -fx-border-color: #eef2f5; -fx-border-radius: 8; -fx-background-radius: 8;" />
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #b2bec3; -fx-font-size: 11;" text="LONGITUDE" />
                    <TextField fx:id="longField" prefHeight="40.0"
                               style="-fx-background-color: #f1f2f6; -fx-border-color: #eef2f5; -fx-border-radius: 8; -fx-background-radius: 8;" />
                </VBox>
            </children>
        </HBox>

        <HBox spacing="20.0">
            <children>
                <VBox HBox.hgrow="ALWAYS" spacing="8">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" text="Distance (km)" />
                    <TextField fx:id="distanceField" prefHeight="45.0"
                               style="-fx-background-color: #f8f9fa; -fx-border-color: #eef2f5; -fx-border-radius: 8; -fx-background-radius: 8;" />
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="8">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" text="Creation Date" />
                    <DatePicker fx:id="datePicker" maxWidth="Infinity" prefHeight="45.0"
                                style="-fx-background-color: #f8f9fa; -fx-border-color: #eef2f5;" />
                </VBox>
            </children>
        </HBox>

        <VBox spacing="8">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" text="Update Image" />
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-border-color: #eef2f5; -fx-border-radius: 8; -fx-background-color: #f8f9fa; -fx-background-radius: 8;">
                <children>
                    <Button fx:id="btnChooseFile" mnemonicParsing="false" prefHeight="50.0"
                            style="-fx-background-color: #2d3436; -fx-text-fill: white; -fx-background-radius: 8 0 0 8; -fx-cursor: hand; -fx-padding: 0 20;" text="Choose New File" />
                    <Label fx:id="fileLabel" text="No new file selected" textFill="#95a5a6">
                        <padding><Insets left="15.0" /></padding>
                    </Label>
                </children>
            </HBox>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button fx:id="btnCancel" prefHeight="45.0" prefWidth="120.0"
                        style="-fx-background-color: transparent; -fx-border-color: #d63031; -fx-border-radius: 8; -fx-text-fill: #d63031; -fx-cursor: hand;" text="Cancel" />
                <Button fx:id="btnSave" prefHeight="45.0" prefWidth="150.0"
                        style="-fx-background-color: #00a693; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,166,147,0.2), 10, 0, 0, 5);" text="Update Changes" />
            </children>
            <padding><Insets top="10.0" /></padding>
        </HBox>
    </children>
</VBox>