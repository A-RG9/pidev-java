<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wellora.javafx.controller.HealthjournalController"
      spacing="15"
      styleClass="root"
       prefWidth="1100"
       prefHeight="750">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <!-- Header -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="📒 Gestion des Journaux de Santé" styleClass="header-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Nouveau Journal" styleClass="button, button-success" 
                prefWidth="160" onAction="#clearForm"/>
    </HBox>
    
    <!-- Summary Cards -->
    <HBox spacing="20" alignment="CENTER">
        <!-- Total Journals Card -->
        <VBox spacing="10" styleClass="stat-card" alignment="CENTER" prefWidth="200">
            <Label text="📒" styleClass="stat-icon"/>
            <Label text="Total Journals" styleClass="stat-label"/>
            <Label fx:id="totalJournalsLabel" text="0" styleClass="stat-value"/>
        </VBox>

        <!-- Active Journals Card -->
        <VBox spacing="10" styleClass="stat-card" alignment="CENTER" prefWidth="200">
            <Label text="✅" styleClass="stat-icon"/>
            <Label text="Active Journals" styleClass="stat-label"/>
            <Label fx:id="activeJournalsLabel" text="0" styleClass="stat-value"/>
        </VBox>

        <!-- Total Entries Card -->
        <VBox spacing="10" styleClass="stat-card" alignment="CENTER" prefWidth="200">
            <Label text="📝" styleClass="stat-icon"/>
            <Label text="Total Entries" styleClass="stat-label"/>
            <Label fx:id="totalJournalEntriesLabel" text="0" styleClass="stat-value"/>
        </VBox>
    </HBox>

    <!-- Main Content -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        
        <!-- Left: Table View -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label text="Liste des Journaux" styleClass="section-label"/>
            
            <!-- Search Bar -->
            <HBox spacing="10">
                <TextField fx:id="searchField" promptText="Rechercher..." 
                         prefWidth="200" styleClass="text-field"/>
                <Button text="🔍" styleClass="button, button-primary" onAction="#search"/>
                <Button text="📋" styleClass="button, button-secondary" onAction="#refresh"/>
            </HBox>
            
            <!-- Table -->
            <TableView fx:id="tableView" styleClass="table-view" 
                      VBox.vgrow="ALWAYS" onMouseClicked="#selectRow"/>
            
            <!-- Entries for selected journal -->
            <Label text="Entrées de ce Journal" styleClass="section-label"/>
            <TableView fx:id="entryTable" styleClass="table-view" prefHeight="120"/>
        </VBox>
        
        <!-- Right: Form -->
        <VBox spacing="15" styleClass="card" prefWidth="350">
            <Label text="Détails du Journal" styleClass="section-label"/>
            
            <VBox spacing="10">
                <Label text="Nom du Journal:*"/>
                <TextField fx:id="nameField" promptText="Ex: Journal 2024" styleClass="text-field"/>
                
                <Label text="Date Début:*"/>
                <DatePicker fx:id="datedebutPicker" styleClass="date-picker"/>
                
                <Label text="Date Fin:*"/>
                <DatePicker fx:id="datefinPicker" styleClass="date-picker"/>
            </VBox>
            
            <!-- Action Buttons -->
            <VBox spacing="10" alignment="CENTER">
                <Label text="Actions" styleClass="section-label"/>
                <Button text="➕ Nouveau" styleClass="button, button-success" 
                        prefWidth="150" onAction="#add"/>
                
                <Button text="💾 Enregistrer" styleClass="button, button-primary" 
                        prefWidth="150" onAction="#update"/>
                
                <Button text="🗑️ Supprimer" styleClass="button, button-danger" 
                        prefWidth="150" onAction="#delete"/>
                
                <Button text="🔄 Effacer" styleClass="button, button-secondary" 
                        prefWidth="150" onAction="#clearForm"/>
                <Separator prefWidth="300"/>
                <Button text="📋 Voir les Entrées" styleClass="button, button-primary" 
                        prefWidth="150" onAction="#showEntries"/>
            </VBox>
            
            <!-- Status -->
            <Label fx:id="statusLabel" text="" 
                   style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>
    
    <!-- Footer -->
    <Label text="Sélectionnez une ligne pour voir ses entrées | Laissez les champs vides pour nouveau" 
           style="-fx-text-fill: #7f8c8d;"/>
    
</VBox>