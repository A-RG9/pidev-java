<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.RangeSlider?>

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellora.javafx.controller.AfficherParcoursController"
      styleClass="main-content parcours-afficher" spacing="0" prefWidth="1200">
    <children>
        <VBox spacing="5.0" style="-fx-background-color: #0eb0e2; -fx-padding: 20 40 20 40;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label style="-fx-text-fill: white; -fx-font-size: 24;" text="📍" />
                        <Label style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" text="Discover Health Trails" />
                    </children>
                </HBox>
                <Label style="-fx-text-fill: #d1d8e0; -fx-font-size: 14;" text="Find the perfect health-focused route for your wellness journey" />
            </children>
        </VBox>

        <StackPane VBox.vgrow="ALWAYS">
            <children>

                <HBox styleClass="root">
                    <children>
                        <VBox prefWidth="250.0" minWidth="250.0" spacing="20.0" styleClass="form-card" style=" -fx-padding: 30 20 30 20; -fx-border-color: transparent #e1e8ed transparent transparent; -fx-border-width: 1;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label style="-fx-text-fill: #00a693; -fx-font-size: 16;" text="▼" />
                                        <Label style="-fx-font-weight: bold; -fx-font-size: 22; -fx-text-fill: #1e272e;" text="Filters" />
                                    </children>
                                </HBox>

                                <VBox spacing="8.0" style="-fx-padding: 10 0 10 0;">
                                    <children>
                                        <Label style="-fx-text-fill: #00a693; -fx-font-weight: bold; -fx-font-size: 13;" text="✨ AI TRAIL CHAT" />
                                        <Label style="-fx-text-fill: #808e9b; -fx-font-size: 12;" text="Look for the floating chat widget on the bottom right for personalized trail recommendations." wrapText="true" />
                                    </children>
                                </VBox>

                                <VBox spacing="8.0">
                                    <children>
                                        <Label style="-fx-text-fill: #808e9b; -fx-font-size: 14;" text="Health Trail Name" />
                                        <TextField fx:id="searchName" promptText="Search by name..." styleClass="form-card" style=" -fx-border-color: #dcdde1; -fx-border-radius: 6; -fx-padding: 10;" />
                                    </children>
                                </VBox>

                                <VBox spacing="8.0">
                                    <children>
                                        <Label style="-fx-text-fill: #808e9b; -fx-font-size: 14;" text="Location" />
                                        <TextField fx:id="searchLocation" promptText="Search by location..." styleClass="form-card" style=" -fx-border-color: #dcdde1; -fx-border-radius: 6; -fx-padding: 10;" />
                                    </children>
                                </VBox>

                                <VBox spacing="8.0" style="-fx-padding: 10 0 0 0;">
                                    <children>
                                        <Label style="-fx-text-fill: #808e9b; -fx-font-size: 14;" text="Distance (km)" />
                                        <RangeSlider fx:id="distanceRange" max="20.0" min="0.0" lowValue="0.0" highValue="20.0" />
                                        <HBox>
                                            <children>
                                                <Label fx:id="lblMinDistance" style="-fx-text-fill: #b2bec3; -fx-font-size: 12;" text="0 km" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblMaxDistance" style="-fx-text-fill: #00a693; -fx-font-weight: bold; -fx-font-size: 13;" text="20.0 km" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="8.0" style="-fx-padding: 10 0 0 0;">
                                    <children>
                                        <Label style="-fx-text-fill: #808e9b; -fx-font-size: 14;" text="Number of Publications" />
                                        <RangeSlider fx:id="publicationsRange" max="200.0" min="0.0" lowValue="0.0" highValue="200.0" />
                                        <HBox>
                                            <children>
                                                <Label fx:id="lblMinPubs" style="-fx-text-fill: #b2bec3; -fx-font-size: 12;" text="0" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblMaxPubs" style="-fx-text-fill: #00a693; -fx-font-weight: bold; -fx-font-size: 13;" text="200" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <Region VBox.vgrow="ALWAYS" />

                                <HBox spacing="15.0">
                                    <children>
                                        <Button fx:id="btnSearch" maxWidth="Infinity" style="-fx-background-color: #00a693; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 6; -fx-padding: 12; -fx-cursor: hand;" text="Search" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnReset" prefHeight="45.0" prefWidth="45.0" styleClass="form-card" style=" -fx-border-color: #dcdde1; -fx-border-radius: 6; -fx-text-fill: #2f3640; -fx-cursor: hand;" text="↻" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 30 40 20 40;">
                                    <children>
                                        <Label fx:id="countLabel" style="-fx-font-size: 18; -fx-text-fill: #485460;" text="4 parcours available" />

                                        <Region HBox.hgrow="ALWAYS" />

                                        <ComboBox fx:id="sortCombo" prefHeight="40.0" prefWidth="160.0" styleClass="form-card" style=" -fx-border-color: #dcdde1; -fx-border-radius: 6;" />

                                        <Button fx:id="btnSortAsc" prefHeight="40.0" prefWidth="40.0" styleClass="form-card" style=" -fx-border-color: #dcdde1; -fx-border-radius: 6; -fx-cursor: hand;" text= "↓" />
                                        <Button fx:id="btnSortDesc" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #00a693; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="↑" />

                                        <Button fx:id="btnAdd" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #00a693; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-font-size: 16; -fx-cursor: hand;" text="+" />
                                    </children>
                                </HBox>

                                <ScrollPane fitToWidth="true" styleClass="root" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                    <content>
                                        <FlowPane fx:id="cardsContainer" hgap="30.0" style="-fx-padding: 0 40 40 40;" vgap="30.0" />
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox fx:id="chatWindow" maxWidth="320.0" maxHeight="450.0" spacing="0" visible="false"
                      styleClass="form-card" style=" -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e1e8ed; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);"
                      StackPane.alignment="BOTTOM_RIGHT">

                    <StackPane.margin>
                        <Insets bottom="90.0" right="20.0" />
                    </StackPane.margin>

                    <children>
                        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #00a693; -fx-background-radius: 11 11 0 0; -fx-padding: 12 15;">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;" text="🤖 AI Assistant" />
                                <Region HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <ScrollPane fx:id="chatScrollPane" fitToWidth="true" style="-fx-background-color: #f8faf9; -fx-background: #f8faf9;" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="chatMessagesContainer" spacing="8.0" style="-fx-padding: 15; -fx-background-color: #f8faf9;" />
                            </content>
                        </ScrollPane>

                        <FlowPane fx:id="quickChoicesPane" hgap="8.0" vgap="8.0" style="-fx-padding: 10 15; -fx-background-color: white; -fx-border-color: #e8f5f3; -fx-border-width: 1 0 0 0;" />

                        <HBox spacing="8.0" style="-fx-padding: 12 15; -fx-border-color: #e8f5f3; -fx-border-width: 1 0 0 0; -fx-background-color: white; -fx-background-radius: 0 0 11 11;">
                            <children>
                                <TextField fx:id="chatInput" promptText="Ask about trails..." style="-fx-background-color: #f8faf9; -fx-background-radius: 20; -fx-border-color: #c8e6e0; -fx-border-radius: 20; -fx-border-width: 1.5; -fx-padding: 8 15; -fx-font-size: 12;" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnSendMessage" style="-fx-background-color: #00a693; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 15; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 12;" text="Send" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <Button fx:id="btnToggleChat" prefHeight="56.0" prefWidth="56.0" StackPane.alignment="BOTTOM_RIGHT" style="-fx-background-color: linear-gradient(to bottom right, #00a693 0%, #008F7A 100%); -fx-background-radius: 28; -fx-font-size: 22; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,166,147,0.4), 8, 0, 0, 6); -fx-cursor: hand; -fx-border-color: white; -fx-border-radius: 28; -fx-border-width: 2;" text="💬" alignment="CENTER">
                    <StackPane.margin>
                        <Insets bottom="20.0" right="20.0" />
                    </StackPane.margin>
                </Button>

            </children>
        </StackPane>
    </children>
</VBox>
