<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wellora.javafx.controller.SymptomController"
      spacing="15" 
      styleClass="root"
      prefWidth="1100" 
      prefHeight="750">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <!-- Header -->
    <Label text="🤒 Gestion des Symptômes" styleClass="header-label"/>
    
    <!-- Main Content -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        
        <!-- Left: Table View -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label text="Liste des Symptômes" styleClass="section-label"/>
            
            <!-- Search Bar -->
            <HBox spacing="10">
                <TextField fx:id="searchField" promptText="Rechercher par type..." 
                         prefWidth="200" styleClass="text-field"/>
                <Button text="🔍" styleClass="button, button-primary" onAction="#search"/>
                <Button text="📋" styleClass="button, button-secondary" onAction="#refresh"/>
            </HBox>
            
            <!-- Table -->
            <TableView fx:id="tableView" styleClass="table-view" 
                      VBox.vgrow="ALWAYS" onMouseClicked="#selectRow">
                <columns>
                    <TableColumn text="Type" prefWidth="150" fx:id="typeCol"/>
                    <TableColumn text="Intensité" prefWidth="80" fx:id="intensiteCol"/>
                    <TableColumn text="Zone" prefWidth="150" fx:id="zoneCol"/>
                </columns>
            </TableView>
        </VBox>
        
        <!-- Right: Form -->
        <VBox spacing="15" styleClass="card" prefWidth="350">
            <Label text="Détails du Symptôme" styleClass="section-label"/>
            
            <GridPane hgap="10" vgap="10">
                <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="idField" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                          editable="false" styleClass="text-field"/>
                
                <Label text="Type:*" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="typeCombo" GridPane.columnIndex="1" GridPane.rowIndex="1" 
                         promptText="Sélectionner"/>
                
                <Label text="Intensité (1-10):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Slider fx:id="intensiteSlider" min="1" max="10" showTickLabels="true" 
                           showTickMarks="true" blockIncrement="1"/>
                    <Label fx:id="intensiteLabel" text="5"/>
                </HBox>
                
                <Label text="Zone:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="zoneField" GridPane.columnIndex="1" GridPane.rowIndex="3" 
                          promptText="Ex: Tête,dos,abdomen" styleClass="text-field"/>
                
                <Label text="Entrée ID:*" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="entryIdField" GridPane.columnIndex="1" GridPane.rowIndex="4" 
                          promptText="ID de l'entrée" styleClass="text-field"/>
            </GridPane>
            
            <!-- Buttons -->
            <VBox spacing="10" alignment="CENTER">
                <Button text="➕ Ajouter" styleClass="button, button-success" 
                        prefWidth="150" onAction="#add"/>
                
                <Button text="💾 Mettre à jour" styleClass="button, button-primary" 
                        prefWidth="150" onAction="#update"/>
                
                <Button text="🗑️ Supprimer" styleClass="button, button-danger" 
                        prefWidth="150" onAction="#delete"/>
                
                <Button text="🔄 Effacer" styleClass="button, button-secondary" 
                        prefWidth="150" onAction="#clearForm"/>
            </VBox>
            
            <!-- Status -->
            <Label fx:id="statusLabel" text="" 
                   style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>
    
    <!-- Footer -->
    <Label text="Sélectionnez une ligne pour modifier | Laissez ID vide pour nouveau | Intensité: 1-10" 
           style="-fx-text-fill: #7f8c8d;"/>
    
</VBox>