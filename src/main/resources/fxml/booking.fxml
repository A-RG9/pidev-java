<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.BookingController"
      fx:id="rootPane"
      style="-fx-background-color: #f9fafb;">

    <!-- ToggleGroup Definition for Payment RadioButtons -->
    <fx:define>
        <ToggleGroup fx:id="paymentGroup"/>
    </fx:define>

    <!-- LEFT SIDEBAR -->
    <VBox fx:id="sidebar" minWidth="280" maxWidth="280" 
          style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 1 0 0;">
        
        <!-- Logo Section -->
        <HBox spacing="12" style="-fx-padding: 20 20 20 20;">
            <StackPane minWidth="36" minHeight="36" 
                       style="-fx-background-color: #00A790; -fx-background-radius: 8;">
                <Label text="W" 
                       style="-fx-font-size: 18px; -fx-text-fill: white;"/>
            </StackPane>
            <Label text="WellCare" 
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
        </HBox>
        
        <!-- Spacer -->
        <Region VBox.vgrow="ALWAYS"/>
        
        <!-- User Profile Section -->
        <VBox style="-fx-padding: 0 16 16 16; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
            <HBox spacing="12" 
                  style="-fx-background-color: #f9fafb; -fx-padding: 12; -fx-background-radius: 8;">
                <StackPane minWidth="40" minHeight="40" 
                           style="-fx-background-color: #00A790; -fx-background-radius: 20;">
                    <Label text="CM" 
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="CHAHAD MAALOUL" 
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <Label text="chahad.maaloul@esprit.tn" 
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
                </VBox>
            </HBox>
        </VBox>
        
        <!-- Espace Patient Section -->
        <VBox spacing="4" style="-fx-padding: 12 20 16 20;">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="ESPACE PATIENT" 
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #00A790;"/>
                <StackPane minWidth="20" minHeight="20" 
                           style="-fx-background-color: #00A790; -fx-background-radius: 10;">
                    <Label text="8" 
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </StackPane>
            </HBox>
        </VBox>
        
        <!-- Navigation Menu -->
        <VBox spacing="1" style="-fx-padding: 0 8 20 8;" VBox.vgrow="ALWAYS">
            
            <!-- Tableau de bord -->
            <Button fx:id="menuDashboard" text="Tableau de bord" 
                    onAction="#handleMenuClick"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-padding: 10 12 10 12; -fx-alignment: CENTER_LEFT; -fx-background-radius: 6;"/>
            
            <!-- Rendez-vous Section (expanded by default) -->
            <VBox>
                <Button fx:id="menuRendezVous" text="Rendez-vous" 
                        onAction="#toggleSubmenu"
                        style="-fx-background-color: #ecfdf5; -fx-text-fill: #059669; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 12 10 12; -fx-background-radius: 6;"/>
                
                <!-- Submenu (visible by default for Rendez-vous) -->
                <VBox fx:id="submenuContainer" spacing="1">
                    <padding>
                        <Insets left="24" top="4"/>
                    </padding>
                    <Button fx:id="menuMesRDV" text="   Mes Rendez-vous" 
                            onAction="#handleMenuClick"
                            style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-padding: 8 12 8 12; -fx-alignment: CENTER_LEFT; -fx-background-radius: 6;"/>
                    <Button fx:id="menuTrouverMedecin" text="   Trouver un Médecin" 
                            onAction="#handleMenuClick"
                            style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-padding: 8 12 8 12; -fx-alignment: CENTER_LEFT; -fx-background-radius: 6;"/>
                    <Button fx:id="menuProfilMedecin" text="   Profil Médecin" 
                            onAction="#handleMenuClick"
                            style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-padding: 8 12 8 12; -fx-alignment: CENTER_LEFT; -fx-background-radius: 6;"/>
                    <Button fx:id="menuPrendreRDV" text="   Prendre RDV" 
                            onAction="#handleMenuClick"
                            style="-fx-background-color: #00A790; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 12 8 12; -fx-background-radius: 6;"/>
                </VBox>
            </VBox>
            
            <!-- Santé Section -->
            <VBox spacing="1">
                <Label text="Santé" 
                       style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 12 10 12;"/>
                <VBox spacing="1" style="-fx-padding: 0 0 0 24;">
                    <Button text="Résultats de Laboratoire" 
                            onAction="#handleMenuClick"
                            style="-fx-background-color: #00A790; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 12 8 12; -fx-alignment: CENTER_LEFT; -fx-background-radius: 6;"/>
                    <Button text="Mes Ordonnances" 
                            onAction="#handleMenuClick"
                            style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-padding: 8 12 8 12; -fx-alignment: CENTER_LEFT; -fx-background-radius: 6;"/>
                </VBox>
            </VBox>
            
            <!-- Nutrition Section -->
            <VBox>
                <Button text="Nutrition" 
                        onAction="#toggleSubmenu"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 12 10 12; -fx-alignment: CENTER_LEFT; -fx-background-radius: 6;"/>
            </VBox>
            
            <!-- Fitness Section -->
            <VBox>
                <Button text="Fitness" 
                        onAction="#toggleSubmenu"
                        style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 12 10 12; -fx-alignment: CENTER_LEFT; -fx-background-radius: 6;"/>
            </VBox>
            
        </VBox>
        
        <!-- Sidebar Footer -->
        <VBox style="-fx-padding: 12; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
            
            <!-- Profile Link -->
            <Button text="Mon Profil" 
                    onAction="#handleMenuClick"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-padding: 10 12 10 12; -fx-alignment: CENTER_LEFT; -fx-background-radius: 6;"/>
            
            <!-- Settings -->
            <Button fx:id="menuSettings" text="⚙️  Paramètres" 
                    onAction="#handleMenuClick"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-padding: 10 12 10 12; -fx-alignment: CENTER_LEFT; -fx-background-radius: 6;"/>
            
            <!-- Logout -->
            <Button text="Déconnexion" 
                    onAction="#handleMenuClick"
                    style="-fx-background-color: transparent; -fx-text-fill: #dc2626; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-padding: 10 12 10 12; -fx-background-radius: 6;"/>
        </VBox>
    </VBox>
    
    <!-- RIGHT SIDE - Existing Booking Form -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #f9fafb; -fx-border-width: 0;">
        <VBox spacing="0" style="-fx-padding: 32 48 48 48;">

            <!-- Header -->
            <VBox spacing="8" alignment="CENTER" style="-fx-padding: 0 0 32 0;">
                <Label text="Book Your Appointment"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Label text="Complete the steps below to schedule your consultation"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
            </VBox>

            <!-- Progress Steps -->
            <HBox alignment="CENTER" style="-fx-padding: 0 0 32 0;">
                <!-- Step 1 -->
                <HBox spacing="10" alignment="CENTER">
                    <StackPane fx:id="step1Circle" minWidth="40" minHeight="40"
                               style="-fx-background-color: #00A790; -fx-background-radius: 20;">
                        <Label fx:id="step1Indicator" text="1"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    </StackPane>
                    <Label fx:id="step1Label" text="Service"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                </HBox>
                <Region fx:id="connector1" minWidth="80" minHeight="4"
                        style="-fx-background-color: #00A790; -fx-background-radius: 2;"/>
                <!-- Step 2 -->
                <HBox spacing="10" alignment="CENTER">
                    <StackPane fx:id="step2Circle" minWidth="40" minHeight="40"
                               style="-fx-background-color: #e5e7eb; -fx-background-radius: 20;">
                        <Label fx:id="step2Indicator" text="2"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                    </StackPane>
                    <Label fx:id="step2Label" text="Date &amp; Time"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                </HBox>
                <Region fx:id="connector2" minWidth="80" minHeight="4"
                        style="-fx-background-color: #e5e7eb; -fx-background-radius: 2;"/>
                <!-- Step 3 -->
                <HBox spacing="10" alignment="CENTER">
                    <StackPane fx:id="step3Circle" minWidth="40" minHeight="40"
                               style="-fx-background-color: #e5e7eb; -fx-background-radius: 20;">
                        <Label fx:id="step3Indicator" text="3"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                    </StackPane>
                    <Label fx:id="step3Label" text="Patient Info"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                </HBox>
                <Region fx:id="connector3" minWidth="80" minHeight="4"
                        style="-fx-background-color: #e5e7eb; -fx-background-radius: 2;"/>
                <!-- Step 4 -->
                <HBox spacing="10" alignment="CENTER">
                    <StackPane fx:id="step4Circle" minWidth="40" minHeight="40"
                               style="-fx-background-color: #e5e7eb; -fx-background-radius: 20;">
                        <Label fx:id="step4Indicator" text="4"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                    </StackPane>
                    <Label fx:id="step4Label" text="Confirm"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                </HBox>
            </HBox>

            <!-- Main Card -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 16;
                         -fx-border-color: #e5e7eb; -fx-border-radius: 16; -fx-border-width: 1;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 12, 0, 0, 3);
                         -fx-padding: 32;">
                <VBox.margin><Insets left="24" right="24"/></VBox.margin>

                <!-- ========== STEP 1 : SERVICE ========== -->
                <VBox fx:id="step1Pane" spacing="24">
                    <Label text="Select Service"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <!-- Doctor banner -->
                    <HBox spacing="16" alignment="CENTER_LEFT"
                          style="-fx-background-color: #ecfdf5; -fx-background-radius: 12; -fx-padding: 16;">
                        <StackPane minWidth="64" minHeight="64"
                                   style="-fx-background-color: #d1fae5; -fx-background-radius: 12;">
                            <Label text="👨‍⚕️" style="-fx-font-size: 28px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label text="Dr. Mariem Fakhfakh"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                            <Label text="General Medicine · Tunis"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                        </VBox>
                    </HBox>

                    <!-- Consultation Type -->
                    <VBox spacing="10">
                        <HBox spacing="4">
                            <Label text="Consultation Type" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <Label text="*" style="-fx-text-fill: #ef4444; -fx-font-size: 13px;"/>
                        </HBox>
                        <HBox spacing="12">
                            <VBox fx:id="firstVisitBtn" spacing="8" alignment="TOP_LEFT" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #ecfdf5; -fx-background-radius: 12; -fx-border-color: #00A790; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 16; -fx-cursor: hand;"
                                  onMouseClicked="#selectFirstVisit">
                                <Label text="👤" style="-fx-font-size: 24px;"/>
                                <Label text="First Visit" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                <Label text="Initial consultation" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            </VBox>
                            <VBox fx:id="followUpBtn" spacing="8" alignment="TOP_LEFT" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 16; -fx-cursor: hand;"
                                  onMouseClicked="#selectFollowUp">
                                <Label text="🔄" style="-fx-font-size: 24px;"/>
                                <Label text="Follow-up" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                <Label text="Continuing care" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            </VBox>
                            <VBox fx:id="emergencyBtn" spacing="8" alignment="TOP_LEFT" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 16; -fx-cursor: hand;"
                                  onMouseClicked="#selectEmergency">
                                <Label text="🚑" style="-fx-font-size: 24px;"/>
                                <Label text="Emergency" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                <Label text="Urgent care needed" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Appointment Mode -->
                    <VBox spacing="10">
                        <HBox spacing="4">
                            <Label text="Appointment Mode" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <Label text="*" style="-fx-text-fill: #ef4444; -fx-font-size: 13px;"/>
                        </HBox>
                        <HBox spacing="12">
                            <VBox fx:id="inPersonBtn" spacing="6" alignment="TOP_LEFT" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #ecfdf5; -fx-background-radius: 12; -fx-border-color: #00A790; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 16; -fx-cursor: hand;"
                                  onMouseClicked="#selectInPerson">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="🏥" style="-fx-font-size: 22px;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="120 TND" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #00A790;"/>
                                </HBox>
                                <Label text="In-Person" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                <Label text="At clinic • 45 min" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            </VBox>
                            <VBox fx:id="phoneBtn" spacing="6" alignment="TOP_LEFT" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 16; -fx-cursor: hand;"
                                  onMouseClicked="#selectPhone">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="📞" style="-fx-font-size: 22px;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="70 TND" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #00A790;"/>
                                </HBox>
                                <Label text="Phone Call" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                <Label text="Call • 20 min" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Reason for Visit -->
                    <VBox spacing="10">
                        <HBox spacing="4">
                            <Label text="Reason for Visit" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <Label text="*" style="-fx-text-fill: #ef4444; -fx-font-size: 13px;"/>
                        </HBox>
                        <FlowPane fx:id="symptomsFlow" hgap="8" vgap="8"/>
                        <TextArea fx:id="reasonField" promptText="Please describe your symptoms or reason for the visit in detail..."
                                  wrapText="true" prefRowCount="3"
                                  style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-background-color: #f9fafb; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 10;"/>
                    </VBox>

                    <!-- Duration -->
                    <VBox spacing="10">
                        <Label text="Preferred Duration" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <HBox spacing="10">
                            <Button fx:id="duration15Btn" text="15 min" onAction="#selectDuration15"
                                    style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-width: 0; -fx-pref-height: 36; -fx-cursor: hand;"/>
                            <Button fx:id="duration30Btn" text="30 min" onAction="#selectDuration30"
                                    style="-fx-background-color: #00A790; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-width: 0; -fx-pref-height: 36; -fx-cursor: hand;"/>
                            <Button fx:id="duration45Btn" text="45 min" onAction="#selectDuration45"
                                    style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-width: 0; -fx-pref-height: 36; -fx-cursor: hand;"/>
                            <Button fx:id="duration60Btn" text="60 min" onAction="#selectDuration60"
                                    style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-width: 0; -fx-pref-height: 36; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- ========== STEP 2 : DATE & TIME ========== -->
                <VBox fx:id="step2Pane" visible="false" managed="false" spacing="24">
                    <Label text="Choose Date &amp; Time" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <VBox spacing="10">
                        <HBox spacing="4">
                            <Label text="Select Date" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <Label text="*" style="-fx-text-fill: #ef4444; -fx-font-size: 13px;"/>
                        </HBox>
                        <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 16;">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Button text="‹" onAction="#previousMonth"
                                        style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-size: 18px; -fx-background-radius: 8; -fx-border-width: 0; -fx-min-width: 34; -fx-min-height: 34; -fx-cursor: hand;"/>
                                <Label fx:id="monthYearText" text="June 2026" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;" HBox.hgrow="ALWAYS"/>
                                <Button text="›" onAction="#nextMonth"
                                        style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-size: 18px; -fx-background-radius: 8; -fx-border-width: 0; -fx-min-width: 34; -fx-min-height: 34; -fx-cursor: hand;"/>
                            </HBox>
                            <GridPane fx:id="calendarGrid" hgap="4" vgap="4"/>
                        </VBox>
                    </VBox>
                    <VBox spacing="10">
                        <HBox spacing="4">
                            <Label text="Available Time Slots" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <Label text="*" style="-fx-text-fill: #ef4444; -fx-font-size: 13px;"/>
                        </HBox>
                        <FlowPane fx:id="timeSlotsFlow" hgap="10" vgap="10"/>
                        <HBox spacing="20" style="-fx-padding: 8 0 0 0;">
                            <HBox spacing="6" alignment="CENTER_LEFT">
