    </ScrollPane>

    <!-- Loading Overlay -->
    <StackPane fx:id="loadingPane" visible="false" style="-fx-background-color: rgba(0,0,0,0.35);">
        <VBox spacing="12" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 32; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 16, 0, 0, 4);">
            <ProgressIndicator progress="-1" prefWidth="48" prefHeight="48" style="-fx-accent: #00A790;"/>
            <Label text="Processing your booking..." style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #374151;"/>
        </VBox>
    </StackPane>
</HBox>