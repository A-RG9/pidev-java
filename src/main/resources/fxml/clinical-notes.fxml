<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wellcare.javafx.controller.ClinicalNotesController"
      stylesheets="@../css/styles.css"
      style="-fx-background-color: #f9fafb;">

    <!-- LEFT SIDEBAR - Included from sidebar.fxml -->
    <fx:include source="sidebar.fxml" />

    <!-- RIGHT SIDE - Editor -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #f9fafb; -fx-border-width: 0;">
        <VBox spacing="0" style="-fx-padding: 32 48 48 48;">

            <!-- Editor Header -->
            <VBox spacing="8" style="-fx-padding: 0 0 20 0; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
                <Text fx:id="editorTitle" text="Nouvelle Note SOAP"
                      style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #111827;"/>
                <Label fx:id="editorMeta" text="15/04/2026 â€¢ Dr. Name"
                       style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
            </VBox>

            <!-- SUBJECTIVE (S) -->
            <VBox spacing="12" style="-fx-padding: 32 0 0 0;">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <StackPane minWidth="36" minHeight="36"
                               style="-fx-background-color: #3b82f6; -fx-background-radius: 50%; -fx-alignment: CENTER;">
                        <Label text="S" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    </StackPane>
                    <Label text="Subjectif"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                </HBox>
                <TextArea fx:id="subjective" promptText="SymptÃ´mes rapportÃ©s..."
                          style="-fx-padding: 14 16 14 16; -fx-background-radius: 12; -fx-border-color: #d1d5db; -fx-control-inner-background: #f3f4f6;" wrapText="true"/>
            </VBox>

            <!-- OBJECTIVE (O) -->
            <VBox spacing="12" style="-fx-padding: 32 0 0 0;">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <StackPane minWidth="36" minHeight="36"
                               style="-fx-background-color: #10b981; -fx-background-radius: 50%; -fx-alignment: CENTER;">
                        <Label text="O" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    </StackPane>
                    <Label text="Objectif"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                </HBox>

                <!-- Vitals Grid -->
                <GridPane hgap="16" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>

                    <!-- Blood Pressure -->
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Tension (mmHg)" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <HBox spacing="8">
                            <TextField fx:id="bpSystolic" text="120"
                                       style="-fx-padding: 10 12 10 12; -fx-background-radius: 8; -fx-border-color: #d1d5db;" prefWidth="60"/>
                            <Label text="/" style="-fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
                            <TextField fx:id="bpDiastolic" text="80"
                                       style="-fx-padding: 10 12 10 12; -fx-background-radius: 8; -fx-border-color: #d1d5db;" prefWidth="60"/>
                        </HBox>
                    </VBox>

                    <!-- Pulse -->
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Pouls (bpm)" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <TextField fx:id="pulse" text="72"
                                   style="-fx-padding: 10 12 10 12; -fx-background-radius: 8; -fx-border-color: #d1d5db;"/>
                    </VBox>

                    <!-- Temperature -->
                    <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="TempÃ©rature (Â°C)" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <TextField fx:id="temperature" text="37"
                                   style="-fx-padding: 10 12 10 12; -fx-background-radius: 8; -fx-border-color: #d1d5db;"/>
                    </VBox>

                    <!-- SpO2 -->
                    <VBox spacing="6" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <Label text="SpO2 (%)" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <TextField fx:id="spo2" text="99"
                                   style="-fx-padding: 10 12 10 12; -fx-background-radius: 8; -fx-border-color: #d1d5db;"/>
                    </VBox>
                </GridPane>

                <TextArea fx:id="objective" promptText="Examen physique..."
                          style="-fx-padding: 14 16 14 16; -fx-background-radius: 12; -fx-border-color: #d1d5db; -fx-control-inner-background: #f3f4f6;" wrapText="true"/>
            </VBox>

            <!-- ASSESSMENT (A) -->
            <VBox spacing="12" style="-fx-padding: 32 0 0 0;">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <StackPane minWidth="36" minHeight="36"
                               style="-fx-background-color: #f59e0b; -fx-background-radius: 50%; -fx-alignment: CENTER;">
                        <Label text="A" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    </StackPane>
                    <Label text="Ã‰valuation"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                </HBox>

                <Label text="Diagnostics (CIM-10)"
                       style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                <HBox fx:id="diagnosesTags" spacing="8"/>
                <HBox spacing="12">
                    <TextField fx:id="newDiagnosis" promptText="Code CIM-10..."
                               style="-fx-padding: 10 12 10 12; -fx-background-radius: 8; -fx-border-color: #d1d5db;" HBox.hgrow="ALWAYS"/>
                    <Button text="Ajouter" onAction="#addDiagnosis"
                            style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-font-weight: bold;"/>
                </HBox>

                <TextArea fx:id="assessment" promptText="InterprÃ©tation..."
                          style="-fx-padding: 14 16 14 16; -fx-background-radius: 12; -fx-border-color: #d1d5db; -fx-control-inner-background: #f3f4f6;" wrapText="true"/>
            </VBox>

            <!-- PLAN (P) -->
            <VBox spacing="12" style="-fx-padding: 32 0 0 0;">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <StackPane minWidth="36" minHeight="36"
                               style="-fx-background-color: #ef4444; -fx-background-radius: 50%; -fx-alignment: CENTER;">
                        <Label text="P" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    </StackPane>
                    <Label text="Plan"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                </HBox>

                <!-- Medications Section -->
                <Label text="Ordonnance MÃ©dicamenteuse"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 0 12 0;"/>
                <Button text="+ Ajouter un mÃ©dicament" onAction="#addMedicationCard"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 10 16 10 16; -fx-background-radius: 8; -fx-font-weight: bold;"/>
                <VBox fx:id="medicationsContainer" spacing="12"/>

                <!-- Exams Section -->
                <Label text="Examens ComplÃ©mentaires"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 24 0 12 0;"/>
                <Button text="+ Ajouter un examen" onAction="#addExamCard"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 10 16 10 16; -fx-background-radius: 8; -fx-font-weight: bold;"/>
                <VBox fx:id="examsContainer" spacing="12"/>

                <!-- Plan de traitement -->
                <Label text="Plan de traitement gÃ©nÃ©ral"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 12 0 8 0;"/>
                <TextArea fx:id="plan" promptText="Recommandations..."
                          style="-fx-padding: 14 16 14 16; -fx-background-radius: 12; -fx-border-color: #d1d5db; -fx-control-inner-background: #f3f4f6;" wrapText="true"/>

                <!-- Follow-up -->
                <VBox spacing="8" style="-fx-padding: 24 12 12 12; -fx-background-color: #f3f4f6; -fx-background-radius: 8; -fx-border-color: #d1d5db; -fx-border-width: 2;">
                    <Label text="Prochain rendez-vous"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <GridPane hgap="16" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33"/>
                            <ColumnConstraints percentWidth="33"/>
                            <ColumnConstraints percentWidth="33"/>
                        </columnConstraints>
                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Date" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <DatePicker fx:id="followUpDate"
                                        style="-fx-padding: 8 12 8 12; -fx-background-radius: 8; -fx-border-color: #d1d5db;"/>
                        </VBox>
                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Type" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="followUpType"
                                      style="-fx-padding: 8 12 8 12; -fx-background-radius: 8; -fx-border-color: #d1d5db;"/>
                        </VBox>
                        <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label text="PrioritÃ©" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="followUpPriority"
                                      style="-fx-padding: 8 12 8 12; -fx-background-radius: 8; -fx-border-color: #d1d5db;"/>
                        </VBox>
                    </GridPane>
                </VBox>
            </VBox>

            <!-- Action Buttons -->
            <HBox spacing="12" style="-fx-padding: 32 0 0 0; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
                <Button text="Enregistrer" fx:id="saveBtnText" onAction="#saveNoteToServer"
                        style="-fx-background-color: #1e40af; -fx-text-fill: white; -fx-padding: 12 28 12 28; -fx-background-radius: 8; -fx-font-weight: bold;"/>
                <Button text="GÃ©nÃ©rer Rapport IA" onAction="#generateAIReport"
                        style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-padding: 12 28 12 28; -fx-background-radius: 8; -fx-font-weight: bold;"/>
                <Button text="RÃ©initialiser" onAction="#resetForm"
                        style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-padding: 12 28 12 28; -fx-background-radius: 8; -fx-font-weight: bold;"/>
            </HBox>

        </VBox>
    </ScrollPane>
</HBox>
