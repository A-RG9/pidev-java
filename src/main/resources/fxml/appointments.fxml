<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="org.example.controllers.AppointmentsController"
      fx:id="rootPane"
      stylesheets="@../css/styles.css"
      style="-fx-background-color: #f9fafb;">

    <!-- LEFT SIDEBAR - Included from sidebar.fxml -->
    <fx:include source="sidebar.fxml" />

    <!-- RIGHT SIDE - Main Content -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #f9fafb; -fx-border-width: 0;">
        <VBox spacing="0" style="-fx-padding: 0;">

    <!-- Header -->
    <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, #00000010, 3, 0, 0, 1);">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
        <HBox spacing="16" alignment="CENTER_LEFT">
            <VBox spacing="4">
                <Text text="My Appointments" styleClass="header-title">
                    <font>
                        <Font size="28" />
                    </font>
                </Text>
                <Text text="Manage your upcoming and past appointments" styleClass="header-subtitle">
                    <font>
                        <Font size="14" />
                    </font>
                </Text>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="+ Book New Appointment" styleClass="btn-primary" onAction="#handleBookNewAppointment">
                <font>
                    <Font size="14" />
                </font>
            </Button>
        </HBox>
    </VBox>

    <!-- Main Content -->
    <VBox VBox.vgrow="ALWAYS" spacing="16">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
        
        <!-- Stats Cards -->
        <HBox spacing="16">
            <!-- Upcoming Card -->
            <VBox styleClass="stats-card" maxWidth="99999.0" HBox.hgrow="ALWAYS">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <StackPane styleClass="stats-icon" minWidth="48.0" minHeight="48.0">
                        <StackPane styleClass="stats-icon-bg" style="-fx-background-color: #d1fae5;" />
                        <Label text="&#xf272;" styleClass="fas" style="-fx-text-fill: #00A790;" />
                    </StackPane>
                    <VBox spacing="2">
                        <Text text="Upcoming" styleClass="stats-label" />
                        <Text fx:id="upcomingCount" text="0" styleClass="stats-value" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Completed Card -->
            <VBox styleClass="stats-card" maxWidth="99999.0" HBox.hgrow="ALWAYS">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <StackPane minWidth="48.0" minHeight="48.0">
                        <StackPane style="-fx-background-color: #d1fae5; -fx-background-radius: 12;" />
                        <Label text="&#xf00c;" styleClass="fas" style="-fx-text-fill: #059669;" />
                    </StackPane>
                    <VBox spacing="2">
                        <Text text="Completed" styleClass="stats-label" />
                        <Text fx:id="completedCount" text="0" styleClass="stats-value" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Pending Card -->
            <VBox styleClass="stats-card" maxWidth="99999.0" HBox.hgrow="ALWAYS">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <StackPane minWidth="48.0" minHeight="48.0">
                        <StackPane style="-fx-background-color: #fef3c7; -fx-background-radius: 12;" />
                        <Label text="&#xf252;" styleClass="fas" style="-fx-text-fill: #d97706;" />
                    </StackPane>
                    <VBox spacing="2">
                        <Text text="Pending" styleClass="stats-label" />
                        <Text fx:id="pendingCount" text="0" styleClass="stats-value" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Cancelled Card -->
            <VBox styleClass="stats-card" maxWidth="99999.0" HBox.hgrow="ALWAYS">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <StackPane minWidth="48.0" minHeight="48.0">
                        <StackPane style="-fx-background-color: #fee2e2; -fx-background-radius: 12;" />
                        <Label text="&#xf00d;" styleClass="fas" style="-fx-text-fill: #dc2626;" />
                    </StackPane>
                    <VBox spacing="2">
                        <Text text="Cancelled" styleClass="stats-label" />
                        <Text fx:id="cancelledCount" text="0" styleClass="stats-value" />
                    </VBox>
                </HBox>
            </VBox>
        </HBox>

        <!-- Tabs -->
        <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS" styleClass="appointments-tabs">
            <Tab text="Upcoming" fx:id="tabUpcoming">
                <ScrollPane fitToWidth="true">
                    <VBox fx:id="upcomingList" spacing="12">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
        </VBox>
                </ScrollPane>
            </Tab>
            <Tab text="Pending" fx:id="tabPending">
                <ScrollPane fitToWidth="true">
                    <VBox fx:id="pendingList" spacing="12">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
        </VBox>
                </ScrollPane>
            </Tab>
            <Tab text="Completed" fx:id="tabCompleted">
                <ScrollPane fitToWidth="true">
                    <VBox fx:id="completedList" spacing="12">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
        </VBox>
                </ScrollPane>
            </Tab>
            <Tab text="Cancelled" fx:id="tabCancelled">
                <ScrollPane fitToWidth="true">
                    <VBox fx:id="cancelledList" spacing="12">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
        </VBox>
                </ScrollPane>
            </Tab>
        </TabPane>

        <!-- Quick Actions -->
        <HBox spacing="16">
            <Button text="Find a Doctor" styleClass="quick-action-btn" onAction="#handleFindDoctor" HBox.hgrow="ALWAYS" />
            <Button text="Medical Records" styleClass="quick-action-btn" onAction="#handleMedicalRecords" HBox.hgrow="ALWAYS" />
            <Button text="Support" styleClass="quick-action-btn" onAction="#handleSupport" HBox.hgrow="ALWAYS" />
        </HBox>
    </VBox>

    <!-- Loading Indicator -->
    <StackPane fx:id="loadingPane" visible="false" style="-fx-background-color: rgba(0,0,0,0.3);">
        <ProgressIndicator progress="-1" />
    </StackPane>

        </VBox>
    </ScrollPane>

</HBox>