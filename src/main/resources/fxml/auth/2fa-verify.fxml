<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.wellcare.javafx.controller.auth.TwoFactorVerifyController"
      styleClass="root" alignment="CENTER" spacing="20.0" prefWidth="1000.0" prefHeight="700.0">

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
        <content>
            <VBox alignment="CENTER" spacing="30.0" style="-fx-padding: 40 0;">
                
                <VBox alignment="CENTER" spacing="10.0">
                    <Text text="⚕️ WellCare" styleClass="welcome-title"/>
                    <Text text="Two-Factor Authentication" styleClass="welcome-subtitle"/>
                </VBox>

                <VBox styleClass="card" alignment="CENTER" spacing="25.0" prefWidth="400.0" maxWidth="400.0">
                    
                    <VBox styleClass="card-header" alignment="CENTER">
                        <Text text="Verification Required" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: white;"/>
                    </VBox>

                    <VBox styleClass="card-body" alignment="CENTER" spacing="20.0">
                        <Text text="Enter the 6-digit code from your authenticator app or a backup code." 
                              wrappingWidth="300.0" style="-fx-text-alignment: center; -fx-fill: #6c757d;"/>

                        <VBox spacing="8.0">
                            <Label text="Security Code" styleClass="form-label"/>
                            <TextField fx:id="codeField" promptText="000000" styleClass="form-control" alignment="CENTER"
                                       style="-fx-font-size: 24px; -fx-font-family: 'monospace';"/>
                            <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false" wrapText="true"/>
                        </VBox>

                        <Button fx:id="verifyButton" text="Verify and Log In" styleClass="btn-primary" 
                                maxWidth="1.7976931348623157E308" prefHeight="45.0" onAction="#handleVerify"/>
                        
                        <Hyperlink text="Cancel and return to login" onAction="#handleCancel" styleClass="wellcare-link"/>
                    </VBox>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
