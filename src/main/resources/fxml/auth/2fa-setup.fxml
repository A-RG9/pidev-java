<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.layout.StackPane?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.wellcare.javafx.controller.auth.TwoFactorSetupController"
      styleClass="root" alignment="CENTER" spacing="20.0" prefWidth="1000.0" prefHeight="700.0">

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
        <content>
            <VBox alignment="CENTER" spacing="30.0" style="-fx-padding: 40 0;">
                
                <VBox alignment="CENTER" spacing="10.0">
                    <Text text="⚕️ WellCare" styleClass="welcome-title"/>
                    <Text text="Configure 2FA Security" styleClass="welcome-subtitle"/>
                </VBox>

                <VBox styleClass="card" alignment="CENTER" spacing="20.0" prefWidth="550.0" maxWidth="550.0">
                    
                    <VBox styleClass="header-card" alignment="CENTER">
                        <Text text="Two-Factor Setup" style="-fx-font-size: 20px; -fx-font-weight: bold; "/>
                    </VBox>

                    <VBox fx:id="setupSection" styleClass="details-card" alignment="CENTER" spacing="15.0">
                        <Text text="1. Scan this QR code with your authenticator app (Google Authenticator, Authy, etc.)" 
                              wrappingWidth="400.0" style="-fx-text-alignment: center;"/>
                        
                        <StackPane style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #dee2e6; -fx-border-radius: 8;">
                            <ImageView fx:id="qrImageView" fitWidth="200.0" fitHeight="200.0" preserveRatio="true"/>
                        </StackPane>

                        <VBox alignment="CENTER" spacing="5.0">
                            <Text text="Or enter this secret manually:" style=" -fx-font-size: 12px;"/>
                            <Label fx:id="secretLabel" style="-fx-font-family: 'monospace'; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                        </VBox>

                        <Separator/>

                        <Text text="2. Enter the 6-digit code to verify activation:" 
                              wrappingWidth="400.0" style="-fx-text-alignment: center;"/>
                        
                        <HBox spacing="10.0" alignment="CENTER">
                            <TextField fx:id="verifyField" promptText="000000" styleClass="form-control" prefWidth="150.0" alignment="CENTER"/>
                            <Button fx:id="activateButton" text="Activate 2FA" styleClass="btn-primary" onAction="#handleActivate"/>
                        </HBox>

                        <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false" wrapText="true"/>

                        <VBox fx:id="backupCodesBox" visible="false" managed="false" spacing="15.0" alignment="CENTER"
                              style=" -fx-padding: 20; -fx-border-radius: 12;">
                            <Text text="⚠️ SAVE THESE BACKUP CODES SAFELY!" style="-fx-font-weight: bold; -fx-fill: #dc3545;"/>
                            <FlowPane fx:id="backupCodesFlowPane" hgap="25.0" vgap="12.0" alignment="CENTER" prefWrapLength="450.0">
                                <!-- Codes will be added here dynamically -->
                            </FlowPane>
                            <Button text="I have saved them" styleClass="action-button" onAction="#handleDone"/>
                        </VBox>

                        <Hyperlink text="Cancel" onAction="#handleCancel" styleClass="wellcare-link"/>
                    </VBox>

                    <VBox fx:id="manageSection" styleClass="details-card" alignment="CENTER" spacing="25.0" visible="false" managed="false">
                        <VBox alignment="CENTER" spacing="10.0">
                            <Label text="✅ Two-Factor Authentication is ENABLED" style="-fx-text-fill: #28a745; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                            <Text text="Your account is protected with an additional layer of security." style=""/>
                        </VBox>

                        <Separator/>

                        <VBox spacing="15.0" alignment="CENTER_LEFT" style=" -fx-padding: 24; -fx-background-radius: 12;">
                            <Label text="Active Backup Codes" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #002F5C;"/>
                            <Text text="Use these codes if you can't access your authenticator app." style=" -fx-font-size: 13px;"/>
                            
                            <FlowPane fx:id="activeBackupCodesFlowPane" hgap="25.0" vgap="12.0" alignment="CENTER_LEFT" prefWrapLength="450.0">
                                <!-- Existing codes show here -->
                            </FlowPane>
                        </VBox>

                        <HBox spacing="20.0" alignment="CENTER">
                            <Button text="Disable 2FA" styleClass="logout-button" onAction="#handleDisable" minWidth="150.0"/>
                            <Button text="Back to Profile" styleClass="btn-outline" onAction="#handleCancel" minWidth="150.0"/>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
