<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane stylesheets="@../css/wellcare.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellcare.javafx.controller.auth.VerifyEmailController">
    <!-- Main Background -->
    <HBox styleClass="auth-background" alignment="CENTER">
        <VBox alignment="CENTER" maxWidth="500" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
            
            <VBox styleClass="auth-card" spacing="20" alignment="CENTER" maxWidth="450">
                <padding>
                    <Insets top="40" right="40" bottom="40" left="40"/>
                </padding>

                <!-- Icon/Logo Area -->
                <VBox alignment="CENTER" spacing="10">
                    <StackPane>
                        <Circle radius="40" fill="#E8F4F8"/>
                        <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                            <Image url="@../images/icons/email-auth.png"/>
                        </ImageView>
                    </StackPane>
                    
                    <Label text="Verify your email" styleClass="auth-title"/>
                    <Label text="We've sent a 6-digit verification code to:" styleClass="auth-subtitle" wrapText="true" textAlignment="CENTER" />
                    <Label fx:id="emailDisplayLabel" text="your.email@example.com" style="-fx-font-weight: bold; -fx-text-fill: #1D3557; -fx-font-size: 16px;"/>
                </VBox>

                <!-- Messages -->
                <Label fx:id="errorLabel" styleClass="error-message" visible="false" managed="false" wrapText="true"/>
                <Label fx:id="successLabel" styleClass="success-message" visible="false" managed="false" wrapText="true"/>

                <!-- Input area -->
                <VBox spacing="10" alignment="CENTER">
                    <Label text="Enter verification code" styleClass="field-label"/>
                    <TextField fx:id="codeField" promptText="------" styleClass="input-field" alignment="CENTER" style="-fx-font-size: 24px; -fx-letter-spacing: 10px;" maxWidth="200" />
                </VBox>

                <!-- Loading Indicator inner VBox -->
                <HBox fx:id="loadingBox" alignment="CENTER" visible="false" managed="false" spacing="10">
                    <ProgressIndicator prefWidth="20" prefHeight="20"/>
                    <Label text="Verifying..." textFill="#666666"/>
                </HBox>

                <VBox spacing="15" alignment="CENTER" prefWidth="1000">
                    <Button fx:id="verifyButton" text="Verify Account" styleClass="auth-button" maxWidth="Infinity"/>
                    
                    <HBox alignment="CENTER" spacing="5">
                        <Label text="Didn't receive the code?" textFill="#666666"/>
                        <Hyperlink fx:id="resendLink" text="Resend" styleClass="secondary-link" />
                    </HBox>
                </VBox>
                
                <Separator/>
                
                <Hyperlink fx:id="backToLoginLink" text="Back to Login" styleClass="secondary-link"/>

            </VBox>
            
        </VBox>
    </HBox>
</StackPane>
