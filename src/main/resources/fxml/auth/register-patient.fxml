<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellcare.javafx.controller.auth.RegisterPatientController"
      styleClass="root" alignment="CENTER" spacing="20.0" prefWidth="1000.0" prefHeight="800.0">

    <!-- Main Container -->
    <VBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">

        <!-- Header Section -->
        <VBox alignment="CENTER" spacing="10.0">
            <Text text="🏥 WellCare" styleClass="welcome-title"/>
            <Text text="Create Patient Account" styleClass="welcome-subtitle"/>
            <Text text="Join our healthcare community" style="-fx-font-size: 16px; -fx-text-fill: #6c757d;"/>
        </VBox>

        <!-- Registration Card -->
        <ScrollPane fitToWidth="true" prefHeight="600.0" styleClass="card">
            <VBox styleClass="card-body" alignment="TOP_CENTER" spacing="25.0" prefWidth="500.0">

                <!-- Progress Indicator -->
                <HBox alignment="CENTER" spacing="10.0">
                    <javafx.scene.shape.Circle radius="12" styleClass="progress-step-active"/>
                    <Text text="Personal Information" style="-fx-font-weight: bold; -fx-text-fill: #667eea;"/>
                    <Text text="→" style="-fx-text-fill: #adb5bd;"/>
                    <javafx.scene.shape.Circle radius="12" styleClass="progress-step-inactive"/>
                    <Text text="Medical Details" style="-fx-text-fill: #adb5bd;"/>
                </HBox>

                <!-- Personal Information Form -->
                <VBox spacing="20.0">

                    <!-- Name Fields Row -->
                    <HBox spacing="15.0" alignment="CENTER">
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <Label text="First Name" styleClass="form-label"/>
                            <TextField fx:id="firstNameField" promptText="Enter first name" styleClass="form-control"/>
                            <Label fx:id="firstNameErrorLabel" styleClass="error-label" visible="false" managed="false"/>
                        </VBox>
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <Label text="Last Name" styleClass="form-label"/>
                            <TextField fx:id="lastNameField" promptText="Enter last name" styleClass="form-control"/>
                            <Label fx:id="lastNameErrorLabel" styleClass="error-label" visible="false" managed="false"/>
                        </VBox>
                    </HBox>

                    <!-- Email Field -->
                    <VBox spacing="8.0">
                        <Label text="Email Address" styleClass="form-label"/>
                        <TextField fx:id="emailField" promptText="Enter your email" styleClass="form-control"/>
                        <Label fx:id="emailErrorLabel" styleClass="error-label" visible="false" managed="false"/>
                    </VBox>

                    <!-- Phone Field -->
                    <VBox spacing="8.0">
                        <Label text="Phone Number (Optional)" styleClass="form-label"/>
                        <TextField fx:id="phoneField" promptText="Enter phone number" styleClass="form-control"/>
                        <Label fx:id="phoneErrorLabel" styleClass="error-label" visible="false" managed="false"/>
                    </VBox>

                    <!-- Date of Birth -->
                    <VBox spacing="8.0">
                        <Label text="Date of Birth" styleClass="form-label"/>
                        <DatePicker fx:id="birthDatePicker" styleClass="form-control" promptText="Select date of birth"/>
                        <Label fx:id="birthDateErrorLabel" styleClass="error-label" visible="false" managed="false"/>
                    </VBox>

                    <!-- Password Fields -->
                    <VBox spacing="8.0">
                        <Label text="Password" styleClass="form-label"/>
                        <PasswordField fx:id="passwordField" promptText="Create a strong password" styleClass="form-control"/>
                        <Label fx:id="passwordErrorLabel" styleClass="error-label" visible="false" managed="false"/>
                        <Text text="Password must contain at least 8 characters with uppercase, lowercase, number and special character"
                              style="-fx-font-size: 11px; -fx-text-fill: #6c757d; -fx-wrap-text: true;"/>
                    </VBox>

                    <!-- Confirm Password -->
                    <VBox spacing="8.0">
                        <Label text="Confirm Password" styleClass="form-label"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" styleClass="form-control"/>
                        <Label fx:id="confirmPasswordErrorLabel" styleClass="error-label" visible="false" managed="false"/>
                    </VBox>

                    <!-- Terms and Conditions -->
                    <VBox spacing="10.0">
                        <CheckBox fx:id="termsCheckBox" text="I agree to the Terms of Service and Privacy Policy" style="-fx-font-size: 13px;"/>
                        <CheckBox fx:id="marketingCheckBox" text="I would like to receive marketing communications (optional)" style="-fx-font-size: 13px;"/>
                        <Label fx:id="termsErrorLabel" styleClass="error-label" visible="false" managed="false"/>
                    </VBox>

                    <!-- Captcha Section -->
                    <VBox spacing="8.0" style="-fx-padding: 10 0 0 0;">
                        <Label text="Security Verification" styleClass="form-label"/>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <StackPane style="-fx-background-color: #f8f9fa; -fx-padding: 2; -fx-border-color: #dee2e6; -fx-border-radius: 4;">
                                <ImageView fx:id="captchaImageView" fitWidth="200.0" fitHeight="50.0" preserveRatio="true"/>
                            </StackPane>
                            <Button fx:id="refreshCaptchaButton" text="🔄" styleClass="btn-secondary" prefHeight="44.0"/>
                        </HBox>
                        <TextField fx:id="captchaField" promptText="Enter the code" styleClass="form-control" prefWidth="350.0"/>
                        <Label fx:id="captchaErrorLabel" styleClass="error-label" visible="false" managed="false"/>
                    </VBox>

                </VBox>

                <!-- Action Buttons -->
                <VBox spacing="15.0" alignment="CENTER">

                    <!-- Register Button -->
                    <VBox spacing="10.0">
                        <Button fx:id="registerButton" text="Create Account" styleClass="btn-primary" prefWidth="300.0" prefHeight="45.0"/>
                        <HBox fx:id="loadingBox" alignment="CENTER" spacing="10.0" visible="false" managed="false">
                            <ProgressIndicator prefWidth="20.0" prefHeight="20.0"/>
                            <Label text="Creating account..." style="-fx-font-size: 13px;"/>
                        </HBox>
                    </VBox>

                    <!-- Success Message -->
                    <Label fx:id="successLabel" styleClass="success-label" visible="false" managed="false" wrapText="true" maxWidth="400.0"/>

                    <!-- General Error Message -->
                    <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false" wrapText="true" maxWidth="400.0"/>

                </VBox>

                <!-- Navigation Links -->
                <VBox alignment="CENTER" spacing="15.0">
                    <Text text="Already have an account?" style="-fx-font-size: 14px; -fx-text-fill: #6c757d;"/>
                    <Hyperlink fx:id="loginLink" text="Sign In Instead" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Text text="or" style="-fx-font-size: 12px; -fx-text-fill: #adb5bd;"/>
                    <Hyperlink fx:id="registerProfessionalLink" text="Create Professional Account" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                </VBox>

            </VBox>
        </ScrollPane>

        <!-- Footer -->
        <HBox styleClass="footer" alignment="CENTER">
            <Text text="© 2024 WellCare Healthcare Management System" style="-fx-font-size: 12px; -fx-text-fill: #6c757d;"/>
        </HBox>

    </VBox>
</VBox>