<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellcare.javafx.controller.auth.ProfessionalTypeChoiceController"
      spacing="30.0" alignment="CENTER" styleClass="root-container"
      prefWidth="800.0" prefHeight="600.0">

    <!-- Header Section -->
    <VBox spacing="15.0" alignment="CENTER" VBox.vgrow="NEVER">
        <Label text="Join WellCare Connect as a Professional" styleClass="title-label">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Label text="Choose your professional category to begin the registration process" styleClass="subtitle-label">
            <font>
                <Font name="System Regular" size="14.0" />
            </font>
        </Label>
    </VBox>

    <!-- Professional Type Cards -->
    <HBox spacing="30.0" alignment="CENTER" VBox.vgrow="ALWAYS">

        <!-- Médecin Card -->
        <VBox fx:id="medecinCard" styleClass="professional-card, medecin-card" spacing="15.0" alignment="CENTER"
              prefWidth="220.0" prefHeight="280.0" onMouseClicked="#onMedecinSelected">
            <Label text="👨‍⚕️" styleClass="emoji-icon">
                <font>
                    <Font size="48.0" />
                </font>
            </Label>
            <Label text="Médecin" styleClass="card-title">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <Label text="Médecins, chirurgiens et spécialistes médicaux" styleClass="card-description" wrapText="true" textAlignment="CENTER">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
            <Label text="Vérification requise" styleClass="verification-badge">
                <font>
                    <Font name="System Bold" size="10.0" />
                </font>
            </Label>
        </VBox>

        <!-- Coach Card -->
        <VBox fx:id="coachCard" styleClass="professional-card, coach-card" spacing="15.0" alignment="CENTER"
              prefWidth="220.0" prefHeight="280.0" onMouseClicked="#onCoachSelected">
            <Label text="🏃‍♂️" styleClass="emoji-icon">
                <font>
                    <Font size="48.0" />
                </font>
            </Label>
            <Label text="Coach Sportif" styleClass="card-title">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <Label text="Entraîneurs sportifs et coachs de fitness" styleClass="card-description" wrapText="true" textAlignment="CENTER">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
            <Label text="Vérification requise" styleClass="verification-badge">
                <font>
                    <Font name="System Bold" size="10.0" />
                </font>
            </Label>
        </VBox>

        <!-- Nutritionniste Card -->
        <VBox fx:id="nutritionistCard" styleClass="professional-card, nutritionist-card" spacing="15.0" alignment="CENTER"
              prefWidth="220.0" prefHeight="280.0" onMouseClicked="#onNutritionistSelected">
            <Label text="🥗" styleClass="emoji-icon">
                <font>
                    <Font size="48.0" />
                </font>
            </Label>
            <Label text="Nutritionniste" styleClass="card-title">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <Label text="Spécialistes en nutrition et diététique" styleClass="card-description" wrapText="true" textAlignment="CENTER">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
            <Label text="Vérification requise" styleClass="verification-badge">
                <font>
                    <Font name="System Bold" size="10.0" />
                </font>
            </Label>
        </VBox>

    </HBox>

    <!-- Footer Message -->
    <VBox spacing="10.0" alignment="CENTER" VBox.vgrow="NEVER">
        <Label text="Tous les comptes professionnels nécessitent une vérification par l'administrateur" styleClass="footer-message" wrapText="true" textAlignment="CENTER">
            <font>
                <Font size="12.0" />
            </font>
        </Label>
        <Label text="sous 24-48 heures avant activation." styleClass="footer-message" wrapText="true" textAlignment="CENTER">
            <font>
                <Font size="12.0" />
            </font>
        </Label>
    </VBox>

    <!-- Back Button -->
    <HBox alignment="CENTER_LEFT" VBox.vgrow="NEVER">
        <Button text="← Retour" styleClass="back-button" onAction="#onBackToLogin" />
    </HBox>

    <padding>
        <Insets top="40.0" right="50.0" bottom="40.0" left="50.0" />
    </padding>
</VBox>