<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.XYChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.FontWeight?>

<ScrollPane xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wellora.javafx.controller.DashboardController"
      fitToWidth="true"
      styleClass="root">
    
<VBox spacing="20" styleClass="root" prefWidth="1200">

    <!-- Header -->
    <padding>
        <Insets top="30" right="30" bottom="20" left="30"/>
    </padding>
    
    <Label text="📊 Tableau de Bord - Analytiques" styleClass="header-label"/>
    <Label text="Vue d'ensemble de vos données de santé" styleClass="section-label"/>
    
    <!-- Journal Selector -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="📒 Journal: " styleClass="journal-selector-label"/>
        <ComboBox fx:id="journalComboBox" onAction="#onJournalSelected" prefWidth="250" styleClass="dashboard-combo"/>
        <Button text="🔄" styleClass="button, button-secondary" onAction="#refreshDashboard"/>
    </HBox>

    <!-- Summary Cards -->
    <HBox spacing="20" alignment="CENTER">
        <!-- Health Score Card -->
        <VBox spacing="10" styleClass="stat-card" alignment="CENTER" prefWidth="200">
            <Label text="💯" styleClass="stat-icon"/>
            <Label text="Score Santé" styleClass="stat-label"/>
            <Label fx:id="healthScoreLabel" text="0" styleClass="stat-value"/>
        </VBox>

        <!-- Total Entries Card -->
        <VBox spacing="10" styleClass="stat-card" alignment="CENTER" prefWidth="200">
            <Label text="🩺" styleClass="stat-icon"/>
            <Label text="Entrées" styleClass="stat-label"/>
            <Label fx:id="entryCountLabel" text="0" styleClass="stat-value"/>
        </VBox>

        <!-- Total Symptoms Card -->
        <VBox spacing="10" styleClass="stat-card" alignment="CENTER" prefWidth="200">
            <Label text="🤒" styleClass="stat-icon"/>
            <Label text="Symptômes" styleClass="stat-label"/>
            <Label fx:id="symptomCountLabel" text="0" styleClass="stat-value"/>
        </VBox>

        <!-- Average Weight Card -->
        <VBox spacing="10" styleClass="stat-card" alignment="CENTER" prefWidth="200">
            <Label text="⚖️" styleClass="stat-icon"/>
            <Label text="Poids Moyen" styleClass="stat-label"/>
            <Label fx:id="avgWeightLabel" text="-- kg" styleClass="stat-value"/>
        </VBox>

        <!-- Average Sleep Card -->
        <VBox spacing="10" styleClass="stat-card" alignment="CENTER" prefWidth="200">
            <Label text="😴" styleClass="stat-icon"/>
            <Label text="Sommeil Moyen" styleClass="stat-label"/>
            <Label fx:id="avgSleepLabel" text="-- h" styleClass="stat-value"/>
        </VBox>
    </HBox>

    <!-- Charts Section -->
    <GridPane hgap="20" vgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints percentHeight="50"/>
            <RowConstraints percentHeight="50"/>
        </rowConstraints>

        <!-- Sleep Trend Line Chart -->
        <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="5" styleClass="chart-container">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="😴" styleClass="chart-icon"/>
                <Label text="Évolution du Sommeil" styleClass="chart-title"/>
            </HBox>
            <Label text="Heures de sommeil par jour" styleClass="chart-subtitle"/>
            <LineChart fx:id="sleepLineChart" styleClass="chart">
                <xAxis>
                    <CategoryAxis label="Date" styleClass="axis-label"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Heures" styleClass="axis-label"/>
                </yAxis>
            </LineChart>
        </VBox>

        <!-- Weight Trend Line Chart -->
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="5" styleClass="chart-container">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="⚖️" styleClass="chart-icon"/>
                <Label text="Évolution du Poids" styleClass="chart-title"/>
            </HBox>
            <Label text="Poids en kilogrammes" styleClass="chart-subtitle"/>
            <LineChart fx:id="weightLineChart" styleClass="chart">
                <xAxis>
                    <CategoryAxis label="Date" styleClass="axis-label"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Kg" styleClass="axis-label"/>
                </yAxis>
            </LineChart>
        </VBox>

        <!-- Glycemia Trend Line Chart -->
        <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" spacing="5" styleClass="chart-container">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="🩸" styleClass="chart-icon"/>
                <Label text="Évolution de la Glycémie" styleClass="chart-title"/>
            </HBox>
            <Label text="Niveau de glycémie en g/L" styleClass="chart-subtitle"/>
            <LineChart fx:id="glycemiaLineChart" styleClass="chart">
                <xAxis>
                    <CategoryAxis label="Date" styleClass="axis-label"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="g/L" styleClass="axis-label"/>
                </yAxis>
            </LineChart>
        </VBox>

        <!-- Symptoms Distribution Pie Chart -->
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="5" styleClass="chart-container">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="🤒" styleClass="chart-icon"/>
                <Label text="Distribution des Symptômes" styleClass="chart-title"/>
            </HBox>
            <Label text="Répartition par type de symptôme" styleClass="chart-subtitle"/>
            <PieChart fx:id="symptomPieChart" styleClass="pie-chart"/>
        </VBox>
    </GridPane>

    <VBox fx:id="alertContainer"
          visible="false"
          spacing="10"
          styleClass="alert-card">

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="⚠️" styleClass="alert-icon"/>
            <Label fx:id="alertTitle" text="Alerte" styleClass="alert-title"/>
        </HBox>

        <Label fx:id="alertMessage"
               wrapText="true"
               styleClass="alert-message"/>
    </VBox>
    <!-- Recommendations Section -->
    <VBox fx:id="recommendationsContainer"
          visible="false"
          spacing="12"
          styleClass="recommendations-container">

        <!-- Header -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="💡" styleClass="section-icon"/>
            <Label text="Recommandations"
                   styleClass="section-title"/>
        </HBox>

        <!-- Subtitle -->
        <Label text="Conseils personnalisés basés sur vos données de santé"
               styleClass="section-subtitle"
               wrapText="true"/>

        <!-- Content list -->
        <VBox fx:id="recommendationsList"
              spacing="10"
              styleClass="recommendations-list"/>
    </VBox>

    <!-- Refresh Button -->
    <HBox spacing="15" alignment="CENTER">
        <Button text="🔄 Actualiser les Données" 
                styleClass="button, button-success"
                onAction="#refreshDashboard"/>
        <Button text="← Retour au Menu Principal" 
                styleClass="button, button-secondary"
                onAction="#goBackToMain"/>
    </HBox>

</VBox>
    
</ScrollPane>
