<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellcare.javafx.controller.dashboard.NutritionistDashboardController">
    <children>
        <!-- Header -->
        <HBox styleClass="navbar" VBox.vgrow="NEVER">
            <children>
                <Label styleClass="navbar-brand" text="🏥 WellCare Pro" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="15.0" alignment="CENTER_RIGHT">
                    <children>
                        <Button styleClass="btn-notification" text="🔔" />
                        <MenuButton fx:id="userMenu" styleClass="user-menu">
                            <items>
                                <MenuItem fx:id="profileMenuItem" text="👤 Profile" />
                                <MenuItem fx:id="settingsMenuItem" text="⚙️ Settings" />
                                <SeparatorMenuItem />
                                <MenuItem fx:id="logoutMenuItem" text="🚪 Logout" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Main Content -->
        <HBox VBox.vgrow="ALWAYS">
            <!-- Sidebar -->
            <VBox styleClass="sidebar" HBox.hgrow="NEVER">
                <children>
                    <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                        <VBox.margin>
                            <Insets top="20.0" right="0.0" bottom="20.0" left="0.0" />
                        </VBox.margin>
                        <children>
                            <Label styleClass="sidebar-title" text="Nutrition Portal" />
                            <Button fx:id="dashboardBtn" styleClass="sidebar-item, sidebar-item.active" text="📊 Dashboard" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="clientsBtn" styleClass="sidebar-item" text="👥 My Clients" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="mealPlansBtn" styleClass="sidebar-item" text="🥗 Meal Plans" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="consultationsBtn" styleClass="sidebar-item" text="📅 Consultations" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="progressBtn" styleClass="sidebar-item" text="📈 Progress" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="messagesBtn" styleClass="sidebar-item" text="💬 Messages" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="recipesBtn" styleClass="sidebar-item" text="📖 Recipes" maxWidth="1.7976931348623157E308" />
                        </children>
                    </VBox>
                </children>
            </VBox>

            <!-- Main Dashboard Content -->
            <VBox HBox.hgrow="ALWAYS" spacing="20.0">
                <VBox.margin>
                    <Insets top="30.0" right="30.0" bottom="30.0" left="30.0" />
                </VBox.margin>
                <children>
                    <!-- Page Title -->
                    <HBox alignment="CENTER_LEFT">
                        <children>
                            <Label styleClass="page-title" text="Nutritionist Dashboard" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="currentDateLabel" styleClass="current-date" />
                        </children>
                    </HBox>

                    <!-- Welcome Card -->
                    <HBox styleClass="card" alignment="CENTER_LEFT" spacing="20.0">
                        <children>
                            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label fx:id="welcomeLabel" styleClass="welcome-message" text="Good morning, Nutritionist [Last Name]!" />
                                    <Label styleClass="welcome-subtitle" text="Here's your client nutrition overview and meal planning schedule" />
                                    <HBox spacing="15.0">
                                        <children>
                                            <Button styleClass="btn, btn-primary" text="📅 Today's Consultations" />
                                            <Button styleClass="btn, btn-secondary" text="👥 Client List" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                            <VBox alignment="CENTER">
                                <children>
                                    <Label styleClass="medical-icon" text="🥗" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- Statistics Row -->
                    <HBox spacing="20.0">
                        <children>
                            <!-- Today's Consultations Card -->
                            <VBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <Label styleClass="stat-icon" text="📅" />
                                            <VBox spacing="5.0">
                                                <children>
                                                    <Label styleClass="stat-number" fx:id="todayConsultationsCount" text="5" />
                                                    <Label styleClass="stat-label" text="Today's Consultations" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <Button styleClass="btn, btn-outline" text="View Schedule" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>

                            <!-- Active Clients Card -->
                            <VBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <Label styleClass="stat-icon" text="👥" />
                                            <VBox spacing="5.0">
                                                <children>
                                                    <Label styleClass="stat-number" fx:id="activeClientsCount" text="31" />
                                                    <Label styleClass="stat-label" text="Active Clients" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <Button styleClass="btn, btn-outline" text="Client List" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>

                            <!-- Meal Plans Created Card -->
                            <VBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <Label styleClass="stat-icon" text="🥗" />
                                            <VBox spacing="5.0">
                                                <children>
                                                    <Label styleClass="stat-number" fx:id="mealPlansCreatedCount" text="12" />
                                                    <Label styleClass="stat-label" text="Meal Plans Created" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <Button styleClass="btn, btn-outline" text="View Plans" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- Today's Consultations and Recent Activity -->
                    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                        <children>
                            <!-- Today's Consultations -->
                            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <VBox.margin>
                                    <Insets top="0.0" />
                                </VBox.margin>
                                <children>
                                    <Label styleClass="card-title" text="📅 Today's Nutrition Consultations" />
                                    <ListView fx:id="todayConsultationsList" VBox.vgrow="ALWAYS" />
                                    <Button styleClass="btn, btn-primary" text="Start Next Consultation" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>

                            <!-- Recent Activity -->
                            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <VBox.margin>
                                    <Insets top="0.0" />
                                </VBox.margin>
                                <children>
                                    <Label styleClass="card-title" text="📈 Client Progress &amp; Achievements" />
                                    <ListView fx:id="recentAchievementsList" VBox.vgrow="ALWAYS" />
                                    <Button styleClass="btn, btn-outline" text="View All Progress" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </HBox>
    </children>
</VBox>
