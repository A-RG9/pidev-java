<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellcare.javafx.controller.dashboard.CoachDashboardController">
    <children>
        <!-- Header -->
        <HBox styleClass="navbar" VBox.vgrow="NEVER">
            <children>
                <Label styleClass="navbar-brand" text="🏥 WellCare Pro" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="15.0" alignment="CENTER_RIGHT">
                    <children>
                        <Button styleClass="btn-notification" text="🔔" />
                        <MenuButton fx:id="userMenu" styleClass="user-menu">
                            <items>
                                <MenuItem fx:id="profileMenuItem" text="👤 Profile" />
                                <MenuItem fx:id="settingsMenuItem" text="⚙️ Settings" />
                                <SeparatorMenuItem />
                                <MenuItem fx:id="logoutMenuItem" text="🚪 Logout" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Main Content -->
        <HBox VBox.vgrow="ALWAYS">
            <!-- Sidebar -->
            <!-- Sidebar -->
            <VBox styleClass="sidebar" HBox.hgrow="NEVER">
                <children>
                    <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                        <VBox.margin>
                            <Insets top="20.0" right="0.0" bottom="20.0" left="0.0" />
                        </VBox.margin>
                        <children>
                            <Label styleClass="sidebar-title" text="Coach Portal" />
                            <Button fx:id="dashboardBtn" styleClass="sidebar-item, sidebar-item.active" text="📊 Dashboard" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="clientsBtn" styleClass="sidebar-item" text="👥 My Clients" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="sessionsBtn" styleClass="sidebar-item" text="🏃 Sessions" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="programsBtn" styleClass="sidebar-item" text="📋 Programs" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="progressBtn" styleClass="sidebar-item" text="📈 Progress" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="messagesBtn" styleClass="sidebar-item" text="💬 Messages" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="scheduleBtn" styleClass="sidebar-item" text="🕒 Schedule" maxWidth="1.7976931348623157E308" />

                            <!-- NOUVEAUX BOUTONS FITNESS PLANS -->
                            <Label text="FITNESS PLANS" style="-fx-font-size: 10px; -fx-text-fill: #64748B; -fx-padding: 20 0 2 5; -fx-font-weight: bold;"/>

                            <Button text="📋 All Plans" onAction="#loadDailyPlanEditor" style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-alignment: center-left; -fx-padding: 8 12; -fx-background-radius: 8; -fx-cursor: hand;" maxWidth="Infinity"/>

                            <Button text="📚 Exercise Library" onAction="#loadExerciseLibrary" style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-alignment: center-left; -fx-padding: 8 12; -fx-background-radius: 8; -fx-cursor: hand;" maxWidth="Infinity"/>

                            <Button text="👥 Mes Clients" onAction="#loadClientsList" style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-alignment: center-left; -fx-padding: 8 12; -fx-background-radius: 8; -fx-cursor: hand;" maxWidth="Infinity"/>
                        </children>
                    </VBox>
                </children>
            </VBox>

            <!-- Main Dashboard Content -->
            <VBox HBox.hgrow="ALWAYS" spacing="20.0">
                <VBox.margin>
                    <Insets top="30.0" right="30.0" bottom="30.0" left="30.0" />
                </VBox.margin>
                <children>
                    <!-- Page Title -->
                    <HBox alignment="CENTER_LEFT">
                        <children>
                            <Label styleClass="page-title" text="Coach Dashboard" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="currentDateLabel" styleClass="current-date" />
                        </children>
                    </HBox>

                    <!-- Welcome Card -->
                    <HBox styleClass="card" alignment="CENTER_LEFT" spacing="20.0">
                        <children>
                            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label fx:id="welcomeLabel" styleClass="welcome-message" text="Good morning, Coach [Last Name]!" />
                                    <Label styleClass="welcome-subtitle" text="Here's your training schedule and client overview" />
                                    <HBox spacing="15.0">
                                        <children>
                                            <Button styleClass="btn, btn-primary" text="📅 Today's Sessions" />
                                            <Button styleClass="btn, btn-secondary" text="👥 Client List" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                            <VBox alignment="CENTER">
                                <children>
                                    <Label styleClass="medical-icon" text="🏃‍♂️" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- Statistics Row -->
                    <HBox spacing="20.0">
                        <children>
                            <!-- Today's Sessions Card -->
                            <VBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <Label styleClass="stat-icon" text="🏃" />
                                            <VBox spacing="5.0">
                                                <children>
                                                    <Label styleClass="stat-number" fx:id="todaySessionsCount" text="6" />
                                                    <Label styleClass="stat-label" text="Today's Sessions" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <Button styleClass="btn, btn-outline" text="View Schedule" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>

                            <!-- Active Clients Card -->
                            <VBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <Label styleClass="stat-icon" text="👥" />
                                            <VBox spacing="5.0">
                                                <children>
                                                    <Label styleClass="stat-number" fx:id="activeClientsCount" text="23" />
                                                    <Label styleClass="stat-label" text="Active Clients" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <Button styleClass="btn, btn-outline" text="Client List" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>

                            <!-- Pending Reviews Card -->
                            <VBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <Label styleClass="stat-icon" text="📝" />
                                            <VBox spacing="5.0">
                                                <children>
                                                    <Label styleClass="stat-number" fx:id="pendingReviewsCount" text="4" />
                                                    <Label styleClass="stat-label" text="Pending Reviews" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <Button styleClass="btn, btn-outline" text="Review Progress" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- Today's Sessions and Recent Activity -->
                    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                        <children>
                            <!-- Today's Sessions -->
                            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <VBox.margin>
                                    <Insets top="0.0" />
                                </VBox.margin>
                                <children>
                                    <Label styleClass="card-title" text="🏃 Today's Training Sessions" />
                                    <ListView fx:id="todaySessionsList" VBox.vgrow="ALWAYS" />
                                    <Button styleClass="btn, btn-primary" text="Start Next Session" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>

                            <!-- Recent Activity -->
                            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <VBox.margin>
                                    <Insets top="0.0" />
                                </VBox.margin>
                                <children>
                                    <Label styleClass="card-title" text="📈 Recent Client Progress" />
                                    <ListView fx:id="recentProgressList" VBox.vgrow="ALWAYS" />
                                    <Button styleClass="btn, btn-outline" text="View All Progress" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </HBox>
    </children>
</VBox>