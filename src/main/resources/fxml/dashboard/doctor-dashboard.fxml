<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellcare.javafx.controller.dashboard.DoctorDashboardController">
    <children>
        <!-- Header -->
        <HBox styleClass="navbar" VBox.vgrow="NEVER">
            <children>
                <Label styleClass="navbar-brand" text="🏥 WellCare Pro" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="15.0" alignment="CENTER_RIGHT">
                    <children>
                        <Button styleClass="btn-notification" text="🔔" />
                        <MenuButton fx:id="userMenu" styleClass="user-menu">
                            <items>
                                <MenuItem fx:id="profileMenuItem" text="👤 Profile" />
                                <MenuItem fx:id="settingsMenuItem" text="⚙️ Settings" />
                                <SeparatorMenuItem />
                                <MenuItem fx:id="logoutMenuItem" text="🚪 Logout" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Main Content -->
        <HBox VBox.vgrow="ALWAYS">
            <!-- Sidebar -->
            <VBox styleClass="sidebar" HBox.hgrow="NEVER">
                <children>
                    <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                        <VBox.margin>
                            <Insets top="20.0" right="0.0" bottom="20.0" left="0.0" />
                        </VBox.margin>
                        <children>
                            <Label styleClass="sidebar-title" text="Doctor Portal" />
                            <Button fx:id="dashboardBtn" styleClass="sidebar-item, sidebar-item.active" text="📊 Dashboard" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="agendaBtn" styleClass="sidebar-item" text="📅 Agenda" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="clinicalnotesBtn" styleClass="sidebar-item" text="📋 clinical-notes" maxWidth="1.7976931348623157E308" />
                        </children>
                    </VBox>
                </children>
            </VBox>

            <!-- Main Dashboard Content -->
            <VBox HBox.hgrow="ALWAYS" spacing="20.0">
                <VBox.margin>
                    <Insets top="30.0" right="30.0" bottom="30.0" left="30.0" />
                </VBox.margin>
                <children>
                    <!-- Page Title -->
                    <HBox alignment="CENTER_LEFT">
                        <children>
                            <Label styleClass="page-title" text="Doctor Dashboard" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="currentDateLabel" styleClass="current-date" />
                        </children>
                    </HBox>

                    <!-- Welcome Card -->
                    <HBox styleClass="card" alignment="CENTER_LEFT" spacing="20.0">
                        <children>
                            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label fx:id="welcomeLabel" styleClass="welcome-message" text="Good morning, Dr. [Last Name]!" />
                                    <Label styleClass="welcome-subtitle" text="Here's your practice overview for today" />
                                    <HBox spacing="15.0">
                                        <children>
                                            <Button styleClass="btn, btn-primary" text="📅 View Today's Schedule" />
                                            <Button styleClass="btn, btn-secondary" text="👥 Patient List" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                            <VBox alignment="CENTER">
                                <children>
                                    <Label styleClass="medical-icon" text="⚕️" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- Statistics Row -->
                    <HBox spacing="20.0">
                        <children>
                            <!-- Today's Appointments Card -->
                            <VBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <Label styleClass="stat-icon" text="📅" />
                                            <VBox spacing="5.0">
                                                <children>
                                                    <Label styleClass="stat-number" fx:id="todayAppointmentsCount" text="8" />
                                                    <Label styleClass="stat-label" text="Today's Appointments" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <Button styleClass="btn, btn-outline" text="View Schedule" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>

                            <!-- Active Patients Card -->
                            <VBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <Label styleClass="stat-icon" text="👥" />
                                            <VBox spacing="5.0">
                                                <children>
                                                    <Label styleClass="stat-number" fx:id="activePatientsCount" text="47" />
                                                    <Label styleClass="stat-label" text="Active Patients" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <Button styleClass="btn, btn-outline" text="Patient List" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>

                            <!-- Pending Tasks Card -->
                            <VBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <Label styleClass="stat-icon" text="📋" />
                                            <VBox spacing="5.0">
                                                <children>
                                                    <Label styleClass="stat-number" fx:id="pendingTasksCount" text="3" />
                                                    <Label styleClass="stat-label" text="Pending Tasks" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <Button styleClass="btn, btn-outline" text="View Tasks" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- Today's Schedule and Recent Activity -->
                    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                        <children>
                            <!-- Today's Appointments -->
                            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <VBox.margin>
                                    <Insets top="0.0" />
                                </VBox.margin>
                                <children>
                                    <Label styleClass="card-title" text="📅 Today's Schedule" />
                                    <ListView fx:id="todayScheduleList" VBox.vgrow="ALWAYS" />
                                    <Button styleClass="btn, btn-primary" text="Manage Schedule" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>

                            <!-- Recent Activity -->
                            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="15.0">
                                <VBox.margin>
                                    <Insets top="0.0" />
                                </VBox.margin>
                                <children>
                                    <Label styleClass="card-title" text="📋 Recent Activity" />
                                    <ListView fx:id="recentActivityList" VBox.vgrow="ALWAYS" />
                                    <Button styleClass="btn, btn-outline" text="View All Activity" maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </HBox>
    </children>
</VBox>