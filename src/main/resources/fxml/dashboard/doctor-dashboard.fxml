<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wellcare.javafx.controller.dashboard.DoctorDashboardController">
    <children>
        <!-- Header -->
        <HBox styleClass="navbar" VBox.vgrow="NEVER">
            <children>
                <Label styleClass="navbar-brand" text="🏥 WellCare Pro" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="15.0" alignment="CENTER_RIGHT">
                    <children>
                        <Button styleClass="btn-notification" text="🔔" />
                        <MenuButton fx:id="userMenu" styleClass="user-menu">
                            <items>
                                <MenuItem fx:id="profileMenuItem" text="👤 Profile" />
                                <MenuItem fx:id="settingsMenuItem" text="⚙️ Settings" />
                                <SeparatorMenuItem />
                                <MenuItem fx:id="logoutMenuItem" text="🚪 Logout" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Main Content -->
        <HBox VBox.vgrow="ALWAYS">
            <!-- Sidebar -->
            <VBox styleClass="sidebar" HBox.hgrow="NEVER">
                <children>
                    <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                        <VBox.margin>
                            <Insets top="20.0" right="0.0" bottom="20.0" left="0.0" />
                        </VBox.margin>
                        <children>
                            <Label styleClass="sidebar-title" text="Doctor Portal" />
                            <Button fx:id="dashboardBtn" styleClass="sidebar-item, sidebar-item.active" text="📊 Dashboard" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="agendaBtn" styleClass="sidebar-item" text="📅 Agenda" maxWidth="1.7976931348623157E308" />
                            <Button fx:id="clinicalnotesBtn" styleClass="sidebar-item" text="📋 clinical-notes" maxWidth="1.7976931348623157E308" />
                        </children>
                    </VBox>
                </children>
            </VBox>

            <!-- Main Dashboard Content -->
            <VBox fx:id="mainContentContainer" HBox.hgrow="ALWAYS" spacing="20.0">
                <VBox.margin>
                    <Insets top="30.0" right="30.0" bottom="30.0" left="30.0" />
                </VBox.margin>
            </VBox>
        </HBox>
    </children>
</VBox>