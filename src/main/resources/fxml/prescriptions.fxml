<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.Node?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wellcare.javafx.controller.PrescriptionsController"
      style="-fx-background-color: #f9fafb;">

    <!-- LEFT SIDEBAR - Included from sidebar.fxml -->
    <fx:include source="sidebar.fxml" />

    <!-- RIGHT SIDE - Prescriptions Content -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #f9fafb; -fx-border-width: 0;">
        <VBox spacing="24" style="-fx-padding: 32 48 48 48;">

            <!-- Page Header -->
            <HBox spacing="16" alignment="CENTER_LEFT">
                <StackPane minWidth="48" minHeight="48" 
                           style="-fx-background-color: #dbeafe; -fx-background-radius: 12;">
                    <Label text="&#xf5a3;" styleClass="fas"
                           style="-fx-font-size: 20px; -fx-text-fill: #3b82f6;"/>
                </StackPane>
                <VBox spacing="4">
                    <Text text="Ordonnances" 
                          style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #111827;"/>
                    <Text text="Vos mÃ©dicaments et traitements en cours" 
                          style="-fx-font-size: 14px; -fx-fill: #6b7280;"/>
                </VBox>
            </HBox>
            
            <!-- Prescriptions Cards Container -->
            <VBox fx:id="prescriptionsCardsContainer" spacing="16"/>
            
        </VBox>
    </ScrollPane>
</HBox>

