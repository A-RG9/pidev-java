<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.GoalController" prefHeight="800.0" prefWidth="1100.0" style="-fx-background-color: #F8FAFC;">

    <VBox spacing="20" style="-fx-padding: 30; -fx-background-color: transparent;">

        <!-- Header avec titre et bouton Nouvel Objectif -->
        <HBox alignment="CENTER_LEFT">
            <Label text="🎯 Dashboard des Objectifs" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="+ Nouvel Objectif" onAction="#openAddForm" style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-size: 14px;"/>
        </HBox>

        <!-- Statistiques rapides -->
        <HBox spacing="20" style="-fx-padding: 10 0;">
            <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                <Label text="Total Objectifs" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                <Label fx:id="lblTotalGoals" text="0" style="-fx-text-fill: #1E293B; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            </VBox>
            <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                <Label text="Terminés" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                <Label fx:id="lblCompletedGoals" text="0" style="-fx-text-fill: #10B981; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            </VBox>
            <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                <Label text="En cours" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                <Label fx:id="lblInProgressGoals" text="0" style="-fx-text-fill: #3B82F6; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            </VBox>
            <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                <Label text="Progression globale" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                <Label fx:id="lblProgressValue" text="0%" style="-fx-text-fill: #8B5CF6; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <ProgressBar fx:id="globalProgressBar" progress="0" prefWidth="100" style="-fx-accent: #8B5CF6;"/>
            </VBox>
        </HBox>

        <!-- Barre de filtres -->
        <VBox spacing="10">
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                <TextField fx:id="searchField" promptText="🔍 Rechercher par titre ou description..." HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 25; -fx-border-radius: 25; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-padding: 10 15; -fx-font-size: 13px;"/>
                <ComboBox fx:id="filterCategory" promptText="Catégorie" prefWidth="150" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-padding: 8 10;"/>
                <ComboBox fx:id="filterStatus" promptText="Statut" prefWidth="150" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-padding: 8 10;"/>
                <ComboBox fx:id="filterDifficulty" promptText="Difficulté" prefWidth="150" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-padding: 8 10;"/>
                <ComboBox fx:id="filterProgress" promptText="Progression" prefWidth="150" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-padding: 8 10;"/>
                <Button fx:id="btnResetFilters" text="Reset Filtres" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 16; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 12px;"/>
            </HBox>

            <!-- Résultat de recherche -->
            <Label fx:id="lblResultCount" style="-fx-text-fill: #64748B; -fx-padding: 5 10; -fx-font-size: 12px;"/>
        </VBox>

        <!-- Conteneur des cartes -->
        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;"
                    VBox.vgrow="ALWAYS">
            <VBox>
                <FlowPane fx:id="cardsContainer"
                          hgap="25"
                          vgap="25"
                          style="-fx-background-color: transparent; -fx-padding: 10;" />
                <Region prefHeight="200"/>
            </VBox>
        </ScrollPane>
    </VBox>

    <!-- Formulaire overlay -->
    <VBox fx:id="formOverlay" visible="false" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.75);">
        <VBox spacing="15" maxWidth="550" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 5);">

            <Label text="✏️ Détails de l'objectif" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
            <Label fx:id="lblError" textFill="#EF4444" visible="false" managed="false" style="-fx-font-size: 12px;"/>

            <TextField fx:id="txtTitle" promptText="Titre de l'objectif *" style="-fx-background-color: #F8FAFC; -fx-padding: 12; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-font-size: 13px;"/>
            <TextArea fx:id="txtDescription" promptText="Description..." prefHeight="100" style="-fx-background-color: #F8FAFC; -fx-padding: 10; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-font-size: 13px;"/>

            <HBox spacing="15">
                <ComboBox fx:id="comboCategory" promptText="Catégorie" prefWidth="245" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-padding: 8;"/>
                <ComboBox fx:id="comboStatus" promptText="Statut" prefWidth="245" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-padding: 8;"/>
            </HBox>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <ComboBox fx:id="comboDifficulty" promptText="Difficulté" prefWidth="245" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-padding: 8;"/>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Progression (%)" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                    <HBox spacing="10" alignment="CENTER">
                        <Slider fx:id="sliderProgress" max="100" showTickLabels="true" showTickMarks="true" prefWidth="200"/>
                        <Label fx:id="lblSliderProgressValue" text="0%" style="-fx-text-fill: #8B5CF6; -fx-font-weight: bold; -fx-min-width: 40px;"/>
                    </HBox>
                </VBox>
            </HBox>

            <HBox spacing="15">
                <DatePicker fx:id="dateStart" promptText="Date de début" prefWidth="245" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-padding: 8;"/>
                <DatePicker fx:id="dateEnd" promptText="Date de fin" prefWidth="245" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-padding: 8;"/>
            </HBox>

            <HBox spacing="15">
                <ComboBox fx:id="comboPatient" promptText="Patient assigné" prefWidth="245" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-padding: 8;"/>
                <ComboBox fx:id="comboCoach" promptText="Coach assigné" prefWidth="245" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-padding: 8;"/>
            </HBox>

            <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
                <Button text="Annuler" onAction="#closeForm" style="-fx-background-color: transparent; -fx-border-color: #EF4444; -fx-text-fill: #EF4444; -fx-border-radius: 25; -fx-padding: 10 25; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <Button text="Enregistrer" onAction="#handleSave" style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 10 25; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px;"/>
            </HBox>

        </VBox>

    </VBox>

</StackPane>