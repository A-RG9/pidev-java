<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.GoalController" prefHeight="800.0" prefWidth="900.0" style="-fx-background-color: transparent;">

    <VBox spacing="20" style="-fx-padding: 30; -fx-background-color: transparent;">
        <HBox alignment="CENTER_LEFT">
            <Label text="Dashboard des Objectifs" styleClass="text-primary" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="+ Nouvel Objectif" onAction="#openAddForm" style="-fx-background-color: #14b8a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
            <FlowPane fx:id="cardsContainer" hgap="20" vgap="20" style="-fx-background-color: transparent; -fx-padding: 10;" />
        </ScrollPane>
    </VBox>

    <VBox fx:id="formOverlay" visible="false" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.6);">
        <VBox spacing="15" styleClass="card-bg" maxWidth="500" style="-fx-padding: 30;">
            <Label text="Détails de l'objectif" styleClass="text-primary" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label fx:id="lblError" textFill="#ef4444" visible="false" managed="false"/>

            <TextField fx:id="txtTitle" promptText="Titre de l'objectif" style="-fx-padding: 10;"/>
            <TextArea fx:id="txtDescription" promptText="Description..." prefHeight="80" style="-fx-padding: 5;"/>

            <HBox spacing="10">
                <ComboBox fx:id="comboCategory" promptText="Catégorie" prefWidth="220" />
                <ComboBox fx:id="comboStatus" promptText="Statut" prefWidth="220" />
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <ComboBox fx:id="comboDifficulty" promptText="Difficulté" prefWidth="220" />
                <VBox>
                    <Label text="Progression (%)" styleClass="text-secondary"/>
                    <Slider fx:id="sliderProgress" max="100" showTickLabels="true" showTickMarks="true" prefWidth="220"/>
                </VBox>
            </HBox>

            <HBox spacing="10">
                <DatePicker fx:id="dateStart" promptText="Date de début" prefWidth="220"/>
                <DatePicker fx:id="dateEnd" promptText="Date de fin" prefWidth="220"/>
            </HBox>

            <HBox spacing="10">
                <ComboBox fx:id="comboPatient" promptText="Patient assigné" prefWidth="220" />
                <ComboBox fx:id="comboCoach" promptText="Coach assigné" prefWidth="220" />
            </HBox>

            <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
                <Button text="Annuler" onAction="#closeForm" style="-fx-background-color: transparent; -fx-border-color: #ef4444; -fx-text-fill: #ef4444; -fx-border-radius: 5; -fx-padding: 8 20; -fx-cursor: hand;"/>
                <Button text="Enregistrer" onAction="#handleSave" style="-fx-background-color: #14b8a6; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </VBox>

</StackPane>