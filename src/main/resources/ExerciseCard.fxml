<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.web.WebView?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.ExerciseCardController" spacing="10" prefWidth="320" styleClass="card-bg">

    <WebView fx:id="videoPlayer" prefHeight="180" prefWidth="280" />

    <HBox alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
        <Label fx:id="lblCategory" text="Catégorie" style="-fx-background-color: #14b8a6; -fx-text-fill: white; -fx-padding: 3 10; -fx-background-radius: 10; -fx-font-size: 11px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblDifficulty" text="Intermediate" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
        <Label fx:id="lblDuration" text="15 min" styleClass="text-secondary" style="-fx-font-weight: bold;"/>
    </HBox>

    <Text fx:id="txtTitle" text="Titre de l'exercice" styleClass="text-primary" style="-fx-font-size: 18px; -fx-font-weight: bold;" wrappingWidth="280"/>
    <Text fx:id="txtDescription" text="Description de l'exercice..." styleClass="text-secondary" wrappingWidth="280"/>

    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 15 0 0 0;">
        <Button text="Modifier" onAction="#handleEdit" style="-fx-background-color: transparent; -fx-border-color: #3b82f6; -fx-text-fill: #3b82f6; -fx-border-radius: 5; -fx-cursor: hand;"/>
        <Button text="Supprimer" onAction="#handleDelete" style="-fx-background-color: transparent; -fx-border-color: #ef4444; -fx-text-fill: #ef4444; -fx-border-radius: 5; -fx-cursor: hand;"/>
    </HBox>
</VBox>